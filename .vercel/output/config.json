{
	"version": 3,
	"routes": [
		{
			"src": "^/\\.well-known(?:/.*)?$"
		},
		{
			"src": "^/((?:[^/]+/)*[^/\\.]+)$",
			"headers": {
				"Location": "/$1/"
			},
			"status": 308
		},
		{
			"src": "^/((?:[^/]+/)*[^/]+\\.\\w+)/$",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/_image/$",
			"dest": "_render"
		},
		{
			"src": "^/404/$",
			"dest": "_render"
		},
		{
			"src": "^/about-us/$",
			"dest": "_render"
		},
		{
			"src": "^/contact-us/$",
			"dest": "_render"
		},
		{
			"src": "^/llms\\.txt/?$",
			"dest": "_render"
		},
		{
			"src": "^/privacy/$",
			"dest": "_render"
		},
		{
			"src": "^/robots\\.txt/?$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap/$",
			"dest": "_render"
		},
		{
			"src": "^/terms/$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}