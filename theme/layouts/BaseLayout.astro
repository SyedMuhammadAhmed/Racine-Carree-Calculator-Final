---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getHtmlDir } from '../i18n/utils';
import site from '../../src/config/site.json';
import social from '../../src/config/social.json';
import nav from '../../src/config/nav.json';
import '../../src/styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: string;
  canonicalUrl: string;
  robots?: string;
  ogType?: string;
  ogImage?: string;
  isAboutPage?: boolean;
  isContactPage?: boolean;
  schemaSlot?: boolean;
}

const {
  title,
  description,
  locale = 'en',
  canonicalUrl,
  robots = 'index, follow',
  ogType = 'website',
  ogImage = site.ogImage,
  isAboutPage = false,
  isContactPage = false,
  schemaSlot = false,
} = Astro.props;

// Calculate HTML direction (LTR/RTL) based on locale
const htmlDir = getHtmlDir(locale as any);

// Absolute URL for Open Graph/Twitter Images
const absoluteOgImage = new URL(ogImage, site.siteUrl).toString();

// Approximate locale to standard format (e.g., "en_EN", "es_ES") if passing a simple 2-letter tag
const mappedLocale = locale.length === 2 ? `${locale.toLowerCase()}_${locale.toUpperCase()}` : locale;

// Build JSON-LD schemas
const socialLinks = Object.values(social).filter(Boolean);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.siteName,
  url: site.siteUrl,
  legalName: site.siteName,
  logo: {
    "@type": "ImageObject",
    url: new URL('/logo.png', site.siteUrl).toString(),
  },
  description: site.siteDescription,
  sameAs: socialLinks
};

const navSchemas = nav.header.map((item: any) => ({
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  name: item.label,
  url: new URL(item.href, site.siteUrl).toString()
}));

const aboutSchema = isAboutPage ? {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: title,
  description,
  url: canonicalUrl
} : null;

const contactSchema = isContactPage ? {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: title,
  description,
  url: canonicalUrl
} : null;

const schemas = [orgSchema, ...navSchemas, aboutSchema, contactSchema].filter(Boolean);
---

<html lang={locale} dir={htmlDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    
    <link rel="icon" href="/favicon.ico" />
    
    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    {site.bingVerification && <meta name="msvalidate.01" content={site.bingVerification} />}
    {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:locale" content={mappedLocale} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content={site.ogImageWidth.toString()} />
    <meta property="og:image:height" content={site.ogImageHeight.toString()} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta property="og:type" content={ogType} />

    <!-- Twitter -->
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />

    {schemaSlot && <slot name="schema" />}
  </head>
  <body>
    <Header />
    <main class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
