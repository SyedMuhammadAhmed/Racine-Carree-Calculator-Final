---
import Navbar from '../../src/components/Navbar.astro';
import Footer from '../../src/components/Footer.astro';
import TranslationRuntime from '../../src/components/TranslationRuntime.astro';
import { DEFAULT_LOCALE, LOCALES, getHtmlDir, type Locale } from '../i18n/utils';
import site from '../../src/config/site.json';
import social from '../../src/config/social.json';
import nav from '../../src/config/nav.json';
import '../../src/styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: string;
  canonicalUrl: string;
  robots?: string;
  ogType?: string;
  ogImage?: string;
  isAboutPage?: boolean;
  isContactPage?: boolean;
  schemaSlot?: boolean;
}

const {
  title,
  description,
  locale = 'en',
  canonicalUrl,
  robots = 'index, follow',
  ogType = 'website',
  ogImage = site.ogImage,
  isAboutPage = false,
  isContactPage = false,
  schemaSlot = false,
} = Astro.props;

const requestedLocale = Astro.url.searchParams.get('lang') || locale;
const activeLocale = LOCALES.includes(requestedLocale as Locale)
  ? requestedLocale as Locale
  : DEFAULT_LOCALE;

// Calculate HTML direction (LTR/RTL) based on locale
const htmlDir = getHtmlDir(activeLocale);

// Absolute URL for Open Graph/Twitter Images
const absoluteOgImage = new URL(ogImage, site.siteUrl).toString();

// Approximate locale to standard format (e.g., "en_EN", "es_ES") if passing a simple 2-letter tag
const mappedLocale = activeLocale.length === 2 ? `${activeLocale.toLowerCase()}_${activeLocale.toUpperCase()}` : activeLocale;

// Build JSON-LD schemas
const socialLinks = Object.values(social).filter(Boolean);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.siteName,
  url: site.siteUrl,
  legalName: site.siteName,
  logo: {
    "@type": "ImageObject",
    url: new URL('/logo.png', site.siteUrl).toString(),
  },
  description: site.siteDescription,
  sameAs: socialLinks
};

const navSchemas = nav.header.map((item: any) => ({
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  name: item.label,
  url: new URL(item.href, site.siteUrl).toString()
}));

const aboutSchema = isAboutPage ? {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: title,
  description,
  url: canonicalUrl
} : null;

const contactSchema = isContactPage ? {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: title,
  description,
  url: canonicalUrl
} : null;

const schemas = [orgSchema, ...navSchemas, aboutSchema, contactSchema].filter(Boolean);
---

<html lang={activeLocale} dir={htmlDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    
    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    {site.bingVerification && <meta name="msvalidate.01" content={site.bingVerification} />}
    {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:locale" content={mappedLocale} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content={site.ogImageWidth.toString()} />
    <meta property="og:image:height" content={site.ogImageHeight.toString()} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta property="og:type" content={ogType} />

    <!-- Twitter -->
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Font Loading Optimization -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    </noscript>
    <script is:inline>
        (function () {
            var t = localStorage.getItem('theme');
            var d = t || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', d);
        })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />

    {schemaSlot && <slot name="schema" />}
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to main content</a>
    <div class="bg-orbs" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="orb orb-4"></div>
      <div class="orb orb-5"></div>
    </div>
    <Navbar lang={activeLocale} />
    <main class="page-shell" id="main-content">
      <slot />
    </main>
    <Footer lang={activeLocale} />
    <TranslationRuntime pageLocale={activeLocale} />
    <button id="backToTop" class="back-to-top" aria-label="Back to top" title="Back to top" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <script src="/app.js" defer is:inline></script>
  </body>
</html>
