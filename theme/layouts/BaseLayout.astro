---
import site from "src/config/site.json";
import nav from "src/config/nav.json";
import "src/styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = site.siteName,
  description = site.siteDescription,
  ogImage = site.ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, site.siteUrl).href} />
    <meta property="og:image:width" content={String(site.ogImageWidth)} />
    <meta property="og:image:height" content={String(site.ogImageHeight)} />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    {site.googleVerification && (
      <meta name="google-site-verification" content={site.googleVerification} />
    )}
    {site.bingVerification && (
      <meta name="msvalidate.01" content={site.bingVerification} />
    )}
    {site.yandexVerification && (
      <meta name="yandex-verification" content={site.yandexVerification} />
    )}
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <slot name="header">
      <header class="border-b border-gray-200">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
          <a href="/" class="text-lg font-semibold">{site.siteName}</a>
          <ul class="flex gap-6">
            {nav.header.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-gray-600 hover:text-gray-900">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>
    </slot>
    <main>
      <slot />
    </main>
    <slot name="footer">
      <footer class="border-t border-gray-200">
        <div class="mx-auto max-w-7xl px-4 py-8">
          <ul class="flex justify-center gap-6">
            {nav.footer.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-gray-500 hover:text-gray-700">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-center text-xs text-gray-400">
            &copy; {new Date().getFullYear()} {site.siteName}. All rights reserved.
          </p>
        </div>
      </footer>
    </slot>
  </body>
</html>
