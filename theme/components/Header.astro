---
import { getLocalizedUrl, type Locale } from '../i18n/utils';
import type { TranslationSet } from '../i18n/translations';
import { t } from '../i18n/translations';
import LanguageSwitcher from './LanguageSwitcher.astro';
import site from '../../src/config/site.json';
import nav from '../../src/config/nav.json';

interface Props {
  locale: Locale;
  translations: TranslationSet;
}

const { locale, translations } = Astro.props;

const currentPath = Astro.url.pathname;
const homeUrl = getLocalizedUrl('/', locale);
---
<header class="relative z-50 bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center">
        <a href={homeUrl} class="flex items-center gap-2">
          <span class="font-bold text-xl text-gray-900">{t(translations, 'site.title') || site.siteName}</span>
        </a>
      </div>
      
      <nav class="hidden md:flex space-x-8" aria-label="Desktop Navigation">
        {nav.header.map((item) => {
          const itemUrl = getLocalizedUrl(item.href, locale);
          const isActive = currentPath === itemUrl || (itemUrl !== homeUrl && currentPath.startsWith(itemUrl));
          const navKey = 'nav.' + (item.href === '/' ? 'home' : item.href.replace(/^\//, ''));
          const translatedLabel = t(translations, navKey);
          return (
            <a 
              href={itemUrl} 
              class={`text-sm font-medium ${isActive ? 'text-blue-600' : 'text-gray-500 hover:text-gray-900'}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {translatedLabel !== navKey ? translatedLabel : item.label}
            </a>
          );
        })}
      </nav>

      <div class="hidden md:flex items-center">
        <LanguageSwitcher locale={locale} />
      </div>

      <div class="flex items-center md:hidden gap-4">
        <LanguageSwitcher locale={locale} />
        <button
          id="mobile-menu-btn"
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open main menu"
        >
          <span class="sr-only">Open main menu</span>
          <svg id="icon-menu" class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="fixed inset-0 z-50 hidden bg-white md:hidden" aria-hidden="true">
    <div class="flex items-center justify-between px-4 pt-4">
      <a href={homeUrl} class="flex items-center gap-2">
        <span class="font-bold text-xl text-gray-900">{t(translations, 'site.title') || site.siteName}</span>
      </a>
      <button
        id="mobile-close-btn"
        type="button"
        class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none"
        aria-label="Close menu"
      >
        <span class="sr-only">Close menu</span>
        <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="mt-6 px-2 space-y-1">
      {nav.header.map((item) => {
        const itemUrl = getLocalizedUrl(item.href, locale);
        const navKey = 'nav.' + (item.href === '/' ? 'home' : item.href.replace(/^\//, ''));
        const translatedLabel = t(translations, navKey);
        return (
          <a
            href={itemUrl}
            class="mobile-nav-link block px-3 py-2 rounded-md text-base font-medium text-gray-900 hover:bg-gray-50"
          >
            {translatedLabel !== navKey ? translatedLabel : item.label}
          </a>
        );
      })}
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    menu.classList.remove('hidden');
    menu.setAttribute('aria-hidden', 'false');
    btn.setAttribute('aria-expanded', 'true');
    iconMenu.classList.add('hidden');
    iconClose.classList.remove('hidden');
    iconClose.classList.add('block');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu.classList.add('hidden');
    menu.setAttribute('aria-hidden', 'true');
    btn.setAttribute('aria-expanded', 'false');
    iconMenu.classList.remove('hidden');
    iconMenu.classList.add('block');
    iconClose.classList.add('hidden');
    iconClose.classList.remove('block');
    document.body.style.overflow = '';
  }

  if (btn && closeBtn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    closeBtn.addEventListener('click', closeMenu);

    mobileLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }
</script>
