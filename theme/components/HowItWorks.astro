---
interface Step {
  title: string;
  description: string;
}

interface Props {
  sectionTitle: string;
  steps: Step[];
}

const { sectionTitle, steps } = Astro.props;
---

<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">
        {sectionTitle}
      </h2>
    </div>
    
    <div class="mt-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        {steps.map((step, index) => (
          <div class="flex flex-col items-center text-center">
            <div class="flex items-center justify-center h-16 w-16 rounded-full bg-blue-100 text-blue-600 font-bold text-xl mb-6">
              {index + 1}
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-base text-gray-500">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
    
    <div class="mt-12 text-center">
      <slot />
    </div>
  </div>
</section>
