---
import { getLocalizedUrl, type Locale } from '../i18n/utils';
import type { TranslationSet } from '../i18n/translations';
import { t } from '../i18n/translations';
import LanguageSwitcher from './LanguageSwitcher.astro';
import site from '../../src/config/site.json';
import nav from '../../src/config/nav.json';
import social from '../../src/config/social.json';

interface Props {
  locale: Locale;
  translations: TranslationSet;
}

const { locale, translations } = Astro.props;

const homeUrl = getLocalizedUrl('/', locale);
const footerDesc = translations?.footer?.description || site.siteDescription;

const hasSocials = Object.values(social).some(val => val && val.trim() !== '');
---
<footer class="bg-gray-50 border-t border-gray-200" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:py-16 lg:px-8">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8 xl:col-span-1">
        <a href={homeUrl} class="flex items-center gap-2">
          <span class="font-bold text-xl text-gray-900">{t(translations, 'site.title') || site.siteName}</span>
        </a>
        <p class="text-gray-500 text-base">
          {footerDesc}
        </p>
        {hasSocials && (
          <div class="flex space-x-6">
            {social.facebook && (
              <a href={social.facebook} class="text-gray-400 hover:text-gray-500" aria-label="Visit us on Facebook">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                </svg>
              </a>
            )}
            {social.twitter && (
              <a href={social.twitter} class="text-gray-400 hover:text-gray-500" aria-label="Visit us on Twitter">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.008 4.07H5.078z" />
                </svg>
              </a>
            )}
            {social.linkedin && (
              <a href={social.linkedin} class="text-gray-400 hover:text-gray-500" aria-label="Visit us on LinkedIn">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
                </svg>
              </a>
            )}
            {social.pinterest && (
              <a href={social.pinterest} class="text-gray-400 hover:text-gray-500" aria-label="Visit us on Pinterest">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.951-7.252 4.188 0 7.443 2.986 7.443 6.945 0 4.168-2.628 7.518-6.282 7.518-1.226 0-2.38-.638-2.775-1.393l-.754 2.872c-.274 1.042-1.016 2.348-1.515 3.143 1.135.347 2.339.534 3.585.534 6.621 0 11.988-5.367 11.988-11.987C24.005 5.367 18.638 0 12.017 0z" clip-rule="evenodd" />
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
      <div class="mt-12 grid grid-cols-2 gap-8 xl:mt-0 xl:col-span-2">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-semibold text-gray-400 tracking-wider uppercase">Navigation</h3>
            <nav aria-label="Footer Navigation" class="mt-4 space-y-4">
              {nav.footer.map((item) => {
                const itemUrl = getLocalizedUrl(item.href, locale);
                const navKey = 'nav.' + (item.href === '/' ? 'home' : item.href.replace(/^\//, ''));
                const translatedLabel = t(translations, navKey);
                return (
                  <a href={itemUrl} class="block text-base text-gray-500 hover:text-gray-900">
                    {translatedLabel !== navKey ? translatedLabel : item.label}
                  </a>
                );
              })}
            </nav>
          </div>
          <div class="mt-12 md:mt-0">
            <h3 class="text-sm font-semibold text-gray-400 tracking-wider uppercase">Language</h3>
            <div class="mt-4">
              <LanguageSwitcher locale={locale} />
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-12 border-t border-gray-200 pt-8">
      <p class="text-base text-gray-400 xl:text-center">
        &copy; {new Date().getFullYear()} {site.siteName}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
