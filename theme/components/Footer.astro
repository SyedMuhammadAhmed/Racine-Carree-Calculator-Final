---
import site from "src/config/site.json";
import social from "src/config/social.json";

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<footer class={className}>
  <div class="mx-auto max-w-7xl px-4 py-8">
    <ul class="flex justify-center gap-6">
      {social.facebook && (
        <li><a href={social.facebook} class="text-sm text-gray-500 hover:text-gray-700">Facebook</a></li>
      )}
      {social.twitter && (
        <li><a href={social.twitter} class="text-sm text-gray-500 hover:text-gray-700">Twitter</a></li>
      )}
      {social.linkedin && (
        <li><a href={social.linkedin} class="text-sm text-gray-500 hover:text-gray-700">LinkedIn</a></li>
      )}
    </ul>
    <p class="mt-4 text-center text-xs text-gray-400">
      &copy; {new Date().getFullYear()} {site.siteName}. All rights reserved.
    </p>
  </div>
</footer>
