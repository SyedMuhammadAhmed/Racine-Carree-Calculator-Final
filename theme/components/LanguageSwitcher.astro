---
import { LOCALES, getLocalizedUrl, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<div class="relative group inline-block text-left">
  <button type="button" class="inline-flex justify-center w-full rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none" aria-label="Language Selector">
    {locale.toUpperCase()}
    <svg class="-mr-1 ml-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>

  <div class="origin-top-right absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all z-50">
    <div class="py-1" role="menu" aria-orientation="vertical">
      {LOCALES.map((loc) => {
        const isCurrent = loc === locale;
        const url = getLocalizedUrl("/", loc);
        return (
          <a
            href={url}
            class={`block px-4 py-2 text-sm ${isCurrent ? 'bg-gray-100 text-gray-900 font-bold' : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'}`}
            role="menuitem"
          >
            {loc.toUpperCase()}
          </a>
        );
      })}
    </div>
  </div>
</div>
