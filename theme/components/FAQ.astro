---
interface FaqItem {
  question: string;
  answer: string;
  display?: boolean;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
const visibleItems = items.filter((item) => item.display !== false);
---

<div class="space-y-4">
  {visibleItems.map((item, index) => (
    <details 
      class="group border border-gray-200 rounded-lg bg-white overflow-hidden [&_summary::-webkit-details-marker]:hidden"
    >
      <summary 
        class="flex items-center justify-between cursor-pointer px-6 py-4 text-left font-medium text-gray-900 bg-gray-50 group-hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-inset"
        role="button"
        aria-expanded="false"
      >
        <span>{item.question}</span>
        <span class="ml-6 flex-shrink-0">
          <svg 
            class="h-5 w-5 text-gray-500 transform transition-transform duration-200 group-open:-rotate-180" 
            xmlns="http://www.w3.org/2000/svg" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>
      <div class="px-6 py-4 text-gray-600 prose prose-blue max-w-none">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>

<script is:inline>
  const detailsElements = document.querySelectorAll('details');
  
  detailsElements.forEach((details) => {
    const summary = details.querySelector('summary');
    if (summary) {
      details.addEventListener('toggle', () => {
        summary.setAttribute('aria-expanded', details.hasAttribute('open') ? 'true' : 'false');
      });
      // Ensure initial state
      summary.setAttribute('aria-expanded', details.hasAttribute('open') ? 'true' : 'false');
    }
  });
</script>
