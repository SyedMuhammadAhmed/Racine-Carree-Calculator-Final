---
import type { Locale } from '../i18n/utils';
import type { TranslationSet } from '../i18n/translations';
import { t } from '../i18n/translations';
import site from '../../src/config/site.json';

interface Props {
  locale: Locale;
  translations: TranslationSet | ((key: string, fallback?: string) => any);
}

const { locale, translations } = Astro.props;
const contactEmail = site.contactEmail || 'contact@racinecarreecalculator.com';
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
const label = (key: string, fallback: string) => {
  if (typeof translations === 'function') {
    return translations(key, fallback);
  }

  const translated = t(translations, key);
  return translated !== key ? translated : fallback;
};
---

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-6 py-8 sm:p-10">
    <form id="contact-form" class="space-y-6">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">{label('common.name', 'Name')}</label>
        <div class="mt-1">
          <input 
            type="text" 
            name="name" 
            id="name" 
            required 
            class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3 border" 
          />
        </div>
      </div>
      
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">{label('common.email', 'Email')}</label>
        <div class="mt-1">
          <input 
            type="email" 
            name="email" 
            id="email" 
            required 
            class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3 border" 
          />
        </div>
      </div>
      
      <div>
        <label for="message" class="block text-sm font-medium text-gray-700">{label('common.message', 'Message')}</label>
        <div class="mt-1">
          <textarea 
            id="message" 
            name="message" 
            rows="5" 
            required 
            class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3 border"
          ></textarea>
        </div>
      </div>
      
      <div>
        <button 
          type="submit" 
          id="submit-btn"
          class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
        >
          {label('common.sendMessage', 'Send Message')}
        </button>
      </div>
      
      <div id="form-status" class="mt-4 text-center hidden p-3 rounded-md">
        <p class="text-sm font-medium" id="status-message"></p>
      </div>
    </form>
    
    <div class="mt-8 pt-6 border-t border-gray-200 text-center">
      <p class="text-sm text-gray-500">
        {label('contact.fallbackText', 'Or email us directly at:')} 
        <a href={`mailto:${contactEmail}`} class="font-medium text-blue-600 hover:text-blue-500">
          {contactEmail}
        </a>
      </p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ 
  msgSending: 'Sending...',
  msgSuccess: 'Your message has been sent successfully. We will get back to you soon.',
  msgError: 'There was an error sending your message. Please try again.',
  msgNetworkError: 'Network error. Please check your connection and try again.',
  msgMissingKey: `The contact form is not configured yet. Please email ${contactEmail} directly.`,
  web3FormsKey
}}>
  const form = document.getElementById('contact-form');
  const statusDiv = document.getElementById('form-status');
  const statusMsg = document.getElementById('status-message');
  const submitBtn = document.getElementById('submit-btn');
  const originalBtnText = submitBtn.innerText;
  
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Reset status
      statusDiv.className = 'mt-4 text-center p-3 rounded-md block bg-blue-50 text-blue-800';
      statusMsg.innerText = msgSending;
      submitBtn.disabled = true;
      submitBtn.innerText = msgSending;
      
      // Get form data
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      if (!web3FormsKey) {
        statusDiv.className = 'mt-4 text-center p-3 rounded-md block bg-amber-50 text-amber-800';
        statusMsg.innerText = msgMissingKey;
        submitBtn.disabled = false;
        submitBtn.innerText = originalBtnText;
        return;
      }
      
      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            access_key: web3FormsKey,
            ...data
          })
        });
        
        const result = await response.json();
        
        if (response.ok) {
          statusDiv.className = 'mt-4 text-center p-3 rounded-md block bg-green-50 text-green-800';
          statusMsg.innerText = msgSuccess;
          form.reset();
        } else {
          statusDiv.className = 'mt-4 text-center p-3 rounded-md block bg-red-50 text-red-800';
          statusMsg.innerText = result.message || msgError;
        }
      } catch (error) {
        statusDiv.className = 'mt-4 text-center p-3 rounded-md block bg-red-50 text-red-800';
        statusMsg.innerText = msgNetworkError;
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = originalBtnText;
      }
    });
  }
</script>
