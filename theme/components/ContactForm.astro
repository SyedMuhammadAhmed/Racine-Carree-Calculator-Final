---
import { getLocalizedUrl, type Locale } from '../i18n/utils';
import type { TranslationSet } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  locale: Locale;
  translations: TranslationSet;
}

const { locale, translations } = Astro.props;
---

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-6 py-8 sm:p-10">
    <form id="contact-form" class="space-y-6">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">{t(translations, 'contact.name') || 'Name'}</label>
        <div class="mt-1">
          <input 
            type="text" 
            name="name" 
            id="name" 
            required 
            class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3 border" 
          />
        </div>
      </div>
      
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">{t(translations, 'contact.email') || 'Email'}</label>
        <div class="mt-1">
          <input 
            type="email" 
            name="email" 
            id="email" 
            required 
            class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3 border" 
          />
        </div>
      </div>
      
      <div>
        <label for="message" class="block text-sm font-medium text-gray-700">{t(translations, 'contact.message') || 'Message'}</label>
        <div class="mt-1">
          <textarea 
            id="message" 
            name="message" 
            rows="5" 
            required 
            class="shadow-sm focus:ring-blue-500 focus:border-blue-500 block w-full sm:text-sm border-gray-300 rounded-md py-2 px-3 border"
          ></textarea>
        </div>
      </div>
      
      <div>
        <button 
          type="submit" 
          id="submit-btn"
          class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
        >
          {t(translations, 'contact.submit') || 'Send Message'}
        </button>
      </div>
      
      <div id="form-status" class="mt-4 text-center hidden p-3 rounded-md">
        <p class="text-sm font-medium" id="status-message"></p>
      </div>
    </form>
    
    <div class="mt-8 pt-6 border-t border-gray-200 text-center">
      <p class="text-sm text-gray-500">
        {t(translations, 'contact.fallbackText') || 'Or email us directly at:'} 
        <a href="mailto:contact@example.com" class="font-medium text-blue-600 hover:text-blue-500">
          contact@example.com
        </a>
      </p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ 
  msgSending: 'Sending...',
  msgSuccess: 'Your message has been sent successfully. We will get back to you soon.',
  msgError: 'There was an error sending your message. Please try again.',
  msgNetworkError: 'Network error. Please check your connection and try again.'
}}>
  const form = document.getElementById('contact-form');
  const statusDiv = document.getElementById('form-status');
  const statusMsg = document.getElementById('status-message');
  const submitBtn = document.getElementById('submit-btn');
  const originalBtnText = submitBtn.innerText;
  
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Reset status
      statusDiv.className = 'mt-4 text-center p-3 rounded-md block bg-blue-50 text-blue-800';
      statusMsg.innerText = msgSending;
      submitBtn.disabled = true;
      submitBtn.innerText = msgSending;
      
      // Get form data
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      
      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            access_key: "YOUR_WEB3FORMS_KEY_HERE", // NOTE: Replace with import.meta.env.PUBLIC_WEB3FORMS_KEY in real usage when env is set
            ...data
          })
        });
        
        const result = await response.json();
        
        if (response.ok) {
          statusDiv.className = 'mt-4 text-center p-3 rounded-md block bg-green-50 text-green-800';
          statusMsg.innerText = msgSuccess;
          form.reset();
        } else {
          statusDiv.className = 'mt-4 text-center p-3 rounded-md block bg-red-50 text-red-800';
          statusMsg.innerText = result.message || msgError;
        }
      } catch (error) {
        statusDiv.className = 'mt-4 text-center p-3 rounded-md block bg-red-50 text-red-800';
        statusMsg.innerText = msgNetworkError;
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = originalBtnText;
      }
    });
  }
</script>
