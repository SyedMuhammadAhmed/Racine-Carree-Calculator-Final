---
import type { Locale } from '../i18n/utils';
import type { TranslationSet } from '../i18n/translations';
import { t } from '../i18n/translations';
import site from '../../src/config/site.json';

interface Props {
  locale: Locale;
  translations: TranslationSet | ((key: string, fallback?: string) => any);
}

const { locale, translations } = Astro.props;
const contactEmail = site.contactEmail || 'contact@racinecarreecalculatorr.com';
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
const isFormEnabled = Boolean(web3FormsKey);
const label = (key: string, fallback: string) => {
  if (typeof translations === 'function') {
    return translations(key, fallback);
  }

  const translated = t(translations, key);
  return translated !== key ? translated : fallback;
};
---

<div class="contact-card">
  {!isFormEnabled && (
    <div class="form-status status-info" role="status">
      <p>The contact form is not configured yet. Please email us directly using the address below.</p>
    </div>
  )}
  <form
    id="contact-form"
    class="contact-form"
    data-web3forms-key={web3FormsKey}
    data-msg-sending="Sending message..."
    data-msg-success="Your message has been sent successfully. We will get back to you soon!"
    data-msg-error="There was an error sending your message. Please try again."
    data-msg-network-error="Network error. Please check your connection and try again."
  >
    <div class="form-group">
      <label for="name" class="form-label">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>{label('common.name', 'Name')}</span>
      </label>
      <input 
        type="text" 
        name="name" 
        id="name" 
        required 
        placeholder="Your full name"
        class="form-input" 
      />
    </div>
    
    <div class="form-group">
      <label for="email" class="form-label">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <span>{label('common.email', 'Email Address')}</span>
      </label>
      <input 
        type="email" 
        name="email" 
        id="email" 
        required 
        placeholder="you@example.com"
        class="form-input" 
      />
    </div>
    
    <div class="form-group">
      <label for="message" class="form-label">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <span>{label('common.message', 'Message')}</span>
      </label>
      <textarea 
        id="message" 
        name="message" 
        rows="5" 
        required 
        placeholder="How can we help you?"
        class="form-textarea"
      ></textarea>
    </div>
    
    <button 
      type="submit" 
      id="submit-btn"
      class="form-submit-btn"
      disabled={!isFormEnabled}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      <span>{label('common.sendMessage', 'Send Message')}</span>
    </button>
    
    <div id="form-status" class="form-status hidden">
      <p id="status-message"></p>
    </div>
  </form>
  
  <div class="fallback-contact">
    <p>
      {label('contact.fallbackText', 'Or email us directly at:')} 
      <a href={`mailto:${contactEmail}`} class="fallback-email">
        {contactEmail}
      </a>
    </p>
  </div>
</div>

<style>
  .contact-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    box-shadow: var(--shadow-sm);
  }

  [data-theme="dark"] .contact-card {
    background: var(--bg-surface-elevated);
    border-color: rgba(139, 92, 246, 0.2);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .contact-card > .form-status {
    margin-bottom: var(--space-xl);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-label svg {
    color: var(--primary-500);
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 14px 18px;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--text-primary);
    background: var(--bg-input);
    border: 1.5px solid var(--border-medium);
    border-radius: var(--radius-lg);
    outline: none;
    transition: all 0.2s ease;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.02);
  }

  .form-input:focus,
  .form-textarea:focus {
    background: var(--bg-input-focus);
    border-color: var(--primary-500);
    box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.12);
  }

  .form-textarea {
    resize: vertical;
    min-height: 130px;
    line-height: 1.6;
  }

  .form-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px 24px;
    background: var(--gradient-hero);
    color: #ffffff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    border: none;
    border-radius: var(--radius-lg);
    cursor: pointer;
    box-shadow: var(--shadow-glow);
    transition: all 0.2s ease;
  }

  .form-submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(124, 58, 237, 0.35);
  }

  .form-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .form-status {
    padding: 14px 18px;
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
  }

  .form-status.hidden {
    display: none;
  }

  .form-status.status-info {
    background: var(--primary-50);
    color: var(--primary-700);
    border: 1px solid var(--primary-100);
  }

  .form-status.status-success {
    background: var(--green-50);
    color: var(--green-500);
    border: 1px solid rgba(34, 197, 94, 0.2);
  }

  .form-status.status-error {
    background: var(--rose-50);
    color: var(--rose-500);
    border: 1px solid rgba(244, 63, 94, 0.2);
  }

  .fallback-contact {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-light);
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .fallback-email {
    font-weight: 600;
    color: var(--primary-600);
    text-decoration: none;
  }

  .fallback-email:hover {
    text-decoration: underline;
  }

  [data-theme="dark"] .fallback-email {
    color: var(--primary-300);
  }
</style>
