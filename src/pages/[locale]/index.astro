---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Calculator from '../../components/Calculator.astro';
import ContentSections from '../../components/ContentSections.astro';
import Footer from '../../components/Footer.astro';
import { LOCALES, getHtmlDir, getLocalizedUrl, getLocaleFromParams } from '../../../theme/i18n/utils';
import { useTranslations } from '../../../theme/i18n/translations';
import site from '../../config/site.json';

export const prerender = true;

export function getStaticPaths() {
  return LOCALES
    .filter((locale) => locale !== 'en')
    .map((locale) => ({ params: { locale } }));
}

const lang = getLocaleFromParams(Astro.params);
const t = await useTranslations(lang);
const title = t('site.title', 'Racine Carree Calculator - Free Square Root & Cube Root Tool Online');
const description = t('site.description', 'Calculate square roots, cube roots, nth roots, fractions, and powers with steps and reference tables.');
const canonicalUrl = `${site.siteUrl}${getLocalizedUrl('/', lang)}`;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  dir={getHtmlDir(lang)}
  canonicalUrl={canonicalUrl}
>
  <div class="notranslate" translate="no">
    <Navbar lang={lang} contentLang={lang} />
  </div>
  <section class="above-fold" id="hero">
    <div class="above-fold-stack">
      <div class="notranslate" translate="no">
        <Hero lang={lang} />
        <Calculator lang={lang} />
      </div>
    </div>
  </section>
  <ContentSections lang={lang} />
  <div class="notranslate" translate="no">
    <Footer lang={lang} contentLang={lang} />
  </div>
</Layout>
