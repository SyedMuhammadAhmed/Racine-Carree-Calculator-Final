---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Calculator from '../../components/Calculator.astro';
import ContentSections from '../../components/ContentSections.astro';
import Footer from '../../components/Footer.astro';
import { LOCALES, getHtmlDir, getLocalizedUrl, getLocaleFromParams } from '../../../theme/i18n/utils';
import { useTranslations } from '../../../theme/i18n/translations';
import site from '../../config/site.json';
import { getHomeAlternateLinks } from '../../utils/seo';
import { getHomeContent } from '../../data/i18n/content/homeContent';

export const prerender = true;

export function getStaticPaths() {
  return LOCALES
    .filter((locale) => locale !== 'en')
    .map((locale) => ({ params: { locale } }));
}

const lang = getLocaleFromParams(Astro.params);
const t = await useTranslations(lang);
const content = getHomeContent(lang);
const title = t('site.title', 'Racine Carree Calculator | Online Square Root Calculator');
const description = t('site.description', 'Calculate square roots with exact decimals, simplified radicals, step-by-step workings, and reference tables.');
const canonicalUrl = `${site.siteUrl}${getLocalizedUrl('/', lang)}`;
const alternateLinks = getHomeAlternateLinks();
---

<Layout
  title={title}
  description={description}
  lang={lang}
  dir={getHtmlDir(lang)}
  canonicalUrl={canonicalUrl}
  alternateLinks={alternateLinks}
  faqItems={content.faqs}
>
  <Navbar lang={lang} contentLang={lang} />
  <main id="main-content">
    <section class="above-fold" id="hero">
      <div class="above-fold-stack">
        <Hero lang={lang} />
        <Calculator lang={lang} />
      </div>
    </section>
    <ContentSections lang={lang} faqs={content.faqs} />
  </main>
  <Footer lang={lang} contentLang={lang} />
</Layout>
