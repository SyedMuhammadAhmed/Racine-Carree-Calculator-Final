---
import BaseLayout from '../../../theme/layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Calculator from '../../components/Calculator.astro';
import ContentSections from '../../components/ContentSections.astro';
import { LOCALES } from '../../../theme/i18n/utils';
import { useTranslations } from '../../../theme/i18n/translations';
import site from '../../config/site.json';
import { getLocalizedUrl } from '../../../theme/i18n/utils';

export function getStaticPaths() {
    return LOCALES
        .filter((locale: string) => locale !== 'en')
        .map((locale: string) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const lang = locale as string;
const t = await useTranslations(lang);

const title = t("site.title", "Racine Carree Calculator — Free Square Root & Cube Root Tool Online");
const description = t("site.description", "The most complete Racine Carree Calculator available. Calculate the square root (racine carrée) or cube root (racine cubique) of any number — positive, negative, decimal, or fraction — instantly. Get the exact decimal result, simplified radical form, step-by-step workings, and full reference tables. 100% free.");
const canonicalUrl = site.siteUrl + getLocalizedUrl('/', lang as any);
---

<BaseLayout 
    title={title}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
>
    <section class="above-fold" id="hero">
        <div class="above-fold-stack">
            <Hero lang={lang} />
            <Calculator lang={lang} />
        </div>
    </section>

    <ContentSections lang={lang} />
</BaseLayout>
