---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import NthRootContent from '../../components/NthRootContent.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { LOCALES, getHtmlDir, getLocalizedUrl, getLocaleFromParams } from '../../../theme/i18n/utils';
import { useTranslations } from '../../../theme/i18n/translations';
import site from '../../config/site.json';
import { getPageAlternateLinks } from '../../utils/seo';

export const prerender = true;

export function getStaticPaths() {
  return LOCALES
    .filter((locale) => locale !== 'en')
    .map((locale) => ({ params: { locale } }));
}

const lang = getLocaleFromParams(Astro.params);
const t = await useTranslations(lang);
const title = t('nth.title', 'Nth Root Calculator - Free Root Tool for Any Index');
const description = t('nth.description', 'Calculate any root (4th, 5th, or custom index) instantly with our free Nth Root Calculator. Get exact results, simplified forms, and step-by-step work.');
const canonicalUrl = `${site.siteUrl}${getLocalizedUrl('/nth-root-calculator/', lang)}`;
const alternateLinks = getPageAlternateLinks('/nth-root-calculator/');

const nthFaqs = [
  {
    question: "How do I use the Nth Root Calculator?",
    answer: "Enter your number (radicand) in the first box and the desired root degree (index n) in the second box, then click Calculate for instant results."
  },
  {
    question: "What is the index of a root?",
    answer: "The index is the degree of the root (the number 'n' in ⁿ√x). An index of 2 represents a square root, 3 is a cube root, 4 is a fourth root, and so on."
  },
  {
    question: "Can I find the nth root of a negative number?",
    answer: "If the index n is odd (e.g., 3, 5, 7), a real negative solution exists. If the index n is even (e.g., 2, 4, 6), there is no real solution."
  },
  {
    question: "Does the nth root calculator work for square and cube roots too?",
    answer: "Yes! Set the index n = 2 for square roots or n = 3 for cube roots."
  },
  {
    question: "Is this calculator free to use?",
    answer: "Yes, the Nth Root Calculator is 100% free with no registration required."
  }
];
---

<Layout
  title={title}
  description={description}
  lang={lang}
  dir={getHtmlDir(lang)}
  canonicalUrl={canonicalUrl}
  alternateLinks={alternateLinks}
  mathSolverType="NthRootSolver"
  faqItems={nthFaqs}
>
  <Navbar lang={lang} contentLang={lang} />
  <main id="main-content">
    <section class="above-fold" id="hero">
      <div class="above-fold-stack">
        <Breadcrumbs items={[{ label: 'Home', url: getLocalizedUrl('/', lang) }, { label: 'Nth Root Calculator', url: getLocalizedUrl('/nth-root-calculator/', lang) }]} />
        <header class="hero-compact hero-compact--centered">
          <h1 class="hero-title">
              <span class="title-line">Nth Root</span>
              <span class="title-line gradient-text">Calculator</span>
          </h1>
          <p class="hero-subtitle">Calculate any root — 4th, 5th, or any custom index — instantly. Works for square roots, cube roots, and beyond. Get exact results with simplified forms. 100% free.</p>
          <div class="hero-pills">
              <span class="hero-pill">
                  <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                  Any Root
              </span>
              <span class="hero-pill">
                  <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                  Precise
              </span>
              <span class="hero-pill">
                  <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                  100% Free
              </span>
          </div>
        </header>

        <!-- Nth Root Calculator Widget -->
        <section class="calc-stage" id="calculators" aria-label="Nth Root Calculator">
          <div class="calc-stage-glow" aria-hidden="true"></div>
          <div class="calc-suite" id="calcSuite">
            <div class="calc-panel active" id="panelNthRoot" data-calc="nth-root">
              <article class="calc-widget">
                <header class="calc-widget-head">
                  <span class="calc-widget-symbol" aria-hidden="true">ⁿ√</span>
                  <div class="calc-widget-head-text">
                    <h2 class="calc-widget-title">Nth Root Calculator</h2>
                    <p class="calc-widget-desc">Calculate any root — 4th, 5th, or custom degree</p>
                  </div>
                </header>
                <div class="calc-widget-flow">
                  <section class="calc-step" aria-label="Input field">
                    <div class="input-row">
                      <div class="input-group">
                        <div class="calc-tooltip">
                          <label class="input-label" for="nthDegree">Root degree (n)</label>
                          <span class="calc-tooltip-icon" role="img" aria-label="Root degree instructions">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                            <span class="tooltip-text">The root index. Enter 2 for square root, 3 for cube root, 4 for fourth root, etc.</span>
                          </span>
                        </div>
                        <div class="input-wrapper">
                          <span class="input-prefix" aria-hidden="true">n</span>
                          <input type="number" inputmode="decimal" id="nthDegree" class="calc-input" placeholder="e.g. 4" min="1" step="1" autocomplete="off" aria-label="Root degree (n)">
                        </div>
                      </div>
                      <div class="input-group">
                        <div class="calc-tooltip">
                          <label class="input-label" for="nthValue">Number (x)</label>
                          <span class="calc-tooltip-icon" role="img" aria-label="Number input instructions">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                            <span class="tooltip-text">The number you want to find the root of. For example, if n=4 and x=625, the result is 5 because 5⁴ = 625.</span>
                          </span>
                        </div>
                        <div class="input-wrapper">
                          <span class="input-prefix" aria-hidden="true">x</span>
                          <input type="number" inputmode="decimal" id="nthValue" class="calc-input" placeholder="e.g. 625" step="any" autocomplete="off" aria-label="Number (x)">
                        </div>
                      </div>
                    </div>
                  </section>
                  <section class="calc-step calc-step--action" aria-label="Calculate action">
                    <button class="btn-calc-primary" id="nthCalcBtn" type="button" onclick="calculateNthRoot()" aria-label="Calculate Nth Root">
                      <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                      <span>Calculate Nth Root</span>
                    </button>
                  </section>
                  <section class="calc-step calc-step--results" aria-label="Calculation results">
                    <div class="result-panel" id="nthResult" aria-live="polite" aria-atomic="true">
                      <div class="result-empty">
                        <div class="result-empty-icon" aria-hidden="true">ⁿ√</div>
                        <p class="result-empty-title">Your result will appear here</p>
                        <p class="result-empty-hint">Enter degree and number, then press Calculate</p>
                      </div>
                    </div>
                  </section>
                  <section class="calc-step calc-step--history" id="nthHistory" aria-label="Recent calculations history">
                    <div class="history-header">
                      <h3 class="history-title">Recent calculations</h3>
                      <span class="history-count" id="nthHistoryCount"></span>
                    </div>
                    <div class="history-list" id="nthHistoryList"></div>
                  </section>
                </div>
              </article>
            </div>
          </div>
        </section>
      </div>
    </section>
    <NthRootContent lang={lang} />
  </main>
  <Footer lang={lang} contentLang={lang} />
</Layout>
