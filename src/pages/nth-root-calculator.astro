---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import NthRootContent from '../components/NthRootContent.astro';
import { getHtmlDir } from '../../theme/i18n/utils';
import site from '../config/site.json';

const lang = 'en';
const title = 'Nth Root Calculator - Free Root Calculator for Any Index';
const description = 'Calculate any root — 4th, 5th, 6th, or custom index — instantly with our free Nth Root Calculator. Get exact results, simplified forms, and step-by-step explanations.';
const canonicalUrl = `${site.siteUrl}/nth-root-calculator/`;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  dir={getHtmlDir(lang)}
  canonicalUrl={canonicalUrl}
>
  <Navbar lang={lang} />
  <section class="above-fold" id="hero">
    <div class="above-fold-stack">
      <header class="hero-compact hero-compact--centered">
        <div class="hero-badge">
            <svg class="hero-badge-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
            Free Nth Root Calculator
        </div>
        <h1 class="hero-title">
            <span class="title-line">Nth Root</span>
            <span class="title-line gradient-text">Calculator</span>
        </h1>
        <p class="hero-subtitle">Calculate any root — 4th, 5th, or any custom index — instantly. Works for square roots, cube roots, and beyond. Get exact results with simplified forms. 100% free.</p>
        <div class="hero-pills">
            <span class="hero-pill">
                <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                Any Root
            </span>
            <span class="hero-pill">
                <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
                Precise
            </span>
            <span class="hero-pill">
                <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                100% Free
            </span>
        </div>
      </header>

      <!-- Nth Root Calculator Widget -->
      <main class="calc-stage" id="calculators">
        <div class="calc-stage-glow" aria-hidden="true"></div>
        <div class="calc-suite" id="calcSuite">
          <div class="calc-panel active" id="panelNthRoot" data-calc="nth-root">
            <article class="calc-widget">
              <header class="calc-widget-head">
                <span class="calc-widget-symbol" aria-hidden="true">ⁿ√</span>
                <div class="calc-widget-head-text">
                  <h3 class="calc-widget-title">Nth Root Calculator</h3>
                  <p class="calc-widget-desc">Calculate any root — 4th, 5th, or custom degree</p>
                </div>
              </header>
              <div class="calc-widget-flow">
                <section class="calc-step" aria-label="Input">
                  <div class="input-row">
                    <div class="input-group">
                      <label class="input-label" for="nthDegree">Root degree (n)</label>
                      <div class="input-wrapper">
                        <span class="input-prefix">n</span>
                        <input type="number" inputmode="decimal" id="nthDegree" class="calc-input" placeholder="e.g. 4" min="1" step="1" autocomplete="off">
                      </div>
                    </div>
                    <div class="input-group">
                      <label class="input-label" for="nthValue">Number (x)</label>
                      <div class="input-wrapper">
                        <span class="input-prefix">x</span>
                        <input type="number" inputmode="decimal" id="nthValue" class="calc-input" placeholder="e.g. 625" step="any" autocomplete="off">
                      </div>
                    </div>
                  </div>
                </section>
                <section class="calc-step calc-step--action">
                  <button class="btn-calc-primary" id="nthCalcBtn" type="button" onclick="calculateNthRoot()">
                    <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    <span>Calculate</span>
                  </button>
                </section>
                <section class="calc-step calc-step--results" aria-label="Results">
                  <div class="result-panel" id="nthResult">
                    <div class="result-empty">
                      <div class="result-empty-icon" aria-hidden="true">ⁿ√</div>
                      <p class="result-empty-title">Your result will appear here</p>
                      <p class="result-empty-hint">Enter degree and number, then press Calculate</p>
                    </div>
                  </div>
                </section>
                <section class="calc-step calc-step--history" id="nthHistory">
                  <div class="history-header">
                    <h4 class="history-title">Recent calculations</h4>
                    <span class="history-count" id="nthHistoryCount"></span>
                  </div>
                  <div class="history-list" id="nthHistoryList"></div>
                </section>
              </div>
            </article>
          </div>
        </div>
      </main>
    </div>
  </section>
  <NthRootContent lang={lang} />
  <Footer lang={lang} />
</Layout>
