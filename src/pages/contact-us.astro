---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import ContactForm from '../../theme/components/ContactForm.astro';
import { useTranslations } from '../../theme/i18n/translations';
import site from '../config/site.json';

const lang = 'en';
const t = await useTranslations(lang);
const title = t("contact.title", "Contact Us");
const description = t("contact.description", "Get in touch with the Racine Carree Calculator team.");

const canonicalUrl = `${site.siteUrl}/contact-us/`;
---

<BaseLayout 
    title={`${title} | ${site.siteName}`}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
    isContactPage={true}
>
    <div class="page-shell">
        <section class="article-section" id="contact-us">
            <div class="article-container">
                <div class="section-eyebrow">
                    <span class="eyebrow-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    </span> 
                    Support & Feedback
                </div>
                
                <h1 class="article-h2" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; background: var(--gradient-hero); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 24px;">{title}</h1>
                
                <p class="hero-subtitle" style="max-width: 100%; text-align: left; margin-bottom: 48px; font-size: 1.15rem;">
                    Have a question, feedback, or a feature request? We'd love to hear from you. Fill out the form below and our team will get back to you as soon as possible.
                </p>

                <div class="applications-grid" style="margin-bottom: 48px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
                    <div class="app-card">
                        <div class="app-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                        <h4 style="margin-bottom: 8px;">General Inquiries</h4>
                        <p style="color: var(--text-secondary); font-size: 0.95rem;">Got questions about our calculator features or math formulas? We are here to help clarify.</p>
                    </div>
                    <div class="app-card">
                        <div class="app-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
                        <h4 style="margin-bottom: 8px;">Feature Requests</h4>
                        <p style="color: var(--text-secondary); font-size: 0.95rem;">Missing a tool? Want us to add complex numbers or graphing? Send us your suggestions.</p>
                    </div>
                    <div class="app-card">
                        <div class="app-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
                        <h4 style="margin-bottom: 8px;">Bug Reports</h4>
                        <p style="color: var(--text-secondary); font-size: 0.95rem;">Noticed a calculation error or a layout issue on your device? Let us know so we can fix it.</p>
                    </div>
                </div>

                <div style="background: var(--bg-surface-elevated); border: 1px solid var(--border-default); border-radius: var(--radius-lg); padding: var(--space-xl); box-shadow: var(--shadow-sm);">
                    <ContactForm locale={lang} translations={t} />
                </div>

            </div>
        </section>
    </div>
</BaseLayout>
