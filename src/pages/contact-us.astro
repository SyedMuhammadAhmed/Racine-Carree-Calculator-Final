---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import ContactForm from '../../theme/components/ContactForm.astro';
import { useTranslations } from '../../theme/i18n/translations';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../config/site.json';

const lang = 'en';
const t = await useTranslations(lang);
const title = "Contact Us";
const description = "Get in touch with the Racine Carree Calculator team for questions, feedback, bug reports, or feature requests.";
const canonicalUrl = `${site.siteUrl}/contact-us/`;
---

<BaseLayout 
    title={`${title} | ${site.siteName}`}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
    isContactPage={true}
>
    <Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: 'Contact Us', url: '/contact-us/' }]} />
    <div class="page-shell">
        <section class="article-section" id="contact-us">
            <div class="article-container">
                <div class="section-eyebrow">
                    <span class="eyebrow-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    </span> 
                    Support & Feedback
                </div>
                
                <h1 class="article-h2" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; background: var(--gradient-hero); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 24px;">Get in Touch</h1>
                
                <p class="hero-subtitle" style="max-width: 100%; text-align: left; margin-bottom: 48px; font-size: 1.15rem;">
                    Whether you have a question, found a bug, want to suggest a feature, or just want to say something nice — we'd genuinely love to hear from you.
                </p>

                <!-- What We're Happy to Help With -->
                <h2 class="article-h2">What We're Happy to Help With</h2>
                <div class="applications-grid" style="margin-bottom: 48px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
                    <div class="app-card">
                        <div class="app-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                        <h4>General Questions</h4>
                        <p>Not sure how something works? Confused by a result? Just ask — we're happy to explain.</p>
                    </div>
                    <div class="app-card">
                        <div class="app-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
                        <h4>Feature Requests</h4>
                        <p>Want us to add a new calculator, a new reference table, or support for a specific format? Tell us what would be useful.</p>
                    </div>
                    <div class="app-card">
                        <div class="app-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
                        <h4>Bug Reports</h4>
                        <p>If a calculation seems wrong, a page isn't loading properly, or something looks broken on your device — we want to know so we can fix it.</p>
                    </div>
                    <div class="app-card">
                        <div class="app-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg></div>
                        <h4>Feedback & Kind Words</h4>
                        <p>If the site helped you ace a test, finish a project, or just finally understand square roots — we'd love to hear about it.</p>
                    </div>
                </div>

                <!-- How to Reach Us -->
                <h2 class="article-h2">How to Reach Us</h2>
                <p style="margin-bottom: 32px;">The easiest way to contact us is through the form below. Just fill it out and hit send — your message goes straight to our team.</p>

                <div style="margin-bottom: 48px;">
                    <ContactForm locale={lang} translations={t} />
                </div>

                <!-- Please Note -->
                <div class="warning-box">
                    <div class="warning-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    </div>
                    <div class="warning-content">
                        <strong>Please Note</strong>
                        <p style="margin-top: 8px;">We read every message and try to respond as quickly as we can — but since we're a small team, it may take a day or two. If your message is about a bug, please include as much detail as possible (the number you entered, what browser you're using, what happened vs. what you expected). The more we know, the faster we can fix it.</p>
                    </div>
                </div>
            </div>
        </section>
    </div>
</BaseLayout>
