---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Calculator from '../components/Calculator.astro';
import ContentSections from '../components/ContentSections.astro';
import Footer from '../components/Footer.astro';
import { getHtmlDir } from '../../theme/i18n/utils';
import { useTranslations } from '../../theme/i18n/translations';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../config/site.json';

const lang = 'en';
const t = await useTranslations(lang);
const title = t('site.title', 'Racine Carree Calculator - Free Square Root & Cube Root Tool Online');
const description = t('site.description', 'Calculate square roots, cube roots, nth roots, fractions, and powers with steps and reference tables.');
const sqrtFaqs = [
  {
    question: "How do I use the Racine Carree Calculator?",
    answer: "Type your number into the input box above, click Calculate, and get instant exact decimal results, simplified radical form (e.g., √72 = 6√2), and step-by-step working out."
  },
  {
    question: "Can I calculate square roots manually?",
    answer: "Yes! Popular manual methods include prime factorization (best for perfect squares like √144 = 12), long division method (exact digit-by-digit calculation), and the Newton-Raphson estimation method."
  },
  {
    question: "What does \"racine carrée\" mean?",
    answer: "Racine carrée is the French term for square root. In mathematics, it represents a number that, when multiplied by itself, yields the original radicand (e.g., racine carrée de 25 est 5)."
  },
  {
    question: "Can the calculator handle negative numbers?",
    answer: "In real-number mathematics, square roots of negative numbers are undefined (no real number multiplied by itself gives a negative). In complex mathematics, √(-x) yields an imaginary result involving i."
  },
  {
    question: "Is this calculator free to use?",
    answer: "Yes, our Racine Carrée Calculator is 100% free with no registration, software download, or sign-up required."
  }
];
---

<Layout
  title={title}
  description={description}
  lang={lang}
  dir={getHtmlDir(lang)}
  canonicalUrl={`${site.siteUrl}/`}
  faqItems={sqrtFaqs}
>
  <Navbar lang={lang} />
  <main id="main-content">
    <section class="above-fold" id="hero">
      <div class="above-fold-stack">
        <Hero lang={lang} />
        <Calculator lang={lang} />
      </div>
    </section>
    <ContentSections lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
