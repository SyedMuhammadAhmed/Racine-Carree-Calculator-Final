---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import { useTranslations } from '../../theme/i18n/translations';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../config/site.json';

const lang = 'en';
const t = await useTranslations(lang);
const title = "About Racine Carree Calculator | Syed Muhammad Ahmed";
const description = "Learn about Racine Carree Calculator, our story, parent organization, trusted source standards, and founder & creator Syed Muhammad Ahmed.";
const canonicalUrl = `${site.siteUrl}/about-us/`;
---

<BaseLayout 
    title={`${title} | ${site.siteName}`}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
    isAboutPage={true}
>
    <div class="page-shell">
        <Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: 'About Us', url: '/about-us/' }]} />
        <section class="article-section" id="about-us">
            <div class="article-container">
                
                <!-- Eyebrow & Main Title -->
                <div class="section-eyebrow">
                    <span class="eyebrow-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span> 
                    About Us &amp; Our Story
                </div>
                
                <h1 class="article-h2" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; background: var(--gradient-hero); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 24px;">
                    About Racine Carree Calculator
                </h1>
                
                <p class="hero-subtitle" style="max-width: 100%; text-align: left; margin-bottom: 40px; font-size: 1.15rem; line-height: 1.7;">
                    Racine Carree Calculator is a free, high-precision mathematical suite engineered to make square root, cube root, and nth root calculations fast, transparent, and universally accessible. Whether you are solving algebraic equations, verifying geometry homework, or modeling engineering problems, our platform delivers instant exact decimal values, simplified radical expressions, and full step-by-step mathematical reasoning.
                </p>

                <!-- Social Proof Stats Displayed -->
                <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 48px;">
                    <div class="stat-card" style="background: var(--bg-surface); border: 1px solid var(--border-default); border-radius: var(--radius-lg); padding: 24px; text-align: center; box-shadow: var(--shadow-sm);">
                        <div style="font-size: 2.2rem; font-weight: 800; color: var(--primary-500); line-height: 1;">Free</div>
                        <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-secondary); margin-top: 8px;">No account required</div>
                    </div>
                    <div class="stat-card" style="background: var(--bg-surface); border: 1px solid var(--border-default); border-radius: var(--radius-lg); padding: 24px; text-align: center; box-shadow: var(--shadow-sm);">
                        <div style="font-size: 2.2rem; font-weight: 800; color: var(--accent-500); line-height: 1;">Clear</div>
                        <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-secondary); margin-top: 8px;">Results and explanations</div>
                    </div>
                    <div class="stat-card" style="background: var(--bg-surface); border: 1px solid var(--border-default); border-radius: var(--radius-lg); padding: 24px; text-align: center; box-shadow: var(--shadow-sm);">
                        <div style="font-size: 2.2rem; font-weight: 800; color: var(--warm-500); line-height: 1;">Online</div>
                        <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-secondary); margin-top: 8px;">Works in modern browsers</div>
                    </div>
                    <div class="stat-card" style="background: var(--bg-surface); border: 1px solid var(--border-default); border-radius: var(--radius-lg); padding: 24px; text-align: center; box-shadow: var(--shadow-sm);">
                        <div style="font-size: 2.2rem; font-weight: 800; color: var(--green-500); line-height: 1;">100% Free</div>
                        <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-secondary); margin-top: 8px;">No Sign-up or Paywalls</div>
                    </div>
                </div>

                <!-- Who We Are & Creator Section with Attached Photo -->
                <h2 class="article-h2">Who We Are</h2>
                <div class="creator-profile-card" style="display: flex; flex-wrap: wrap; gap: 32px; align-items: center; background: var(--bg-surface-elevated); border: 1px solid var(--border-default); border-radius: var(--radius-xl); padding: 32px; margin: 24px 0 48px; box-shadow: var(--shadow-md);">
                    <div class="creator-avatar-wrapper" style="flex-shrink: 0; text-align: center; margin: 0 auto;">
                        <img 
                            src="/images/syed-muhammad-ahmed-racine-carree-calculator.jpg" 
                            alt="Syed Muhammad Ahmed, Founder and Creator of Racine Carree Calculator" 
                            width="220" 
                            height="220" 
                            loading="eager" 
                            decoding="async" 
                            style="border-radius: 50%; width: 180px; height: 180px; object-fit: cover; border: 4px solid var(--primary-400); box-shadow: var(--shadow-lg); display: block;" 
                        />
                        <div style="margin-top: 12px; font-weight: 700; font-size: 1.15rem; color: var(--text-primary);">Syed Muhammad Ahmed</div>
                        <div style="font-size: 0.85rem; color: var(--primary-500); font-weight: 600;">Founder &amp; Creator</div>
                    </div>
                    <div class="creator-bio" style="flex: 1; min-width: 280px;">
                        <h3 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 12px; color: var(--text-primary);">Meet the Creator Behind the Calculator</h3>
                        <p style="margin-bottom: 14px; line-height: 1.7; color: var(--text-secondary);">
                            <strong>Syed Muhammad Ahmed</strong> is the founder, architect, and lead developer of <strong>Racine Carree Calculator</strong>. Driven by a passion for clean software design, educational technology, and mathematical transparency, Ahmed designed this tool to bridge the gap between quick online answer generators and genuine mathematical comprehension.
                        </p>
                        <p style="margin-bottom: 16px; line-height: 1.7; color: var(--text-secondary);">
                            With a strong background in computer science, digital systems, and UI/UX design, he personally verifies calculation algorithms, optimizes numerical computing performance, and ensures every user enjoys an intuitive, ad-clutter-free computational experience.
                        </p>
                        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 16px;">
                            <a href="https://www.linkedin.com/company/144823222/" target="_blank" rel="noopener noreferrer" class="creator-social-btn creator-social-btn--linkedin" title="LinkedIn Profile" aria-label="LinkedIn">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                                <span>LinkedIn</span>
                            </a>
                            <a href="https://www.behance.net/syedmuahmed17" target="_blank" rel="noopener noreferrer" class="creator-social-btn creator-social-btn--behance" title="Behance Portfolio" aria-label="Behance">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 7h-7v-2h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-4.045 0-6.625-2.735-6.625-6.744 0-4.041 2.658-6.756 6.386-6.756 4.316 0 5.865 3.327 5.484 6.78h-8.847c.182 2.029 1.625 3.375 3.654 3.375 1.583 0 2.593-.655 3.049-1.655h2zM12.023 11.5c-.17-1.802-1.39-2.906-3.13-2.906-1.897 0-3.088 1.139-3.267 2.906h6.397zM0 4.5h7.247c2.146 0 3.753.518 4.718 1.517.854.887 1.288 2.054 1.288 3.447 0 1.298-.445 2.39-1.285 3.197-.84.808-1.996 1.272-3.373 1.365 1.651.273 2.924.966 3.734 2.036.81 1.07 1.229 2.459 1.229 4.077 0 1.761-.577 3.208-1.705 4.275-1.129 1.066-2.784 1.586-4.881 1.586H0V4.5zm3.178 6.559h3.701c.983 0 1.73-.207 2.203-.609.473-.401.716-.984.716-1.72 0-.76-.243-1.348-.716-1.736-.473-.388-1.22-.591-2.203-.591H3.178v4.656zm0 9.215h3.987c1.11 0 1.956-.237 2.493-.699.537-.461.812-1.144.812-2.019 0-.895-.279-1.579-.824-2.02-.545-.441-1.408-.67-2.544-.67H3.178v5.408z"/></svg>
                                <span>Behance</span>
                            </a>
                            <a href="https://www.youtube.com/@RacineCarreeCalculator" target="_blank" rel="noopener noreferrer" class="creator-social-btn creator-social-btn--youtube" title="YouTube Channel" aria-label="YouTube">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                <span>YouTube</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Parent Company Described -->
                <h2 class="article-h2">Parent Organization &amp; Mission</h2>
                <p>
                    <strong>Racine Carree Calculator</strong> operates as an independent digital education project under the <strong>Syed Muhammad Ahmed STEM Initiatives</strong> umbrella. Our parent mission is straightforward: to engineer free, ultra-fast, zero-friction educational utilities that eliminate technical paywalls and make foundational mathematics accessible to anyone with an internet connection.
                </p>
                <p>
                    Unlike commercial homework-solver portals that charge recurring subscriptions or restrict step-by-step answers behind gated accounts, our parent organization adheres to an open-access philosophy: complete calculation transparency, zero forced registrations, and no invasive user tracking.
                </p>

                <!-- Our Story Section -->
                <h2 class="article-h2" style="margin-top: 48px;">Our Story: Why We Built This Calculator</h2>
                <p>
                    The idea for Racine Carree Calculator originated when working with students and discovering a recurring frustration: almost every square root tool online fell into one of three categories:
                </p>
                <ul style="margin: 16px 0 24px 20px; line-height: 1.8; color: var(--text-secondary);">
                    <li><strong>Too basic:</strong> Built-in phone calculators return only a decimal approximations (like 8.48528) with zero explanation of radical simplification (like 6√2).</li>
                    <li><strong>Too commercialized:</strong> Traditional academic solver sites drown users in intrusive video ads, popups, and lock step-by-step methods behind monthly paywalls.</li>
                    <li><strong>Too complex:</strong> High-end computer algebra systems are heavy, difficult on mobile devices, and require learning specialized syntax.</li>
                </ul>
                <p>
                    We set out to build the definitive solution: a lightning-fast web calculator that instantly shows exact decimals, simplified radical forms, step-by-step prime factorizations, and manual long division steps — all wrapped in an elegant, responsive, dark-mode-ready interface.
                </p>

                <!-- Trusted Source Statement -->
                <h2 class="article-h2" style="margin-top: 48px;">Trusted Source Statement &amp; Editorial Standards</h2>
                <div class="callout callout--info" style="margin-bottom: 32px; background: rgba(124, 58, 237, 0.05); border-left: 4px solid var(--primary-500); padding: 20px; border-radius: 0 var(--radius-md) var(--radius-md) 0;">
                    <h3 style="margin-top: 0; font-size: 1.15rem; color: var(--text-primary);">Our Mathematical Verification Guarantee</h3>
                    <p style="margin-bottom: 8px; color: var(--text-secondary); line-height: 1.7;">
                        Accuracy is our highest priority. All calculation engines on Racine Carree Calculator are implemented using industry-standard floating-point arithmetic (IEEE 754) and cross-verified against established symbolic algebra algorithms.
                    </p>
                    <ul style="margin: 8px 0 0 16px; color: var(--text-secondary); line-height: 1.6;">
                        <li><strong>Multi-Method Cross-Checking:</strong> Decimal roots are computed using Newton-Raphson approximation iterations verified to 10+ decimal places.</li>
                        <li><strong>Exact Radical Simplification:</strong> Radical reductions use canonical prime factorization trees, ensuring exact simplified forms with no rounding error.</li>
                        <li><strong>Zero Data Telemetry:</strong> All user inputs and calculations are processed securely in your browser session and never stored or sold.</li>
                    </ul>
                </div>

                <!-- What We Offer -->
                <h2 class="article-h2" style="margin-top: 48px;">What We Offer</h2>
                <div class="law-cards" style="margin-bottom: 48px;">
                    <div class="law-card">
                        <div class="law-header">
                            <div class="law-number"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
                            <div><div class="law-label">Three Dedicated Root Calculators</div></div>
                        </div>
                        <p class="law-example">Our core suite includes the <a href="/" style="color: var(--primary-500); font-weight: 600;">Racine Carree (Square Root) Calculator</a>, the <a href="/racine-cubique-calculator/" style="color: var(--primary-500); font-weight: 600;">Racine Cubique (Cube Root) Calculator</a>, and the versatile <a href="/nth-root-calculator/" style="color: var(--primary-500); font-weight: 600;">Nth Root Calculator</a>.</p>
                    </div>
                    <div class="law-card">
                        <div class="law-header">
                            <div class="law-number"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></div>
                            <div><div class="law-label">Complete Step-by-Step Solutions</div></div>
                        </div>
                        <p class="law-example">Every calculation generates clear, pedagogically structured workings showing prime factor pairings, simplification factors, and verification proofs.</p>
                    </div>
                    <div class="law-card">
                        <div class="law-header">
                            <div class="law-number"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></div>
                            <div><div class="law-label">Comprehensive Mathematical Guides</div></div>
                        </div>
                        <p class="law-example">Each calculator page features illustrated guides, radical law references, manual calculation techniques, perfect powers tables, and common FAQ answers.</p>
                    </div>
                </div>

                <!-- Featured Websites & Mathematical References Linked -->
                <h2 class="article-h2">Featured Authorities &amp; Mathematical References</h2>
                <p style="margin-bottom: 24px; color: var(--text-secondary);">
                    In our commitment to transparency and educational excellence, our algorithms and mathematical content reference leading computational authorities:
                </p>
                <div class="references-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 48px;">
                    <a href="https://mathworld.wolfram.com/SquareRoot.html" target="_blank" rel="noopener noreferrer" class="ref-link-card" style="display: block; padding: 18px; border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--bg-surface); text-decoration: none; transition: transform var(--transition-fast), border-color var(--transition-fast);">
                        <strong style="display: block; color: var(--primary-500); font-size: 1.05rem; margin-bottom: 4px;">Wolfram MathWorld →</strong>
                        <span style="font-size: 0.85rem; color: var(--text-muted);">Definitive reference for radical expressions, continuous fractions, and root algorithms.</span>
                    </a>
                    <a href="https://www.khanacademy.org/math/algebra/x2f8bb11595b61c86:rational-exponents-radicals" target="_blank" rel="noopener noreferrer" class="ref-link-card" style="display: block; padding: 18px; border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--bg-surface); text-decoration: none; transition: transform var(--transition-fast), border-color var(--transition-fast);">
                        <strong style="display: block; color: var(--primary-500); font-size: 1.05rem; margin-bottom: 4px;">Khan Academy Radicals →</strong>
                        <span style="font-size: 0.85rem; color: var(--text-muted);">Educational curriculum for square root simplification and exponent properties.</span>
                    </a>
                    <a href="https://oeis.org/A000290" target="_blank" rel="noopener noreferrer" class="ref-link-card" style="display: block; padding: 18px; border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--bg-surface); text-decoration: none; transition: transform var(--transition-fast), border-color var(--transition-fast);">
                        <strong style="display: block; color: var(--primary-500); font-size: 1.05rem; margin-bottom: 4px;">OEIS Perfect Squares (A000290) →</strong>
                        <span style="font-size: 0.85rem; color: var(--text-muted);">On-Line Encyclopedia of Integer Sequences index for verifying perfect powers.</span>
                    </a>
                    <a href="https://en.wikipedia.org/wiki/Square_root" target="_blank" rel="noopener noreferrer" class="ref-link-card" style="display: block; padding: 18px; border: 1px solid var(--border-default); border-radius: var(--radius-lg); background: var(--bg-surface); text-decoration: none; transition: transform var(--transition-fast), border-color var(--transition-fast);">
                        <strong style="display: block; color: var(--primary-500); font-size: 1.05rem; margin-bottom: 4px;">Wikipedia: Square Root →</strong>
                        <span style="font-size: 0.85rem; color: var(--text-muted);">Historical background, geometric interpretation, and algebraic identities.</span>
                    </a>
                </div>

                <!-- Contact Callout -->
                <div class="warning-box" style="margin-top: 40px;">
                    <div class="warning-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </div>
                    <div class="warning-content">
                        <strong>Direct Contact &amp; Corrections</strong>
                        <p style="margin-top: 8px;">
                            We welcome suggestions, academic feedback, and feature requests. You can contact Syed Muhammad Ahmed and the team directly at <a href="mailto:contact@racinecarreecalculatorr.com" style="color: var(--primary-500); font-weight: 600;">contact@racinecarreecalculatorr.com</a> or via our <a href="/contact-us/" style="color: var(--primary-500); font-weight: 600; text-decoration: underline;">Contact Page</a>.
                        </p>
                    </div>
                </div>

            </div>
        </section>
    </div>
</BaseLayout>
