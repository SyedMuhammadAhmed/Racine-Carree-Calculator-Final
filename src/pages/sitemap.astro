---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import { LOCALES } from '../../theme/i18n/utils';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../config/site.json';
import { getPageAlternateLinks } from '../utils/seo';

const lang = 'en';
const title = "Sitemap";
const description = "Explore the complete Racine Carrée Calculator sitemap for square root, cube root, nth root, company, and policy pages.";
const canonicalUrl = `${site.siteUrl}/sitemap/`;
const alternateLinks = getPageAlternateLinks('/sitemap/');

const mainPages = [
  { label: "Home — Racine Carrée Calculator", href: "/" },
  { label: "Racine Cubique Calculator", href: "/racine-cubique-calculator/" },
  { label: "Nth Root Calculator", href: "/nth-root-calculator/" },
  { label: "About Us", href: "/about-us/" },
  { label: "Contact Us", href: "/contact-us/" },
  { label: "Privacy Policy", href: "/privacy/" },
  { label: "Terms & Conditions", href: "/terms/" },
  { label: "Disclaimer", href: "/disclaimer/" },
  { label: "Sitemap", href: "/sitemap/" },
];

const languages = LOCALES.filter(loc => loc !== 'en').map(loc => ({
  label: loc.toUpperCase(),
  href: `/${loc}/`
}));
---

<BaseLayout 
    title={`${title} | ${site.siteName}`}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
    alternateLinks={alternateLinks}
>
    <div class="page-shell">
        <Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: 'Sitemap', url: '/sitemap/' }]} />
        <section class="article-section" id="sitemap">
            <div class="article-container">
                <div class="section-eyebrow">
                    <span class="eyebrow-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M12 22V9"/><path d="M12 2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"/><path d="M5 18a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2Z"/><path d="M15 18a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h0a2 2 0 0 1-2-2Z"/></svg>
                    </span> 
                    Navigation
                </div>
                
                <h1 class="article-h2" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; background: var(--gradient-hero); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 16px;">{title}</h1>
                <p class="hero-subtitle" style="font-weight: 600;">Full overview of Racine Carrée Calculator</p>
                
                <div style="margin-top: 40px; margin-bottom: 40px;">
                    <h2 class="article-h3" style="margin-bottom: 24px;">Main Pages</h2>
                    <div class="law-cards" style="grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));">
                        {mainPages.map(page => (
                            <a href={page.href} class="law-card" style="text-decoration: none; display: flex; align-items: center; justify-content: center; text-align: center; padding: 24px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                                <span style="font-weight: 600; font-size: 1.1rem; color: var(--gray-900);">{page.label}</span>
                            </a>
                        ))}
                    </div>
                </div>

                <div style="margin-bottom: 40px;">
                    <h2 class="article-h3" style="margin-bottom: 24px;">Languages</h2>
                    <div class="law-cards" style="grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));">
                        {languages.map(lang => (
                            <a href={lang.href} class="law-card" style="text-decoration: none; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                                <span style="font-weight: 600; font-size: 1.1rem; color: var(--primary-600);">{lang.label}</span>
                            </a>
                        ))}
                    </div>
                </div>

            </div>
        </section>
    </div>
</BaseLayout>
