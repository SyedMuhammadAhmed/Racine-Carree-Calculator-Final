---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import { useTranslations } from '../../theme/i18n/translations';
import site from '../config/site.json';

const lang = 'en';
const t = await useTranslations(lang);
const title = "Terms of Service";
const description = "Terms of Service and Usage Guidelines for Racine Carree Calculator.";
const canonicalUrl = `${site.siteUrl}/terms/`;
---

<BaseLayout 
    title={`${title} | ${site.siteName}`}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <h1 class="text-4xl font-extrabold text-gray-900 mb-8">{title}</h1>
        
        <div class="prose prose-lg text-gray-600 max-w-none">
            <p><strong>Last Updated: {new Date().toLocaleDateString()}</strong></p>

            <h2>1. Acceptance of Terms</h2>
            <p>
                By accessing and using the Racine Carrée Calculator ("the Service"), you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use our website or services.
            </p>

            <h2>2. Use of the Service</h2>
            <p>
                The Racine Carrée Calculator provides mathematical tools and reference tables for informational and educational purposes. You may use the Service freely for personal, academic, or professional calculations. You agree not to use the Service for any unlawful purpose or in any way that could damage, disable, overburden, or impair our servers or networks.
            </p>

            <h2>3. Intellectual Property</h2>
            <p>
                All content, design elements, algorithms, and code on this website are the property of Racine Carrée Calculator and are protected by applicable intellectual property laws. You may not copy, reproduce, distribute, or create derivative works from any part of the Service without our express written permission.
            </p>

            <h2>4. Disclaimer of Warranties</h2>
            <p>
                The Service is provided on an "AS IS" and "AS AVAILABLE" basis. While we strive for absolute accuracy in our calculations, we make no warranties, expressed or implied, regarding the accuracy, reliability, or availability of the Service. Any reliance you place on the results generated by the calculator is strictly at your own risk.
            </p>

            <h2>5. Limitation of Liability</h2>
            <p>
                In no event shall Racine Carrée Calculator, its developers, or affiliates be liable for any direct, indirect, incidental, special, consequential, or punitive damages arising out of or relating to your use of, or inability to use, the Service. This includes, but is not limited to, damages for loss of profits, data, or other intangible losses.
            </p>

            <h2>6. Third-Party Links</h2>
            <p>
                Our Service may contain links to third-party websites or services that are not owned or controlled by Racine Carrée Calculator. We have no control over, and assume no responsibility for, the content, privacy policies, or practices of any third-party websites or services.
            </p>

            <h2>7. Changes to Terms</h2>
            <p>
                We reserve the right to modify or replace these Terms of Service at any time. Any changes will be posted on this page with an updated "Last Updated" date. Your continued use of the Service after any such changes constitutes your acceptance of the new Terms of Service.
            </p>

            <h2>8. Governing Law</h2>
            <p>
                These terms and conditions are governed by and construed in accordance with the laws of the applicable jurisdiction, without regard to its conflict of law provisions.
            </p>

            <h2>9. Contact Us</h2>
            <p>
                If you have any questions about these Terms of Service, please contact us through our Contact page or at contact@example.com.
            </p>
        </div>
    </div>
</BaseLayout>
