---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import { useTranslations } from '../../theme/i18n/translations';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../config/site.json';

const lang = 'en';
const t = await useTranslations(lang);
const title = "Terms & Conditions";
const description = "Terms & Conditions for using the Racine Carree Calculatorr website and its calculator tools.";
const canonicalUrl = `${site.siteUrl}/terms/`;
---

<BaseLayout 
    title={`${title} | ${site.siteName}`}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
>
    <Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: 'Terms & Conditions', url: '/terms/' }]} />
    <div class="page-shell">
        <section class="article-section" id="terms-conditions">
            <div class="article-container">
                <div class="section-eyebrow">
                    <span class="eyebrow-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    </span> 
                    Legal Agreement
                </div>
                
                <h1 class="article-h2" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; background: var(--gradient-hero); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 16px;">Terms & Conditions</h1>
                <p class="hero-subtitle" style="font-weight: 600;">Last Updated: August 2026</p>
                
                <p style="margin-top: 24px; margin-bottom: 32px;">By accessing and using Racine Carree Calculatorr (racinecarreecalculator.com), you agree to be bound by these Terms & Conditions. If you do not agree to any part of these terms, please do not use the Site.</p>

                <h2 class="article-h2">1. Use of the Site</h2>
                <p>This Site provides free online calculator tools for educational and informational purposes. You may use the Site for personal, non-commercial purposes. You agree not to misuse the Site, attempt to interfere with its operation, or use it for any unlawful purpose.</p>

                <h2 class="article-h2">2. Accuracy of Results</h2>
                <p>While we strive for mathematical precision, the results provided by our calculators are for informational and educational purposes only. They should not be used as the sole basis for professional, financial, engineering, or safety-critical decisions. Always verify important calculations independently.</p>

                <h2 class="article-h2">3. Intellectual Property</h2>
                <p>All content on this Site — including text, graphics, logos, icons, code, and calculator designs — is the property of Racine Carree Calculatorr and is protected by applicable copyright and intellectual property laws. You may not reproduce, distribute, or modify this content without our prior written consent.</p>

                <h2 class="article-h2">4. User-Submitted Content</h2>
                <p>If you submit content through the contact form or any other method, you grant us a non-exclusive, royalty-free right to use that content for the purpose of responding to your inquiry and improving the Site. Do not submit any content that is illegal, harmful, or infringes on the rights of others.</p>

                <h2 class="article-h2">5. Third-Party Links</h2>
                <p>The Site may contain links to third-party websites. We are not responsible for the content, privacy practices, or availability of these external sites. Visiting them is at your own risk.</p>

                <h2 class="article-h2">6. Limitation of Liability</h2>
                <p>To the fullest extent permitted by law, Racine Carree Calculatorr and its creators shall not be liable for any direct, indirect, incidental, or consequential damages arising from your use of, or inability to use, the Site or its content. This includes, but is not limited to, errors in calculations, loss of data, or interruptions in service.</p>

                <h2 class="article-h2">7. Modifications to These Terms</h2>
                <p>We reserve the right to update or modify these Terms & Conditions at any time. Changes will be posted on this page with an updated "Last Updated" date. Your continued use of the Site after changes are posted constitutes your acceptance of the new terms.</p>

                <h2 class="article-h2">8. Termination</h2>
                <p>We reserve the right to restrict or terminate your access to the Site at any time, without notice, for any reason — including violation of these Terms & Conditions.</p>

                <h2 class="article-h2">9. Governing Law</h2>
                <p>These Terms & Conditions are governed by and construed in accordance with the laws of the United States. Any disputes arising from these terms shall be subject to the exclusive jurisdiction of the courts in that jurisdiction.</p>

                <h2 class="article-h2">10. Contact</h2>
                <p>If you have any questions about these Terms & Conditions, please contact us at <a href="mailto:contact@racinecarreecalculator.com" style="color: var(--primary-500); font-weight: 600;">contact@racinecarreecalculator.com</a> or through our <a href="/contact-us/" style="color: var(--primary-500); font-weight: 600;">Contact Page</a>.</p>
            </div>
        </section>
    </div>
</BaseLayout>
