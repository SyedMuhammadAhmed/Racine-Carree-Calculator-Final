---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import { useTranslations } from '../../theme/i18n/translations';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../config/site.json';

const lang = 'en';
const t = await useTranslations(lang);
const title = "Privacy Policy";
const description = "Privacy Policy for Racine Carree Calculatorr — how we handle your data, cookies, and third-party services.";
const canonicalUrl = `${site.siteUrl}/privacy/`;
---

<BaseLayout 
    title={`${title} | ${site.siteName}`}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
>
    <Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: 'Privacy Policy', url: '/privacy/' }]} />
    <div class="page-shell">
        <section class="article-section" id="privacy-policy">
            <div class="article-container">
                <div class="section-eyebrow">
                    <span class="eyebrow-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </span> 
                    Data Protection
                </div>
                
                <h1 class="article-h2" style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; background: var(--gradient-hero); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 16px;">Privacy Policy</h1>
                <p class="hero-subtitle" style="font-weight: 600;">Last Updated: August 2026</p>
                
                <p style="margin-top: 24px; margin-bottom: 32px;">This Privacy Policy explains how Racine Carree Calculatorr ("we," "us," or "our") collects, uses, and protects your information when you visit racinecarreecalculator.com (the "Site"). By using the Site, you agree to the practices described below.</p>

                <h2 class="article-h2">1. Information We Collect</h2>
                <h3 class="article-h3">Information You Provide Voluntarily</h3>
                <p>If you contact us via the contact form, you may provide your name, email address, and message content. We use this information solely to respond to your inquiry.</p>
                <h3 class="article-h3">Information Collected Automatically</h3>
                <p>When you visit the Site, we may automatically collect:</p>
                <ul style="margin-bottom: 24px; padding-left: 24px; color: var(--text-secondary);">
                    <li>IP address (anonymized where possible)</li>
                    <li>Browser type and version</li>
                    <li>Device type and operating system</li>
                    <li>Pages visited and time spent on each page</li>
                    <li>Referring URL</li>
                </ul>

                <h2 class="article-h2">2. Cookies and Tracking Technologies</h2>
                <p>The Site uses cookies to:</p>
                <ul style="margin-bottom: 24px; padding-left: 24px; color: var(--text-secondary);">
                    <li>Remember your theme preference (light/dark mode)</li>
                    <li>Analyze site traffic through third-party analytics tools</li>
                </ul>
                <p>You can disable cookies in your browser settings, but some features of the Site may not function as intended.</p>

                <h2 class="article-h2">3. Third-Party Services</h2>
                <p>We may use third-party services, such as Google Analytics, to understand how users interact with the Site. These services may collect information sent by your browser as part of a web page request, including cookies and your IP address. Their use of this information is governed by their own privacy policies.</p>

                <h2 class="article-h2">4. How We Use Your Information</h2>
                <p>We use the information we collect to:</p>
                <ul style="margin-bottom: 24px; padding-left: 24px; color: var(--text-secondary);">
                    <li>Operate and maintain the Site</li>
                    <li>Respond to your inquiries</li>
                    <li>Understand how the Site is used so we can improve it</li>
                    <li>Detect and prevent abuse or security issues</li>
                </ul>
                <p>We do not sell, rent, or trade your personal information to any third party.</p>

                <h2 class="article-h2">5. Children's Privacy</h2>
                <p>This Site is not directed at children under the age of 13, and we do not knowingly collect personal information from children. If we learn that we have inadvertently collected information from a child under 13, we will promptly delete it.</p>

                <h2 class="article-h2">6. Your Rights</h2>
                <p>Depending on your location, you may have rights regarding your personal information, including the right to access, correct, delete, or restrict processing of your data. To exercise any of these rights, please contact us at <a href="mailto:contact@racinecarreecalculator.com" style="color: var(--primary-500); font-weight: 600;">contact@racinecarreecalculator.com</a>.</p>

                <h2 class="article-h2">7. Data Security</h2>
                <p>We take reasonable measures to protect the information we collect, but no method of transmission over the internet is 100% secure. We cannot guarantee absolute security.</p>

                <h2 class="article-h2">8. Changes to This Policy</h2>
                <p>We may update this Privacy Policy from time to time. Any changes will be posted on this page with an updated "Last Updated" date. Your continued use of the Site after changes are posted constitutes your acceptance of the revised policy.</p>

                <h2 class="article-h2">9. Contact Us</h2>
                <p>If you have any questions or concerns about this Privacy Policy, please contact us at <a href="mailto:contact@racinecarreecalculator.com" style="color: var(--primary-500); font-weight: 600;">contact@racinecarreecalculator.com</a> or through our <a href="/contact-us/" style="color: var(--primary-500); font-weight: 600;">Contact Page</a>.</p>
            </div>
        </section>
    </div>
</BaseLayout>
