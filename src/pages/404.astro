---
import BaseLayout from "theme/layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found">
  <section class="mx-auto max-w-7xl px-4 py-24 text-center">
    <h1 class="text-4xl font-bold">404</h1>
    <p class="mt-4 text-gray-600">Page not found.</p>
    <a href="/" class="mt-6 inline-block text-sm text-blue-600 underline">Go home</a>
  </section>
</BaseLayout>
