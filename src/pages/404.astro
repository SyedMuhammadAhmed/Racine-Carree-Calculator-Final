---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import { useTranslations } from '../../theme/i18n/translations';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../config/site.json';

const lang = 'en';
const t = await useTranslations(lang);
const title = "Page Not Found";
const description = "The page you are looking for does not exist on Racine Carrée Calculator. Return to our free square root calculator homepage.";
const canonicalUrl = `${site.siteUrl}/404/`;
---

<BaseLayout 
    title={`${title} | ${site.siteName}`}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
    robots="noindex, nofollow"
>
    <div class="min-h-[60vh] pt-28 flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 text-center">
        <Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: '404 Error' }]} />
        <p class="text-sm font-semibold text-blue-600 uppercase tracking-wide">404 Error</p>
        <h1 class="mt-2 text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">Page not found</h1>
        <p class="mt-4 text-base text-gray-500 max-w-lg mx-auto">
            Sorry, we couldn't find the page you're looking for. It might have been moved or doesn't exist.
        </p>
        <div class="mt-8">
            <a href="/" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                Back to Home
            </a>
        </div>
    </div>
</BaseLayout>
