---
import BaseLayout from '../../theme/layouts/BaseLayout.astro';
import { useTranslations } from '../../theme/i18n/translations';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../config/site.json';

const lang = 'en';
const t = await useTranslations(lang);
const title = "Page Not Found";
const description = "The page you are looking for does not exist on Racine Carrée Calculator. Return to our free square root calculator homepage.";
const canonicalUrl = `${site.siteUrl}/404/`;
---

<BaseLayout 
    title={`${title} | ${site.siteName}`}
    description={description}
    locale={lang}
    canonicalUrl={canonicalUrl}
    robots="noindex, nofollow"
>
    <div class="article-container" style="min-h: 60vh; padding: 48px 16px 80px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
        <Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: '404 Error' }]} />
        <div style="margin-top: 32px; background: var(--bg-surface-elevated); border: 1px solid var(--border-default); border-radius: var(--radius-2xl); padding: 48px 32px; max-width: 580px; width: 100%; box-shadow: var(--shadow-lg);">
            <div style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 14px; background: rgba(124, 58, 237, 0.12); border: 1px solid rgba(124, 58, 237, 0.25); border-radius: 9999px; font-size: 0.85rem; font-weight: 700; color: var(--primary-500); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 16px;">
                404 Error
            </div>
            <h1 style="font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 900; background: var(--gradient-hero); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 16px; line-height: 1.2;">
                Page Not Found
            </h1>
            <p style="font-size: 1.05rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 24px;">
                Sorry, the page or calculation tool you are looking for does not exist or may have been moved. Try one of our calculators below:
            </p>
            <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px; text-align: left;">
                <a href="/" style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: var(--bg-surface); border: 1px solid var(--border-default); border-radius: var(--radius-md); text-decoration: none; color: var(--text-primary); font-weight: 600; transition: border-color 0.2s, background-color 0.2s;">
                    <span>√ Racine Carrée (Square Root) Calculator</span>
                    <span style="color: var(--primary-500); font-weight: 700;">→</span>
                </a>
                <a href="/racine-cubique-calculator/" style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: var(--bg-surface); border: 1px solid var(--border-default); border-radius: var(--radius-md); text-decoration: none; color: var(--text-primary); font-weight: 600; transition: border-color 0.2s, background-color 0.2s;">
                    <span>∛ Racine Cubique (Cube Root) Calculator</span>
                    <span style="color: var(--primary-500); font-weight: 700;">→</span>
                </a>
                <a href="/nth-root-calculator/" style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: var(--bg-surface); border: 1px solid var(--border-default); border-radius: var(--radius-md); text-decoration: none; color: var(--text-primary); font-weight: 600; transition: border-color 0.2s, background-color 0.2s;">
                    <span>ⁿ√ Nth Root Calculator &amp; Exponents</span>
                    <span style="color: var(--primary-500); font-weight: 700;">→</span>
                </a>
            </div>
            <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                <a href="/" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; background: var(--gradient-hero); color: #ffffff; font-weight: 700; font-size: 0.95rem; border-radius: var(--radius-lg); text-decoration: none; box-shadow: var(--shadow-glow);">
                    <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Homepage
                </a>
                <a href="/sitemap/" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; background: var(--bg-surface); border: 1px solid var(--border-default); color: var(--text-primary); font-weight: 600; font-size: 0.95rem; border-radius: var(--radius-lg); text-decoration: none;">
                    HTML Sitemap
                </a>
            </div>
        </div>
    </div>
</BaseLayout>
