---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ChartGenerator from '../components/ChartGenerator.astro';
import ChartGeneratorContent from '../components/ChartGeneratorContent.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getHtmlDir } from '../../theme/i18n/utils';
import site from '../config/site.json';
import { getPageAlternateLinks } from '../utils/seo';

import { getChartContent } from '../data/i18n/content/chartContent';

const lang = 'en';
const title = 'Square Root Chart Generator – Build a Custom Square Root Table';
const description = 'Generate a custom square root chart for any number range instantly. Choose your decimal precision, view perfect squares only, and print or copy the result — free.';
const canonicalUrl = `${site.siteUrl}/square-root-chart/`;
const alternateLinks = getPageAlternateLinks('/square-root-chart/');

const chartContent = getChartContent(lang);
const chartFaqs = chartContent.faqs;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  dir={getHtmlDir(lang)}
  canonicalUrl={canonicalUrl}
  alternateLinks={alternateLinks}
  faqItems={chartFaqs}
>
  <Navbar lang={lang} />
  <main id="main-content">
    <section class="above-fold" id="hero">
      <div class="above-fold-stack">
        <Breadcrumbs items={[{ label: 'Home', url: '/' }, { label: 'Square Root Chart Generator', url: '/square-root-chart/' }]} />
        <header class="hero-compact hero-compact--centered">
          <h1 class="hero-title">
            <span class="title-line">Square Root Chart</span>
            <span class="title-line gradient-text">Generator</span>
          </h1>
          <p class="hero-subtitle">Generate a custom square root chart for any number range instantly. Choose your decimal precision, view perfect squares only, and print or copy the result — free.</p>
          <div class="hero-pills">
            <span class="hero-pill">
              <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              {chartContent.heroPills[0]}
            </span>
            <span class="hero-pill">
              <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
              {chartContent.heroPills[1]}
            </span>
            <span class="hero-pill">
              <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M9 12l2 2 4-4"/></svg>
              {chartContent.heroPills[2]}
            </span>
            <span class="hero-pill">
              <svg width="14" height="14" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              {chartContent.heroPills[3]}
            </span>
          </div>
        </header>

        <!-- Chart Generator Stage -->
        <section class="calc-stage" id="calculators" aria-label="Square Root Chart Generator">
          <div class="calc-stage-glow" aria-hidden="true"></div>
          <div class="calc-suite" id="calcSuite">
            <ChartGenerator lang={lang} />
          </div>
        </section>
      </div>
    </section>

    <!-- Rich Educational Content & FAQs -->
    <ChartGeneratorContent lang={lang} faqs={chartFaqs} />
  </main>
  <Footer lang={lang} />
</Layout>
