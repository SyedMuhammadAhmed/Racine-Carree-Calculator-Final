---
import { useTranslations } from '../../theme/i18n/translations';
import { getChartWidgetI18n } from '../data/i18n/widgetI18n';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = await useTranslations(lang);
const chartWidgetI18n = getChartWidgetI18n(lang);
---

<div class="calc-panel active" id="panelChartGenerator" data-calc="chart-generator" data-i18n={JSON.stringify(chartWidgetI18n)}>
  <article class="calc-widget chart-generator-widget">
    <header class="calc-widget-head">
      <span class="calc-widget-symbol" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10"/>
          <line x1="12" y1="20" x2="12" y2="4"/>
          <line x1="6" y1="20" x2="6" y2="14"/>
        </svg>
      </span>
      <div class="calc-widget-head-text">
        <h2 class="calc-widget-title">{t('chart.calc.title', 'Square Root Chart & Table Generator')}</h2>
        <p class="calc-widget-desc">{t('chart.calc.desc', 'Generate custom reference tables with exact roots, simplified radicals, and custom ranges')}</p>
      </div>
    </header>

    <div class="calc-widget-flow">
      <!-- ── Preset Ranges ── -->
      <div class="chart-presets-wrap">
        <span class="chart-presets-label">{t('chart.calc.quickPresets', 'Quick Presets:')}</span>
        <div class="chart-presets-chips" role="group" aria-label="Preset chart ranges">
          <button type="button" class="preset-chip active" data-start="1" data-end="25" data-step="1">1 – 25</button>
          <button type="button" class="preset-chip" data-start="1" data-end="50" data-step="1">1 – 50</button>
          <button type="button" class="preset-chip" data-start="1" data-end="100" data-step="1">1 – 100</button>
          <button type="button" class="preset-chip" data-start="101" data-end="200" data-step="1">101 – 200</button>
          <button type="button" class="preset-chip" data-start="1" data-end="1000" data-step="1" data-filter="perfect">{chartWidgetI18n.presetPerfectSquares}</button>
          <button type="button" class="preset-chip" data-start="0" data-end="5" data-step="0.25">{chartWidgetI18n.presetDecimals}</button>
        </div>
      </div>

      <!-- ── Range & Generation Inputs ── -->
      <section class="calc-step chart-controls-step" aria-label="Range configuration controls">
        <div class="chart-controls-grid">
          <div class="input-group">
            <div class="calc-tooltip">
              <label class="input-label" for="rangeStart">{t('chart.calc.startRange', 'Start Number (From)')}</label>
              <span class="calc-tooltip-icon" role="button" tabindex="0" aria-label="Start number instructions" aria-describedby="rangeStart-tooltip">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="tooltip-text" id="rangeStart-tooltip" role="tooltip">{chartWidgetI18n.startTooltip}</span>
              </span>
            </div>
            <div class="input-wrapper">
              <input type="number" inputmode="decimal" id="rangeStart" class="calc-input" value="1" min="0" max="10000" step="any" placeholder="1" aria-label="Start number">
            </div>
          </div>

          <div class="input-group">
            <div class="calc-tooltip">
              <label class="input-label" for="rangeEnd">{t('chart.calc.endRange', 'End Number (To)')}</label>
              <span class="calc-tooltip-icon" role="button" tabindex="0" aria-label="End number instructions" aria-describedby="rangeEnd-tooltip">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="tooltip-text" id="rangeEnd-tooltip" role="tooltip">{chartWidgetI18n.endTooltip}</span>
              </span>
            </div>
            <div class="input-wrapper">
              <input type="number" inputmode="decimal" id="rangeEnd" class="calc-input" value="25" min="1" max="10000" step="any" placeholder="25" aria-label="End number">
            </div>
          </div>

          <div class="input-group">
            <div class="calc-tooltip">
              <label class="input-label" for="rangeStep">{chartWidgetI18n.stepLabel}</label>
              <span class="calc-tooltip-icon" role="button" tabindex="0" aria-label="Step instructions" aria-describedby="rangeStep-tooltip">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="tooltip-text" id="rangeStep-tooltip" role="tooltip">{chartWidgetI18n.stepTooltip}</span>
              </span>
            </div>
            <div class="input-wrapper">
              <input type="number" inputmode="decimal" id="rangeStep" class="calc-input" value="1" min="0.001" max="500" step="any" placeholder="1" aria-label="Step increment">
            </div>
          </div>

          <div class="input-group">
            <div class="calc-tooltip">
              <label class="input-label" for="rangePrecision">{chartWidgetI18n.precisionLabel}</label>
              <span class="calc-tooltip-icon" role="button" tabindex="0" aria-label="Precision instructions" aria-describedby="rangePrecision-tooltip">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="tooltip-text" id="rangePrecision-tooltip" role="tooltip">{chartWidgetI18n.precisionTooltip}</span>
              </span>
            </div>
            <div class="input-wrapper select-wrapper">
              <select id="rangePrecision" class="calc-input calc-select" aria-label={chartWidgetI18n.precisionLabel}>
                <option value="2">2 {chartWidgetI18n.decimalsWord} (0.00)</option>
                <option value="3" selected>3 {chartWidgetI18n.decimalsWord} (0.000)</option>
                <option value="4">4 {chartWidgetI18n.decimalsWord} (0.0000)</option>
                <option value="6">6 {chartWidgetI18n.decimalsWord} (0.000000)</option>
                <option value="auto">{chartWidgetI18n.autoFull}</option>
              </select>
            </div>
          </div>

          <!-- Optional Perfect Squares Only Toggle -->
          <div class="input-group chart-toggle-group" style="grid-column: 1 / -1;">
            <label class="chart-toggle-control" for="togglePerfectOnly">
              <input type="checkbox" id="togglePerfectOnly" class="chart-toggle-input" aria-label="Toggle perfect squares only">
              <span class="chart-toggle-text">
                <span class="chart-toggle-title">{chartWidgetI18n.perfectOnly}</span>
                <span class="chart-toggle-sub">{chartWidgetI18n.perfectOnlySub}</span>
              </span>
            </label>
          </div>
        </div>
      </section>

      <!-- ── Primary Action Button ── -->
      <section class="calc-step calc-step--action" aria-label="Generate action">
        <button class="btn-calc-primary" id="generateChartBtn" type="button" aria-label="Generate Square Root Table">
          <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10"/>
            <polyline points="1 20 1 14 7 14"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
          <span>{t('chart.calc.btn', 'Generate Table')}</span>
        </button>
      </section>

      <!-- ── Results Area (Hidden until user clicks Generate) ── -->
      <div class="chart-results-wrapper" id="chartResultsWrapper" style="display: none;">
        <!-- Statistics Strip -->
        <div class="chart-stats-grid" id="chartStatsGrid" aria-label="Table summary statistics">
          <div class="chart-stat-card">
            <span class="chart-stat-icon" aria-hidden="true">🔢</span>
            <div class="chart-stat-info">
              <span class="chart-stat-value" id="statTotalCount">0</span>
              <span class="chart-stat-label">{chartWidgetI18n.statTotal}</span>
            </div>
          </div>
          <div class="chart-stat-card">
            <span class="chart-stat-icon" aria-hidden="true">✨</span>
            <div class="chart-stat-info">
              <span class="chart-stat-value" id="statPerfectCount">0</span>
              <span class="chart-stat-label">{chartWidgetI18n.statSquares}</span>
            </div>
          </div>
          <div class="chart-stat-card">
            <span class="chart-stat-icon" aria-hidden="true">≈</span>
            <div class="chart-stat-info">
              <span class="chart-stat-value" id="statIrrationalCount">0</span>
              <span class="chart-stat-label">{chartWidgetI18n.badgeIrrational}</span>
            </div>
          </div>
          <div class="chart-stat-card">
            <span class="chart-stat-icon" aria-hidden="true">📏</span>
            <div class="chart-stat-info">
              <span class="chart-stat-value" id="statRangeSpan">—</span>
              <span class="chart-stat-label">{chartWidgetI18n.statRange}</span>
            </div>
          </div>
        </div>

        <!-- Table Toolbar (Filter, Search, Export) -->
        <div class="chart-toolbar">
          <div class="chart-filter-pills" role="tablist" aria-label="Filter rows">
            <button type="button" class="filter-pill active" data-filter="all" role="tab" aria-selected="true">
              {t('chart.calc.filterAll', 'All')} (<span id="filterAllCount">0</span>)
            </button>
            <button type="button" class="filter-pill" data-filter="perfect" role="tab" aria-selected="false">
              {chartWidgetI18n.statSquares} (<span id="filterPerfectCount">0</span>)
            </button>
            <button type="button" class="filter-pill" data-filter="irrational" role="tab" aria-selected="false">
              {chartWidgetI18n.badgeIrrational} (<span id="filterIrrationalCount">0</span>)
            </button>
          </div>

          <div class="chart-toolbar-actions">
            <div class="chart-search-wrap">
              <svg class="chart-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <input type="text" id="chartSearchInput" class="chart-search-input" placeholder={chartWidgetI18n.searchPlaceholder} aria-label="Search within table">
            </div>

            <div class="chart-export-btns">
              <button type="button" class="btn-chart-action" id="copyCsvBtn" title="Copy table as CSV (spreadsheet format)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>{chartWidgetI18n.btnCopy}</span>
              </button>
              <button type="button" class="btn-chart-action" id="printChartBtn" title="Print or save as PDF">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                <span>{chartWidgetI18n.btnPrint}</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Generated Table Output -->
        <section class="calc-step calc-step--results chart-table-step" aria-label="Generated table results">
          <div class="table-scroll-wrapper table-scroll-wrapper--large chart-table-container" id="chartTableContainer">
            <div class="table-scroll-hint">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M18 13l-6 6-6-6"/></svg>
              <span id="chartScrollHintText">{chartWidgetI18n.scrollHintDefault}</span>
            </div>
            <table class="data-table data-table--reference data-table--vertical chart-interactive-table" id="chartGeneratedTable">
              <thead>
                <tr>
                  <th scope="col">{chartWidgetI18n.colNumber}</th>
                  <th scope="col">{t('chart.table.colRoot', 'Square Root (√n)')}</th>
                  <th scope="col">{chartWidgetI18n.colExact}</th>
                  <th scope="col">{chartWidgetI18n.colDecimal}</th>
                  <th scope="col">{chartWidgetI18n.colType}</th>
                </tr>
              </thead>
              <tbody id="chartTableBody">
                <!-- Dynamically populated rows -->
              </tbody>
            </table>
            <div class="chart-empty-state" id="chartEmptyState" style="display: none;">
              <p>{chartWidgetI18n.emptyState}</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </article>
</div>

<style>
  /* ── Chart Generator Widget Custom Styles ── */
  .chart-generator-widget {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Input overrides for clean alignment without overlap */
  .chart-generator-widget .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .chart-generator-widget .calc-input {
    width: 100%;
    padding: 12px 14px !important;
    background: var(--bg-input);
    border: 1.5px solid var(--border-default);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    text-align: left;
    outline: none;
    box-sizing: border-box;
  }

  .chart-generator-widget .calc-input:focus {
    border-color: var(--primary-400);
    background: var(--bg-input-focus);
    box-shadow: var(--shadow-input-focus);
  }

  .chart-generator-widget .calc-select {
    padding: 12px 34px 12px 14px !important;
    font-size: 0.88rem;
    font-family: var(--font-sans);
    cursor: pointer;
    background-color: var(--bg-input);
    appearance: none;
    -webkit-appearance: none;
    text-overflow: ellipsis;
  }

  .select-wrapper {
    position: relative;
    width: 100%;
  }

  .select-wrapper::after {
    content: "▾";
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Presets */
  .chart-presets-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 16px;
    background: var(--bg-hover-subtle);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    margin-bottom: 20px;
  }

  .chart-presets-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .chart-presets-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .preset-chip {
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .preset-chip:hover {
    border-color: var(--primary-300);
    color: var(--primary-600);
    transform: translateY(-1px);
  }

  .preset-chip.active {
    background: var(--gradient-primary);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
  }

  /* Controls Grid */
  .chart-controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
    align-items: end;
  }

  .chart-toggle-group {
    display: flex;
    flex-direction: column;
  }

  .chart-toggle-control {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 6px 16px;
    background: var(--bg-hover-subtle);
    border: 1.5px solid var(--border-default);
    border-radius: var(--radius-md);
    cursor: pointer;
    user-select: none;
    box-sizing: border-box;
    transition: all var(--duration-fast);
    width: fit-content;
  }

  .chart-toggle-control:hover {
    border-color: var(--primary-400);
    background: var(--bg-surface);
  }

  .chart-toggle-input {
    appearance: none;
    -webkit-appearance: none;
    width: 36px;
    height: 20px;
    background: var(--border-default);
    border-radius: var(--radius-full);
    position: relative;
    cursor: pointer;
    outline: none;
    transition: background var(--duration-fast);
    flex-shrink: 0;
    margin: 0;
  }

  .chart-toggle-input:checked {
    background: var(--primary-500);
  }

  .chart-toggle-input::before {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    background: #ffffff;
    border-radius: 50%;
    transition: transform var(--duration-fast);
    box-shadow: var(--shadow-xs);
  }

  .chart-toggle-input:checked::before {
    transform: translateX(16px);
  }

  .chart-toggle-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .chart-toggle-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .chart-toggle-sub {
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .chart-controls-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Stats Grid */
  .chart-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 16px 0 20px;
  }

  @media (max-width: 720px) {
    .chart-stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .chart-stat-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--bg-stat-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    backdrop-filter: blur(8px);
  }

  .chart-stat-icon {
    font-size: 1.3rem;
    line-height: 1;
  }

  .chart-stat-info {
    display: flex;
    flex-direction: column;
  }

  .chart-stat-value {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .chart-stat-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  /* Toolbar */
  .chart-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .chart-filter-pills {
    display: flex;
    gap: 6px;
    background: var(--bg-hover-subtle);
    padding: 4px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
  }

  .filter-pill {
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    background: transparent;
    border: none;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .filter-pill:hover {
    color: var(--primary-600);
  }

  .filter-pill.active {
    background: var(--bg-surface);
    color: var(--primary-600);
    box-shadow: var(--shadow-xs);
  }

  [data-theme="dark"] .filter-pill.active {
    color: var(--primary-300);
    background: var(--neutral-100);
  }

  .chart-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .chart-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .chart-search-icon {
    position: absolute;
    left: 10px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .chart-search-input {
    padding: 6px 12px 6px 32px;
    font-size: 0.8rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    background: var(--bg-surface);
    color: var(--text-primary);
    outline: none;
    width: 180px;
    transition: all var(--duration-fast);
  }

  .chart-search-input:focus {
    border-color: var(--primary-400);
    box-shadow: var(--shadow-input-focus);
    width: 210px;
  }

  .chart-export-btns {
    display: flex;
    gap: 6px;
  }

  .btn-chart-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .btn-chart-action:hover {
    background: var(--bg-hover-subtle);
    border-color: var(--primary-400);
    color: var(--primary-600);
  }

  [data-theme="dark"] .btn-chart-action:hover {
    color: var(--primary-300);
  }

  /* Table styling */
  .chart-table-container {
    max-height: 520px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
  }

  .chart-interactive-table th {
    white-space: nowrap;
  }

  .chart-interactive-table td {
    padding: 10px 18px;
    vertical-align: middle;
  }

  .td-radical {
    font-family: var(--font-mono);
    color: var(--primary-600);
    font-weight: 600;
  }

  [data-theme="dark"] .td-radical {
    color: var(--primary-300);
  }

  .td-squared {
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .badge-irrational {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    background: var(--neutral-100);
    color: var(--text-muted);
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 600;
  }

  [data-theme="dark"] .badge-irrational {
    background: var(--neutral-150);
  }

  .chart-empty-state {
    padding: 36px 20px;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  /* Print Styles */
  @media print {
    body * {
      visibility: hidden;
    }
    #chartTableContainer, #chartTableContainer * {
      visibility: visible;
    }
    #chartTableContainer {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      max-height: none !important;
      overflow: visible !important;
      box-shadow: none;
      border: none;
    }
    .table-scroll-hint {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function initChartGenerator() {
    // Prime factorize helper for radical simplification (e.g. sqrt(18) = 3√2)
    function primeFactorize(n) {
      n = Math.round(Math.abs(n));
      if (n <= 1) return [];
      if (n > 1e10) return null;
      const factors = [];
      let d = 2;
      while (d * d <= n) {
        while (n % d === 0) {
          factors.push(d);
          n /= d;
        }
        d++;
      }
      if (n > 1) factors.push(n);
      return factors;
    }

    function getSimplifiedRadical(val) {
      if (!Number.isFinite(val) || val <= 1) return '—';
      if (!Number.isInteger(val) || val > 1e10) return '—';
      const root = Math.sqrt(val);
      if (Number.isInteger(root)) return '—'; // Perfect square, no radical

      const factors = primeFactorize(val);
      if (!factors || !factors.length) return '—';

      const counts = {};
      factors.forEach(f => { counts[f] = (counts[f] || 0) + 1; });

      let outside = 1;
      let inside = 1;

      Object.keys(counts).map(Number).forEach(prime => {
        const count = counts[prime];
        const groups = Math.floor(count / 2);
        const rem = count % 2;
        if (groups > 0) outside *= Math.pow(prime, groups);
        if (rem > 0) inside *= prime;
      });

      if (outside > 1 && inside > 1) {
        return outside + '√' + inside;
      } else if (outside > 1 && inside === 1) {
        return '' + outside;
      }
      return '√' + val;
    }

    function formatNumber(num) {
      if (Number.isInteger(num)) return num.toLocaleString('en-US');
      return Number(num.toFixed(6)).toString();
    }

    function formatRoot(val, precision) {
      const root = Math.sqrt(val);
      if (Number.isInteger(root)) {
        return root.toFixed(precision === 'auto' ? 0 : Math.min(Number(precision), 3));
      }
      if (precision === 'auto') {
        return Number(root.toPrecision(10)).toString();
      }
      return root.toFixed(Number(precision));
    }

    // Generator State
    let currentRows = [];
    let currentFilter = 'all'; // 'all' | 'perfect' | 'irrational'
    let currentSearch = '';
    let hasGenerated = false;

    function generateChart() {
      const startInput = document.getElementById('rangeStart');
      const endInput = document.getElementById('rangeEnd');
      const stepInput = document.getElementById('rangeStep');
      const precInput = document.getElementById('rangePrecision');
      const tableBody = document.getElementById('chartTableBody');
      const emptyState = document.getElementById('chartEmptyState');
      const scrollHint = document.getElementById('chartScrollHintText');
      const resultsWrap = document.getElementById('chartResultsWrapper');

      if (!startInput || !endInput || !stepInput || !tableBody) return;

      let start = parseFloat(startInput.value);
      let end = parseFloat(endInput.value);
      let step = parseFloat(stepInput.value);
      const precision = precInput ? precInput.value : '3';

      if (!Number.isFinite(start) || start < 0) start = 1;
      if (!Number.isFinite(end) || end < start) end = start + 24;
      if (!Number.isFinite(step) || step <= 0) step = 1;

      // Limit max rows to 1,000 for safety and performance
      const totalSteps = Math.floor((end - start) / step) + 1;
      if (totalSteps > 1000) {
        alert('Range exceeds 1,000 items. Adjusting end number to maintain optimal performance.');
        end = start + step * 999;
        endInput.value = end;
      }

      currentRows = [];
      let perfectCount = 0;
      let irrationalCount = 0;

      for (let n = start; n <= end + 1e-9; n += step) {
        // Handle floating point step rounding (e.g. 0.1 + 0.2)
        const cleanN = Math.round(n * 100000) / 100000;
        const root = Math.sqrt(cleanN);
        const isPerfect = Number.isInteger(root);
        if (isPerfect) perfectCount++; else irrationalCount++;

        const rootStr = formatRoot(cleanN, precision);
        const panel = document.getElementById('panelChartGenerator');
        const i18n = panel && panel.dataset.i18n ? JSON.parse(panel.dataset.i18n) : {};
        const radicalStr = isPerfect ? (i18n.badgeInteger || 'Exact Integer') : getSimplifiedRadical(cleanN);
        const squaredVal = formatNumber(cleanN * cleanN);

        currentRows.push({
          num: cleanN,
          numStr: formatNumber(cleanN),
          rootStr: rootStr,
          radicalStr: radicalStr,
          squaredStr: squaredVal,
          isPerfect: isPerfect
        });
      }

      // Show results
      hasGenerated = true;
      if (resultsWrap) resultsWrap.style.display = 'block';

      // Update Stat Cards
      const statTotal = document.getElementById('statTotalCount');
      const statPerf = document.getElementById('statPerfectCount');
      const statIrr = document.getElementById('statIrrationalCount');
      const statSpan = document.getElementById('statRangeSpan');

      if (statTotal) statTotal.textContent = currentRows.length;
      if (statPerf) statPerf.textContent = perfectCount;
      if (statIrr) statIrr.textContent = irrationalCount;
      if (statSpan) statSpan.textContent = formatNumber(start) + ' → ' + formatNumber(end);

      // Update Filter Pill counts
      const fAll = document.getElementById('filterAllCount');
      const fPerf = document.getElementById('filterPerfectCount');
      const fIrr = document.getElementById('filterIrrationalCount');
      if (fAll) fAll.textContent = currentRows.length;
      if (fPerf) fPerf.textContent = perfectCount;
      if (fIrr) fIrr.textContent = irrationalCount;

      const togglePerf = document.getElementById('togglePerfectOnly');
      if (togglePerf && togglePerf.checked) {
        currentFilter = 'perfect';
        document.querySelectorAll('.filter-pill').forEach(p => {
          p.classList.toggle('active', p.dataset.filter === 'perfect');
        });
      }

      renderRows();
    }

    function renderRows() {
      const tableBody = document.getElementById('chartTableBody');
      const emptyState = document.getElementById('chartEmptyState');
      const scrollHint = document.getElementById('chartScrollHintText');
      if (!tableBody) return;

      const panel = document.getElementById('panelChartGenerator');
      const i18n = panel && panel.dataset.i18n ? JSON.parse(panel.dataset.i18n) : {};
      const badgeInt = i18n.badgeInteger || 'Perfect Square';
      const badgeIrr = i18n.badgeIrrational || 'Irrational';

      const filtered = currentRows.filter(row => {
        if (currentFilter === 'perfect' && !row.isPerfect) return false;
        if (currentFilter === 'irrational' && row.isPerfect) return false;
        if (currentSearch) {
          const s = currentSearch.toLowerCase();
          const matchNum = row.numStr.toLowerCase().includes(s);
          const matchRoot = row.rootStr.toLowerCase().includes(s);
          const matchRad = row.radicalStr.toLowerCase().includes(s);
          if (!matchNum && !matchRoot && !matchRad) return false;
        }
        return true;
      });

      if (filtered.length === 0) {
        tableBody.innerHTML = '';
        if (emptyState) emptyState.style.display = 'block';
        if (scrollHint) scrollHint.textContent = i18n.scrollHintZero || '0 items found matching filter';
        return;
      }

      if (emptyState) emptyState.style.display = 'none';
      if (scrollHint) scrollHint.textContent = (i18n.scrollHintCount || 'Showing {filtered} of {total} values • Scroll to browse table ↓').replace('{filtered}', filtered.length).replace('{total}', currentRows.length);

      tableBody.innerHTML = filtered.map(row => `
        <tr class="${row.isPerfect ? 'tr-perfect' : ''}">
          <td class="${row.isPerfect ? 'td-bold' : ''}">${row.numStr}</td>
          <td class="${row.isPerfect ? 'td-bold' : ''}">${row.rootStr}</td>
          <td class="td-radical">${row.radicalStr}</td>
          <td class="td-squared">${row.squaredStr}</td>
          <td>
            ${row.isPerfect
              ? `<span class="badge-perfect"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> ${badgeInt}</span>`
              : `<span class="badge-irrational">${badgeIrr}</span>`
            }
          </td>
        </tr>
      `).join('');
    }

    // Set up Presets
    document.querySelectorAll('.preset-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.preset-chip').forEach(c => c.classList.remove('active'));
        chip.classList.add('active');

        const start = chip.dataset.start;
        const end = chip.dataset.end;
        const step = chip.dataset.step;
        const filter = chip.dataset.filter;

        if (start) document.getElementById('rangeStart').value = start;
        if (end) document.getElementById('rangeEnd').value = end;
        if (step) document.getElementById('rangeStep').value = step;

        if (filter === 'perfect') {
          currentFilter = 'perfect';
          document.querySelectorAll('.filter-pill').forEach(p => {
            p.classList.toggle('active', p.dataset.filter === 'perfect');
          });
          const togglePerf = document.getElementById('togglePerfectOnly');
          if (togglePerf) togglePerf.checked = true;
        } else {
          currentFilter = 'all';
          document.querySelectorAll('.filter-pill').forEach(p => {
            p.classList.toggle('active', p.dataset.filter === 'all');
          });
          const togglePerf = document.getElementById('togglePerfectOnly');
          if (togglePerf) togglePerf.checked = false;
        }

        // If user already clicked generate previously, auto-update the table; otherwise just set inputs
        if (hasGenerated) {
          generateChart();
        }
      });
    });

    // Set up Filter Pills
    document.querySelectorAll('.filter-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentFilter = pill.dataset.filter || 'all';
        const togglePerf = document.getElementById('togglePerfectOnly');
        if (togglePerf) togglePerf.checked = (currentFilter === 'perfect');
        renderRows();
      });
    });

    // Set up Toggle Perfect Squares Only Checkbox
    const togglePerfControl = document.getElementById('togglePerfectOnly');
    if (togglePerfControl) {
      togglePerfControl.addEventListener('change', () => {
        currentFilter = togglePerfControl.checked ? 'perfect' : 'all';
        document.querySelectorAll('.filter-pill').forEach(p => {
          const isMatch = p.dataset.filter === currentFilter;
          p.classList.toggle('active', isMatch);
          p.setAttribute('aria-selected', isMatch);
        });
        if (hasGenerated) {
          renderRows();
        }
      });
    }

    // Live search input
    const searchInput = document.getElementById('chartSearchInput');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value.trim();
        renderRows();
      });
    }

    // Generate Button Click (The ONLY action that triggers the initial generation)
    const genBtn = document.getElementById('generateChartBtn');
    if (genBtn) {
      genBtn.addEventListener('click', () => {
        genBtn.classList.add('is-calculating');
        setTimeout(() => genBtn.classList.remove('is-calculating'), 500);
        generateChart();
      });
    }

    // Copy CSV Action
    const copyCsvBtn = document.getElementById('copyCsvBtn');
    if (copyCsvBtn) {
      copyCsvBtn.addEventListener('click', () => {
        if (!currentRows || !currentRows.length) return;
        const panel = document.getElementById('panelChartGenerator');
        const i18n = panel && panel.dataset.i18n ? JSON.parse(panel.dataset.i18n) : {};
        const headers = [
          i18n.csvHeaderNumber || 'Number (n)',
          i18n.csvHeaderRoot || 'Square Root (√n)',
          i18n.csvHeaderRadical || 'Simplified Radical',
          i18n.csvHeaderSquared || 'Squared (n²)',
          i18n.csvHeaderType || 'Type'
        ];
        const csvLines = [headers.join(',')];
        currentRows.forEach(r => {
          const typeStr = r.isPerfect ? (i18n.csvTypePerfect || 'Perfect Square') : (i18n.csvTypeIrrational || 'Irrational');
          csvLines.push('"' + r.numStr + '","' + r.rootStr + '","' + r.radicalStr + '","' + r.squaredStr + '","' + typeStr + '"');
        });
        const csvContent = csvLines.join('\n');
        navigator.clipboard.writeText(csvContent).then(() => {
          const span = copyCsvBtn.querySelector('span');
          if (span) {
            const orig = span.textContent;
            span.textContent = i18n.copiedCsv || 'Copied CSV!';
            setTimeout(() => { span.textContent = orig; }, 2000);
          }
        }).catch(() => {});
      });
    }

    // Print Action
    const printBtn = document.getElementById('printChartBtn');
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }

    // Enter Key Trigger
    ['rangeStart', 'rangeEnd', 'rangeStep'].forEach(id => {
      document.getElementById(id)?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') generateChart();
      });
    });
  })();
</script>
