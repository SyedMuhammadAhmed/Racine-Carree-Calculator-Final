---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getCubeContent } from '../data/i18n/content/cubeContent';
import { getAuthorByline } from '../data/i18n/commonI18n';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}
const { lang = 'en', faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getCubeContent(lang);
const cubeToc = content.toc;
const effectiveFaqs = (faqs && faqs.length > 0) ? faqs : content.faqs;
const authorByline = getAuthorByline(lang);

// Format numbers according to locale (commas for French/German, dots for English/others)
const isCommaLocale = lang === 'fr' || lang === 'de';
const formatNum = (val: number, decimals: number = 3) => {
  const str = val.toFixed(decimals);
  return isCommaLocale ? str.replace('.', ',') : str;
};

// The 10 perfect cubes from 1 to 1000
const first10Cubes = [
  { k: 1, formula: "1 × 1 × 1", cube: 1, factors: "1", root: "1" },
  { k: 2, formula: "2 × 2 × 2", cube: 8, factors: "2³", root: "2" },
  { k: 3, formula: "3 × 3 × 3", cube: 27, factors: "3³", root: "3" },
  { k: 4, formula: "4 × 4 × 4", cube: 64, factors: "2⁶ = (2²)³", root: "4" },
  { k: 5, formula: "5 × 5 × 5", cube: 125, factors: "5³", root: "5" },
  { k: 6, formula: "6 × 6 × 6", cube: 216, factors: "2³ × 3³", root: "6" },
  { k: 7, formula: "7 × 7 × 7", cube: 343, factors: "7³", root: "7" },
  { k: 8, formula: "8 × 8 × 8", cube: 512, factors: "2⁹ = (2³)³", root: "8" },
  { k: 9, formula: "9 × 9 × 9", cube: 729, factors: "3⁶ = (3²)³", root: "9" },
  { k: 10, formula: "10 × 10 × 10", cube: 1000, factors: "2³ × 5³", root: "10" }
];

// The 21 perfect cubes from 1 to 10,000
const cubesUpTo10000 = Array.from({ length: 21 }, (_, i) => {
  const k = i + 1;
  return { k, cube: k * k * k };
});

// Nearest cube bounding interval examples
const nearestCubeExamples = [
  { target: 50, root: formatNum(3.684031, 3), lowerK: 3, lowerCube: 27, upperK: 4, upperCube: 64, nearest: 64, diff: "64 - 50 = 14" },
  { target: 200, root: formatNum(5.848035, 3), lowerK: 5, lowerCube: 125, upperK: 6, upperCube: 216, nearest: 216, diff: "216 - 200 = 16" },
  { target: 500, root: formatNum(7.937005, 3), lowerK: 7, lowerCube: 343, upperK: 8, upperCube: 512, nearest: 512, diff: "512 - 500 = 12" },
  { target: 800, root: formatNum(9.283178, 3), lowerK: 9, lowerCube: 729, upperK: 10, upperCube: 1000, nearest: 729, diff: "800 - 729 = 71" }
];

// Mental math last-digit mapping
const lastDigitMapping = [
  { kDigit: 0, cubeDigit: 0, formula: "0³ = 0", pattern: "Preserved (Same digit)" },
  { kDigit: 1, cubeDigit: 1, formula: "1³ = 1", pattern: "Preserved (Same digit)" },
  { kDigit: 2, cubeDigit: 8, formula: "2³ = 8", pattern: "Complements to 10 (2 + 8 = 10)" },
  { kDigit: 3, cubeDigit: 7, formula: "3³ = 27", pattern: "Complements to 10 (3 + 7 = 10)" },
  { kDigit: 4, cubeDigit: 4, formula: "4³ = 64", pattern: "Preserved (Same digit)" },
  { kDigit: 5, cubeDigit: 5, formula: "5³ = 125", pattern: "Preserved (Same digit)" },
  { kDigit: 6, cubeDigit: 6, formula: "6³ = 216", pattern: "Preserved (Same digit)" },
  { kDigit: 7, cubeDigit: 3, formula: "7³ = 343", pattern: "Complements to 10 (7 + 3 = 10)" },
  { kDigit: 8, cubeDigit: 2, formula: "8³ = 512", pattern: "Complements to 10 (8 + 2 = 10)" },
  { kDigit: 9, cubeDigit: 9, formula: "9³ = 729", pattern: "Preserved (Same digit)" }
];

// UI localization dictionary for headings and labels
const uiDict: Record<string, Record<string, string>> = {
  en: {
    copy: "Copy",
    copied: "Copied!",
    targetNumber: "Target (N)",
    cubeRoot: "Cube Root (∛N)",
    lowerBound: "Lower Cube (k³)",
    upperBound: "Upper Cube ((k+1)³)",
    nearestCube: "Nearest Cube",
    distance: "Distance",
    codeTitle: "How to Check for Perfect Cubes in Code and Spreadsheets",
    codeLead: "Verify cube numbers automatically in Excel, Google Sheets, Python, and JavaScript:",
    excelTitle: "1. Microsoft Excel & Google Sheets",
    pythonTitle: "2. Python (Exact Integer Logic)",
    jsTitle: "3. JavaScript",
    intlTitle: "International Curriculum Standards: US, UK, Canada, Australia, Germany, and France",
    extendedTitle: "Extended List of Perfect Cubes from 1 to 10,000",
    extendedLead: "Between 1 and 10,000 inclusive, there are exactly 21 perfect cubes because 21³ = 9,261 and 22³ = 10,648.",
    imgGeometricCaption: "3D Geometric Proof: 27 unit blocks assemble into a complete 3×3×3 cube, while 50 blocks leave incomplete layers and broken voids.",
    imgBijectionCaption: "Mental Math Secret: The 1-to-1 last-digit bijection between base roots and cube endings, and how to extract 6-digit roots in seconds.",
    imgIntervalCaption: "Bounding Intervals: Locating the nearest perfect cube using the interval k³ < N < (k + 1)³.",
    imgProgressionCaption: "The First 10 Perfect Cubes (1 to 1000): Visual 3D cube growth from 1³ to 10³.",
    imgVolumeCaption: "Engineering & Science: Real-world volumetric capacity, aerodynamic drag power (P ∝ v³), and spatial octrees."
  },
  fr: {
    copy: "Copier",
    copied: "Copié !",
    targetNumber: "Nombre Cible (N)",
    cubeRoot: "Racine Cubique (∛N)",
    lowerBound: "Cube Inférieur (k³)",
    upperBound: "Cube Supérieur ((k+1)³)",
    nearestCube: "Cube le Plus Proche",
    distance: "Écart",
    codeTitle: "Comment Vérifier un Cube Parfait en Code et sur Tableur",
    codeLead: "Vérifiez automatiquement vos nombres avec Excel, Google Sheets, Python et JavaScript :",
    excelTitle: "1. Microsoft Excel & Google Sheets",
    pythonTitle: "2. Python (Logique Entière Exacte)",
    jsTitle: "3. JavaScript",
    intlTitle: "Normes Mathématiques Internationales : France, Allemagne, États-Unis, Royaume-Uni",
    extendedTitle: "Liste Complète des Cubes Parfaits de 1 à 10 000",
    extendedLead: "Entre 1 et 10 000 inclus, il existe exactement 21 cubes parfaits car 21³ = 9 261 et 22³ = 10 648.",
    imgGeometricCaption: "Démonstration Géométrique 3D : 27 cubes unitaires forment un cube parfait de 3×3×3, tandis que 50 blocs laissent des vides incomplets.",
    imgBijectionCaption: "Calcul Mental : Bijection univoque du dernier chiffre des cubes et extraction instantanée de racines cubiques à 6 chiffres.",
    imgIntervalCaption: "Intervalles d'Encadrement : Trouver le cube parfait le plus proche avec k³ < N < (k + 1)³.",
    imgProgressionCaption: "Les 10 Premiers Cubes Parfaits (1 à 1000) : Progression visuelle des volumes de 1³ à 10³.",
    imgVolumeCaption: "Sciences & Ingénierie : Applications volumétriques, traînée aérodynamique (P ∝ v³) et arbres octrees."
  }
};

const currentUi = uiDict[lang] || uiDict['en'];
---

<article class="seo-article" id="perfect-cube-guide">
  <!-- Table of Contents -->
  <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
    <TableOfContents items={cubeToc} title={content.tocTitle} isOpen={false} lang={lang} />
  </div>

  <!-- Section 1: How to Use the Calculator -->
  <section class="article-section article-section--alt" id="section-how-to-use">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </span>
        {content.s2.eyebrow}
      </div>
      <h2 class="article-h2">{content.s2.title}</h2>
      <p>{content.s2.intro}</p>

      <div class="steps-visual" style="margin-top: 24px;">
        {content.s2.steps.map((step, idx) => (
          <div class="step-card" id={`step-cube-${idx + 1}`}>
            <div class="step-number">{idx + 1}</div>
            <div class="step-content">
              <h4>{step.title}</h4>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: What Is a Perfect Cube? Definition & 3D Geometry -->
  <section class="article-section" id="section-what-is-perfect-cube">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </span>
        {content.s1.eyebrow}
      </div>
      <h2 class="article-h2">{content.s1.title}</h2>
      <p class="article-lead">{content.s1.lead}</p>
      <p>{content.s1.p1}</p>
      <p>{content.s1.p2}</p>

      <div class="examples-grid" style="margin: 20px 0 28px 0;">
        <div class="example-card">
          <span class="example-expr">3³ = 27</span>
          <span class="example-reason">∛27 = 3 (Integer Root)</span>
        </div>
        <div class="example-card">
          <span class="example-expr">5³ = 125</span>
          <span class="example-reason">∛125 = 5 (Integer Root)</span>
        </div>
        <div class="example-card">
          <span class="example-expr">(-4)³ = -64</span>
          <span class="example-reason">∛(-64) = -4 (Real Root!)</span>
        </div>
      </div>

      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s1.cards.map((card, idx) => (
          <div class="law-card">
            <div class="law-number">
              {idx === 0 && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>}
              {idx === 1 && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>}
              {idx === 2 && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
              {idx === 3 && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="3" r="1.5" fill="#fff"/><line x1="5" y1="12" x2="19" y2="12"/><circle cx="12" cy="21" r="1.5" fill="#fff"/></svg>}
            </div>
            <h3 class="law-title">{card.title}</h3>
            <p class="law-text">{card.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Section Image 1: 3D Geometric Volume Concept -->
    <figure class="section-image">
      <img src="/images/perfect-cube-geometric-concept.svg" alt={currentUi.imgGeometricCaption} loading="lazy" decoding="async" width="800" height="450" />
      <figcaption>{currentUi.imgGeometricCaption}</figcaption>
    </figure>
  </section>

  <!-- Section 3: 4 Proven Mathematical Tests -->
  <section class="article-section article-section--alt" id="section-four-tests">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
        {content.s3.eyebrow}
      </div>
      <h2 class="article-h2">{content.s3.title}</h2>
      <p class="article-lead">{content.s3.intro}</p>

      <div class="math-block" style="margin: 20px 0;">
        <span class="math-formula">If &Sqrt;&oline;N&oline; = k &isin; &Zopf;, then N is a Perfect Cube (k &times; k &times; k = N)</span>
      </div>

      <div class="cube-methods-grid" style="margin-top: 28px;">
        {content.s3.tests.map((test, idx) => (
          <div class="cube-method-card" id={idx === 0 ? "test-root" : idx === 1 ? "test-factors" : idx === 2 ? "test-negatives" : "test-digital-root"}>
            <div class="cube-method-header">
              <span class="cube-method-num">{idx + 1}</span>
              <div>
                <h3 class="cube-method-title">{test.title}</h3>
                <span class="cube-method-subtitle">{test.subtitle}</span>
              </div>
            </div>
            <p class="cube-method-desc">{test.text}</p>
            <div class="cube-method-example">
              {test.example}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Worked Verification Examples -->
  <section class="article-section" id="section-worked-examples">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </span>
        Step-by-Step Proofs
      </div>
      <h2 class="article-h2">Step-by-Step Worked Verification Examples</h2>

      <div class="tip-card" style="margin: 20px 0;">
        <div class="tip-card-header">
          <span class="tip-badge" style="background: linear-gradient(135deg, #10b981, #059669);">
            PERFECT CUBE
          </span>
          <h3 class="tip-card-title">Example 1: Testing 512</h3>
        </div>
        <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
          <code>∛512 = 8</code> : 8 × 8 × 8 = 512. Prime factorization is 2⁹ with exponent 9 divisible by 3. Digital root: 5 + 1 + 2 = 8 (valid).
        </p>
      </div>

      <div class="tip-card" style="margin: 20px 0;">
        <div class="tip-card-header">
          <span class="tip-badge" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
            NOT A CUBE
          </span>
          <h3 class="tip-card-title">Example 2: Testing 100</h3>
        </div>
        <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
          <code>∛100 ≈ 4.642</code> : 100 sits strictly between 4³ = 64 and 5³ = 125. Prime factors are 2² × 5², neither exponent is divisible by 3.
        </p>
      </div>

      <div class="tip-card" style="margin: 20px 0;">
        <div class="tip-card-header">
          <span class="tip-badge" style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
            REAL NEGATIVE CUBE
          </span>
          <h3 class="tip-card-title">Example 3: Testing -216</h3>
        </div>
        <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
          <code>∛(-216) = -6</code> : (-6) × (-6) × (-6) = 36 × (-6) = -216. Odd roots preserve negative signs, producing a valid real integer root.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 5: Mental Math Shortcuts: 1-to-1 Last-Digit Bijection -->
  <section class="article-section article-section--alt" id="section-mental-math">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </span>
        Mental Math
      </div>
      <h2 class="article-h2">Mental Math Shortcuts: The 1-to-1 Last-Digit Bijection</h2>
      <p class="article-lead">
        Unlike perfect squares (which can only end in 0, 1, 4, 5, 6, or 9), every digit from 0 to 9 can be the last digit of a perfect cube. In fact, there is a strict one-to-one bijection between the ones digit of a base integer and the ones digit of its cube:
      </p>

      <div class="table-scroll-wrapper" style="margin-top: 20px;">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Base Last Digit (k)</th>
              <th scope="col">Cube Calculation (k³ mod 10)</th>
              <th scope="col">Cube Last Digit (k³)</th>
              <th scope="col">Memory Rule</th>
            </tr>
          </thead>
          <tbody>
            {lastDigitMapping.map((item) => (
              <tr>
                <td><strong>{item.kDigit}</strong></td>
                <td style="font-family: var(--font-mono);">{item.formula}</td>
                <td style="font-family: var(--font-mono); font-weight: 700; color: var(--primary-600);">{item.cubeDigit}</td>
                <td style="font-size: 0.86rem; color: var(--text-secondary);">{item.pattern}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="tip-card" style="margin-top: 24px;">
        <div class="tip-card-header">
          <span class="tip-badge">PRO TRICK</span>
          <h3 class="tip-card-title">Extracting Cube Roots of Large Numbers (Up to 1,000,000) in 3 Seconds</h3>
        </div>
        <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
          To find the cube root of <strong>175,616</strong>:
          <br />1. <strong>Ones Digit:</strong> The number ends in 6. Looking at our table, a cube ending in 6 must have a root ending in <strong>6</strong>.
          <br />2. <strong>Tens Digit:</strong> Cross off the last three digits (616), leaving <strong>175</strong>. The largest perfect cube below 175 is 125 (5³). So the tens digit is <strong>5</strong>.
          <br />Result: <code>∛175616 = 56</code>. Verified: 56 × 56 × 56 = 175,616!
        </p>
      </div>
    </div>

    <!-- Section Image: Last-Digit Bijection & Mental Extraction Diagram -->
    <figure class="section-image">
      <img src="/images/perfect-cube-last-digit-bijection.svg" alt={currentUi.imgBijectionCaption} loading="lazy" decoding="async" width="800" height="450" />
      <figcaption>{currentUi.imgBijectionCaption}</figcaption>
    </figure>
  </section>

  <!-- Section 6: Edge Cases: Zero, Negatives, Fractions, Decimals -->
  <section class="article-section" id="section-edge-cases">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        Special Cases
      </div>
      <h2 class="article-h2">Edge Cases: Zero, Negative Cubes, Fractions, and Decimals</h2>
      <p class="article-lead">
        Odd powers behave differently from even powers. Here is how special numeric sets are evaluated:
      </p>

      <div class="law-cards-grid" style="margin-top: 24px;">
        <div class="law-card">
          <h3 class="law-title">1. Is Zero a Perfect Cube?</h3>
          <p class="law-text">
            <strong>Yes.</strong> 0 is an integer, and 0 × 0 × 0 = 0 (0³ = 0). Its principal cube root is exactly 0.
          </p>
        </div>
        <div class="law-card">
          <h3 class="law-title">2. Negative Perfect Cubes</h3>
          <p class="law-text">
            <strong>Fully Real.</strong> Unlike square roots which require the imaginary unit i, odd roots preserve signs: (-k)³ = -k³. For example, ∛(-64) = -4.
          </p>
        </div>
        <div class="law-card">
          <h3 class="law-title">3. Rational Fractions</h3>
          <p class="law-text">
            A fraction is a cubic power if both its numerator and denominator are perfect cubes: 27/64 = (3/4)³.
          </p>
        </div>
        <div class="law-card">
          <h3 class="law-title">4. Finite Decimals</h3>
          <p class="law-text">
            Decimals are cubes if the significant digits form a cube and the number of decimal places is a multiple of 3: 0.027 = (0.3)³, 0.000125 = (0.05)³.
          </p>
        </div>
      </div>
      <p style="margin-top: 16px; font-weight: 500;">
        Comparing cubic numbers with square numbers? <a href={localizedUrl('/perfect-square-calculator/')} style="color: var(--primary-600); font-weight: 700; text-decoration: underline;">
          Test whether an integer is a perfect square &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Section 7: Nearest Perfect Cube (Bounding Intervals) -->
  <section class="article-section article-section--alt" id="section-nearest-cube">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        {content.s5.eyebrow}
      </div>
      <h2 class="article-h2">{content.s5.title}</h2>
      <p class="article-lead">{content.s5.p1}</p>
      <p>{content.s5.p2}</p>

      <div class="table-scroll-wrapper" style="margin-top: 20px;">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">{currentUi.targetNumber}</th>
              <th scope="col">{currentUi.cubeRoot}</th>
              <th scope="col">{currentUi.lowerBound}</th>
              <th scope="col">{currentUi.upperBound}</th>
