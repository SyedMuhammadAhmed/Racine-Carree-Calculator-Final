---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getCubeContent } from '../data/i18n/content/cubeContent';
import { getAuthorByline, getScrollHint } from '../data/i18n/commonI18n';
import { getCubeWidgetI18n } from '../data/i18n/widgetI18n';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}
const { lang = 'en', faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getCubeContent(lang);
const cubeToc = content.toc;
const effectiveFaqs = (faqs && faqs.length > 0) ? faqs : content.faqs;
const authorByline = getAuthorByline(lang);
const scrollHintText = getScrollHint(lang);
const cubeWidgetI18n = getCubeWidgetI18n(lang);

const first30Cubes = Array.from({ length: 30 }, (_, i) => {
  const n = i + 1;
  return { n, cube: n * n * n };
});
---

<article class="seo-article" id="perfect-cube-guide">
  <!-- Table of Contents -->
  <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
    <TableOfContents items={cubeToc} title={content.tocTitle} isOpen={false} lang={lang} />
  </div>

  <!-- Section 1: What is a Perfect Cube? -->
  <section class="article-section" id="section-what-is-perfect-cube">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </span>
        {content.s1.eyebrow}
      </div>
      <h2 class="article-h2">{content.s1.title}</h2>
      <p class="article-lead">
        {content.s1.lead}
      </p>
      <p>
        {content.s1.p1}
      </p>
      <p>
        {content.s1.p2}
      </p>

      <div class="examples-grid" style="margin: 20px 0 28px 0;">
        <div class="example-card">
          <span class="example-expr">3³ = 27</span>
          <span class="example-reason">∛27 = 3</span>
        </div>
        <div class="example-card">
          <span class="example-expr">5³ = 125</span>
          <span class="example-reason">∛125 = 5</span>
        </div>
        <div class="example-card">
          <span class="example-expr">(-4)³ = -64</span>
          <span class="example-reason">∛(-64) = -4</span>
        </div>
      </div>

      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s1.cards.map((card, idx) => (
          <div class="law-card">
            <div class="law-number">
              {idx === 0 && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>}
              {idx === 1 && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>}
              {idx === 2 && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
              {idx === 3 && <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l-.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>}
            </div>
            <h3 class="law-title">{card.title}</h3>
            <p class="law-text">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: How to Use -->
  <section class="article-section article-section--alt" id="section-how-to-use">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </span>
        {content.s2.eyebrow}
      </div>
      <h2 class="article-h2">{content.s2.title}</h2>
      <p>
        {content.s2.intro}
      </p>
      <div class="steps-visual" style="margin-top: 24px;">
        {content.s2.steps.map((step, idx) => (
          <div class="step-card" id={`step-cube-${idx + 1}`}>
            <div class="step-number">{idx + 1}</div>
            <div class="step-content">
              <h4>{step.title}</h4>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: 4 Proven Tests -->
  <section class="article-section" id="section-four-tests">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
        {content.s3.eyebrow}
      </div>
      <h2 class="article-h2">{content.s3.title}</h2>
      <p class="article-lead">
        {content.s3.intro}
      </p>

      <div class="cube-methods-grid" style="margin-top: 28px;">
        {content.s3.tests.map((test, idx) => (
          <div class="cube-method-card" id={idx === 0 ? "test-root" : idx === 1 ? "test-factors" : idx === 2 ? "test-negatives" : "test-digital-root"}>
            <div class="cube-method-header">
              <span class="cube-method-num">{idx + 1}</span>
              <div>
                <h3 class="cube-method-title">{test.title}</h3>
                <span class="cube-method-subtitle">{test.subtitle}</span>
              </div>
            </div>
            <p class="cube-method-desc">{test.text}</p>
            <div class="cube-method-example">
              {test.example}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: First 30 Perfect Cubes -->
  <section class="article-section article-section--alt" id="section-first-30-cubes">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </span>
        {content.s4.eyebrow}
      </div>
      <h2 class="article-h2">{content.s4.title}</h2>
      <p class="article-lead">
        {content.s4.desc}
      </p>

      <div class="table-scroll-wrapper table-scroll-wrapper--large" style="max-height: 520px; margin-top: 24px;">
        <div class="table-scroll-hint">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="7 13 12 18 17 13"/><polyline points="7 6 12 11 17 6"/></svg>
          {scrollHintText}
        </div>
        <table class="data-table data-table--vertical data-table--reference">
          <thead>
            <tr>
              <th scope="col">{content.s4.colN}</th>
              <th scope="col">{content.s4.colCube}</th>
              <th scope="col">{content.s4.colRoot}</th>
              <th scope="col">{content.s4.colParity}</th>
            </tr>
          </thead>
          <tbody>
            {first30Cubes.map(({ n, cube }) => (
              <tr>
                <td><strong>{n}</strong></td>
                <td><span style="font-family: var(--font-mono); font-weight: 700; color: var(--primary-600);">{cube.toLocaleString('en-US')}</span></td>
                <td><span style="font-family: var(--font-mono); color: var(--text-primary);">{n}</span></td>
                <td><span class={n % 2 === 0 ? "badge-even" : "badge-odd"}>{n % 2 === 0 ? cubeWidgetI18n.statEven : cubeWidgetI18n.statOdd}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Section 5: Nearest Perfect Cube -->
  <section class="article-section" id="section-nearest-cube">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        {content.s5.eyebrow}
      </div>
      <h2 class="article-h2">{content.s5.title}</h2>
      <p class="article-lead">
        {content.s5.p1}
      </p>
      <p>
        {content.s5.p2}
      </p>
    </div>
  </section>

  <!-- Section 6: Make Any Number a Perfect Cube -->
  <section class="article-section article-section--alt" id="section-make-cube">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </span>
        {content.s6.eyebrow}
      </div>
      <h2 class="article-h2">{content.s6.title}</h2>
      <p class="article-lead">
        {content.s6.p1}
      </p>
      <div class="law-cards-grid" style="margin-top: 20px;">
        <div class="law-card">
          <div class="law-number"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></div>
          <h3 class="law-title">{content.s6.multTitle}</h3>
          <p class="law-text">{content.s6.multText}</p>
        </div>
        <div class="law-card">
          <div class="law-number"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="1.5" fill="#fff"/><line x1="5" y1="12" x2="19" y2="12"/><circle cx="12" cy="18" r="1.5" fill="#fff"/></svg></div>
          <h3 class="law-title">{content.s6.divTitle}</h3>
          <p class="law-text">{content.s6.divText}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 7: Squares vs Cubes -->
  <section class="article-section" id="section-squares-vs-cubes">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </span>
        {content.s7.eyebrow}
      </div>
      <h2 class="article-h2">{content.s7.title}</h2>
      <p class="article-lead">
        {content.s7.p1}
      </p>

      <div class="table-scroll-wrapper" style="margin-top: 24px;">
        <table class="data-table data-table--comparison">
          <thead>
            <tr>
              <th scope="col">{content.s7.table.propCol}</th>
              <th scope="col">{content.s7.table.squareCol}</th>
              <th scope="col">{content.s7.table.cubeCol}</th>
            </tr>
          </thead>
          <tbody>
            {content.s7.table.rows.map((row) => (
              <tr>
                <td><strong>{row.prop}</strong></td>
                <td>{row.square}</td>
                <td>{row.cube}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Section 8: Real-World Applications -->
  <section class="article-section article-section--alt" id="section-applications">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </span>
        {content.s8.eyebrow}
      </div>
      <h2 class="article-h2">{content.s8.title}</h2>
      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s8.apps.map((app) => (
          <div class="law-card">
            <h3 class="law-title">{app.title}</h3>
            <p class="law-text">{app.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 9: FAQs -->
  <section class="article-section" id="section-faqs">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        {content.s9.eyebrow}
      </div>
      <h2 class="article-h2">{content.s9.title}</h2>
      <div class="faq-list">
        {effectiveFaqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>

      <!-- Author Byline & Social Sharing Bar below FAQs -->
      <div class="article-header-meta" style="margin-top: 40px; margin-bottom: 0;">
        <div class="article-author-byline">
          <a href={localizedUrl('/about-us/')} class="author-avatar-link" aria-label="Syed Muhammad Ahmed, Founder and Creator">
            <img src="/images/syed-muhammad-ahmed-racine-carree-calculator.jpg" alt="Syed Muhammad Ahmed, Founder and Creator of Racine Carree Calculator" width="44" height="44" loading="lazy" decoding="async" class="author-avatar" />
          </a>
          <div class="author-details">
            <span class="author-verified-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              {authorByline.writtenBy}
            </span>
            <a href={localizedUrl('/about-us/')} class="author-name-link">Syed Muhammad Ahmed</a>
            <span class="author-title">{authorByline.authorRole}</span>
          </div>
        </div>
        <div class="social-share-group">
          <span class="social-share-label">{authorByline.share}</span>
          <a href="https://twitter.com/intent/tweet?text=Free%20Perfect%20Cube%20Calculator%20with%20step-by-step%20solutions&url=https://www.racinecarreecalculatorr.com/perfect-cube-calculator/" target="_blank" rel="noopener noreferrer" class="share-btn share-btn--x" aria-label="Share on X" title="Share on X">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.linkedin.com/sharing/share-offsite/?url=https://www.racinecarreecalculatorr.com/perfect-cube-calculator/" target="_blank" rel="noopener noreferrer" class="share-btn share-btn--linkedin" aria-label="Share on LinkedIn" title="Share on LinkedIn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.facebook.com/sharer/sharer.php?u=https://www.racinecarreecalculatorr.com/perfect-cube-calculator/" target="_blank" rel="noopener noreferrer" class="share-btn share-btn--facebook" aria-label="Share on Facebook" title="Share on Facebook">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://api.whatsapp.com/send?text=Check%20out%20Perfect%20Cube%20Calculator:%20https://www.racinecarreecalculatorr.com/perfect-cube-calculator/" target="_blank" rel="noopener noreferrer" class="share-btn share-btn--whatsapp" aria-label="Share on WhatsApp" title="Share on WhatsApp">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 10: Quick Recap -->
  <section class="article-section" id="section-recap">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        {content.s10.eyebrow}
      </div>
      <h2 class="article-h2">{content.s10.title}</h2>
      <div class="law-cards-grid" style="margin-top: 20px;">
        {content.s10.cards.map((card) => (
          <div class="law-card">
            <h3 class="law-title">{card.title}</h3>
            <p class="law-text">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</article>
