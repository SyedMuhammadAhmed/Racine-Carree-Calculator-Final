---
interface TocSubItem {
  title: string;
  href: string;
}

interface TocItem {
  title: string;
  href: string;
  subitems?: TocSubItem[];
}

interface Props {
  items: TocItem[];
  title?: string;
  isOpen?: boolean;
}

const { items, title = "Table of Contents", isOpen = false } = Astro.props;
---

<div class="toc-wrapper">
  <details class="toc-card" open={isOpen ? true : undefined}>
    <summary class="toc-summary">
      <div class="toc-summary-left">
        <span class="toc-icon-badge" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
        </span>
        <span class="toc-heading">{title}</span>
        <span class="toc-count-badge">{items.length} Sections</span>
      </div>
      <div class="toc-toggle-indicator">
        <span class="toc-toggle-show">Show</span>
        <span class="toc-toggle-hide">Hide</span>
        <svg class="toc-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </summary>
    <nav class="toc-content" aria-label={title}>
      <ol class="toc-list">
        {items.map((item) => (
          <li class="toc-item">
            <a href={item.href} class="toc-link">
              <span>{item.title}</span>
            </a>
            {item.subitems && item.subitems.length > 0 && (
              <ul class="toc-sublist">
                {item.subitems.map((sub) => (
                  <li class="toc-subitem">
                    <a href={sub.href} class="toc-sublink">
                      <span>{sub.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>
  </details>
</div>
