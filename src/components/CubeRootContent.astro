---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getCbrtContent } from '../data/i18n/content/cbrtContent';
import { getAuthorByline, getScrollHint } from '../data/i18n/commonI18n';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const { lang = DEFAULT_LOCALE, faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getCbrtContent(lang);
const authorByline = getAuthorByline(lang);
const scrollHintText = getScrollHint(lang);
const ui = content.interactive;
const displayFaqs = (faqs && faqs.length >= 10) ? faqs : content.faqs;

// Generate 1-100 reference table data with simplification
function simplifyCbrt(n: number): string {
  if (n <= 0) return '';
  let maxCubeFactor = 1;
  for (let i = 2; i * i * i <= n; i++) {
    if (n % (i * i * i) === 0) {
      maxCubeFactor = i;
    }
  }
  if (maxCubeFactor > 1) {
    const remainder = n / (maxCubeFactor * maxCubeFactor * maxCubeFactor);
    if (remainder === 1) return `${maxCubeFactor}`;
    return `${maxCubeFactor}∛${remainder}`;
  }
  return `∛${n}`;
}

const table100Rows = Array.from({ length: 100 }, (_, i) => {
  const n = i + 1;
  const root = Math.cbrt(n);
  const isPerfect = Math.round(root) ** 3 === n;
  return {
    n,
    rootFormatted: isPerfect ? `${Math.round(root)}` : root.toFixed(4),
    simplified: isPerfect ? `${Math.round(root)}` : simplifyCbrt(n),
    isPerfect
  };
});

// Key perfect cubes reference list
const perfectCubesList = [
  { n: 1, cube: 1 },
  { n: 2, cube: 8 },
  { n: 3, cube: 27 },
  { n: 4, cube: 64 },
  { n: 5, cube: 125 },
  { n: 6, cube: 216 },
  { n: 7, cube: 343 },
  { n: 8, cube: 512 },
  { n: 9, cube: 729 },
  { n: 10, cube: 1000 },
  { n: 11, cube: 1331 },
  { n: 12, cube: 1728 },
  { n: 15, cube: 3375 },
  { n: 20, cube: 8000 },
  { n: 25, cube: 15625 },
  { n: 50, cube: 125000 },
  { n: 100, cube: 1000000 }
];

// Common simplification examples
const commonSimplifications = [
  { expr: "∛16", simp: "2∛2", factor: "16 = 2³ × 2 = 8 × 2", num: 16 },
  { expr: "∛24", simp: "2∛3", factor: "24 = 2³ × 3 = 8 × 3", num: 24 },
  { expr: "∛32", simp: "2∛4", factor: "32 = 2³ × 4 = 8 × 4", num: 32 },
  { expr: "∛40", simp: "2∛5", factor: "40 = 2³ × 5 = 8 × 5", num: 40 },
  { expr: "∛48", simp: "2∛6", factor: "48 = 2³ × 6 = 8 × 6", num: 48 },
  { expr: "∛54", simp: "3∛2", factor: "54 = 3³ × 2 = 27 × 2", num: 54 },
  { expr: "∛56", simp: "2∛7", factor: "56 = 2³ × 7 = 8 × 7", num: 56 },
  { expr: "∛72", simp: "2∛9", factor: "72 = 2³ × 9 = 8 × 9", num: 72 },
  { expr: "∛108", simp: "3∛4", factor: "108 = 3³ × 4 = 27 × 4", num: 108 },
  { expr: "∛128", simp: "4∛2", factor: "128 = 4³ × 2 = 64 × 2", num: 128 }
];
---

<article class="seo-article" id="what-is-cubique">

    <!-- Interactive Hero Feature Ribbon -->
    <div class="article-container" style="padding-bottom: var(--space-md);">
        <div class="interactive-ribbon">
            <div class="ribbon-badges">
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    {ui.badgeInstant}
                </span>
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg>
                    {ui.badgeRadical}
                </span>
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    {ui.badgeSteps}
                </span>
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {ui.badgeFree}
                </span>
            </div>

            <!-- Quick-Try Interactive Chips -->
            <div class="quick-try-bar">
                <span class="quick-try-label">{ui.quickTryLabel}</span>
                <div class="quick-try-chips">
                    <button type="button" class="quick-try-chip" data-cbrt-num="27" title="Test ∛27 in calculator">∛27 = 3</button>
                    <button type="button" class="quick-try-chip" data-cbrt-num="-64" title="Test ∛(-64) in calculator">∛(-64) = -4</button>
                    <button type="button" class="quick-try-chip" data-cbrt-num="54" title="Test ∛54 in calculator">∛54 = 3∛2</button>
                    <button type="button" class="quick-try-chip" data-cbrt-num="50" title="Test ∛50 in calculator">∛50 ≈ 3.68</button>
                    <button type="button" class="quick-try-chip" data-cbrt-num="0.008" title="Test ∛0.008 in calculator">∛0.008 = 0.2</button>
                    <button type="button" class="quick-try-chip" data-cbrt-num="3375" title="Test ∛3375 in calculator">∛3375 = 15</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table of Contents -->
    <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
        <TableOfContents items={content.toc} title={content.tocTitle} isOpen={false} lang={lang} />
    </div>

    <!-- Section 1: What Is Racine Cubique -->
    <section class="article-section" id="section-what-is-cube-root">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span>
                {content.s1Eyebrow}
            </div>
            <h2 class="article-h2">{content.s1Title}</h2>
            <p>{content.s1P1}</p>
            <p>{content.s1P2}</p>

            <!-- Interactive Radical Anatomy Card -->
            <div class="anatomy-box" id="radicalAnatomy">
                <div class="anatomy-header">
                    <span class="anatomy-tag">{ui.anatomyTag}</span>
                    <span class="anatomy-hint">{ui.anatomyHint}</span>
                </div>
                <div class="anatomy-visual">
                    <span class="anatomy-part anatomy-part--degree active" data-part="degree" tabindex="0" role="button" aria-label={ui.anatomyDegree}>³</span>
                    <span class="anatomy-part anatomy-part--symbol" data-part="symbol" tabindex="0" role="button" aria-label={ui.anatomySymbol}>√</span>
                    <span class="anatomy-part anatomy-part--radicand" data-part="radicand" tabindex="0" role="button" aria-label={ui.anatomyRadicand}>27</span>
                    <span class="anatomy-equals">=</span>
                    <span class="anatomy-part anatomy-part--root" data-part="root" tabindex="0" role="button" aria-label={ui.anatomyRoot}>3</span>
                </div>
                <div class="anatomy-cards-grid">
                    <div class="anatomy-info-card active" id="info-degree">
                        <div class="anatomy-card-title">{ui.anatomyDegree}</div>
                        <p class="anatomy-card-desc">{ui.anatomyDegreeDesc}</p>
                    </div>
                    <div class="anatomy-info-card" id="info-symbol">
                        <div class="anatomy-card-title">{ui.anatomySymbol}</div>
                        <p class="anatomy-card-desc">{ui.anatomySymbolDesc}</p>
                    </div>
                    <div class="anatomy-info-card" id="info-radicand">
                        <div class="anatomy-card-title">{ui.anatomyRadicand}</div>
                        <p class="anatomy-card-desc">{ui.anatomyRadicandDesc}</p>
                    </div>
                    <div class="anatomy-info-card" id="info-root">
                        <div class="anatomy-card-title">{ui.anatomyRoot}</div>
                        <p class="anatomy-card-desc">{ui.anatomyRootDesc}</p>
                    </div>
                </div>
            </div>

            <div class="examples-grid">
                {content.s1Cards.map(c => (
                  <div class="example-card">
                    <span class="example-expr">{c.expr}</span>
                    <span class="example-reason">{c.reason}</span>
                  </div>
                ))}
            </div>
            <p>{content.s1P3}</p>
        </div>
    </section>

    <figure class="section-image">
        <img src="/images/cbrt-concept.webp" alt="3D cube geometry diagram for racine cubique calculator" loading="lazy" decoding="async" fetchpriority="low" sizes="(max-width: 840px) 100vw, 800px" width="800" height="448">
        <figcaption>{content.s1Caption}</figcaption>
    </figure>

    <!-- Section 2: How to Use -->
    <section class="article-section article-section--alt" id="section-cbrt-how-to-use">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
                {content.s2Eyebrow}
            </div>
            <h2 class="article-h2">{content.s2Title}</h2>
            <p>{content.s2Intro}</p>
            <div class="steps-visual">
                <div class="step-card" id="cbrt-step-input">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <h3>{content.s2Steps[0]?.title}</h3>
                        <p>{content.s2Steps[0]?.text}</p>
                    </div>
                </div>
                <div class="step-card" id="cbrt-step-calc">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <h3>{content.s2Steps[1]?.title}</h3>
                        <p>{content.s2Steps[1]?.text}</p>
                    </div>
                </div>
                <div class="step-card" id="cbrt-step-result">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <h3>{content.s2Steps[2]?.title}</h3>
                        <p>{content.s2Steps[2]?.text}</p>
                    </div>
                </div>
            </div>
            <p>{content.s2Conclusion}</p>
        </div>
    </section>

    <!-- Section 3: Notation & Switcher -->
    <section class="article-section" id="section-cbrt-notation">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 17c2 0 2.8-1 2.8-2.8V10c0-2 1-3.3 3.2-3"/><path d="M9 11.2h5.7"/></svg></span>
                {content.s3Eyebrow}
            </div>
            <h2 class="article-h2">{content.s3Title}</h2>
            <p>{content.s3Intro}</p>

            <!-- Interactive Notation Mode Switcher -->
            <div class="notation-switcher-box">
                <div class="notation-tabs" role="tablist">
                    <button type="button" class="notation-tab active" data-format="radical" role="tab">{ui.tabRadical}</button>
                    <button type="button" class="notation-tab" data-format="exponent" role="tab">{ui.tabExponent}</button>
                    <button type="button" class="notation-tab" data-format="code" role="tab">{ui.tabCode}</button>
                    <button type="button" class="notation-tab" data-format="sheet" role="tab">{ui.tabSheet}</button>
                    <button type="button" class="notation-tab" data-format="latex" role="tab">{ui.tabLatex}</button>
                    <button type="button" class="notation-tab" data-format="typing" role="tab">{ui.tabTyping}</button>
                </div>
                <div class="notation-content-panels">
                    <div class="notation-view active" id="view-radical">
                        <div class="math-block">
                            <span class="math-formula">∛64 = 4</span>
                            <button type="button" class="btn-copy-formula" data-formula="∛64 = 4" title={ui.copyBtn}>{ui.copyBtn}</button>
                        </div>
                        <p class="notation-desc">Standard mathematical radical notation using index 3 and radical sign.</p>
                    </div>
                    <div class="notation-view" id="view-exponent">
                        <div class="math-block">
                            <span class="math-formula">64^(1/3) = 4</span>
                            <button type="button" class="btn-copy-formula" data-formula="64^(1/3) = 4" title={ui.copyBtn}>{ui.copyBtn}</button>
                        </div>
                        <p class="notation-desc">Fractional power representation: raising any number to 1/3 equals its cube root.</p>
                    </div>
                    <div class="notation-view" id="view-code">
                        <div class="math-block">
                            <span class="math-formula">Math.cbrt(64) // 4</span>
                            <button type="button" class="btn-copy-formula" data-formula="Math.cbrt(64)" title={ui.copyBtn}>{ui.copyBtn}</button>
                        </div>
                        <p class="notation-desc">Standard in JavaScript, Python (<code>64 ** (1/3)</code>), C, Java, and modern runtimes.</p>
                    </div>
                    <div class="notation-view" id="view-sheet">
                        <div class="math-block">
                            <span class="math-formula">=POWER(A1, 1/3)</span>
                            <button type="button" class="btn-copy-formula" data-formula="=POWER(A1, 1/3)" title={ui.copyBtn}>{ui.copyBtn}</button>
                        </div>
                        <p class="notation-desc">Excel and Google Sheets formula. Alternatively use <code>=A1^(1/3)</code>.</p>
                    </div>
                    <div class="notation-view" id="view-latex">
                        <div class="math-block">
                            <span class="math-formula">\sqrt[3]{64}</span>
                            <button type="button" class="btn-copy-formula" data-formula="\sqrt[3]{64}" title={ui.copyBtn}>{ui.copyBtn}</button>
                        </div>
                        <p class="notation-desc">LaTeX mathematical typesetting command for academic papers and documents.</p>
                    </div>
                    <div class="notation-view" id="view-typing">
                        <div class="math-block">
                            <span class="math-formula">Unicode: U+221B | HTML: &amp;#8731; | 221B + Alt+X</span>
                            <button type="button" class="btn-copy-formula" data-formula="∛" title="Copy ∛">{ui.copyBtn} ∛</button>
                        </div>
                        <p class="notation-desc">On Windows: type 221B then press Alt+X. On Mac: Cmd+Ctrl+Space. HTML: <code>&amp;#8731;</code>.</p>
                    </div>
                </div>
            </div>

            <p>{content.s3P1}</p>
            <div class="math-block"><span class="math-formula">x^(1/3) = ∛x</span></div>
            <p>{content.s3P2}</p>
            <p>{content.s3P3}</p>
        </div>
    </section>

    <figure class="section-image">
        <img src="/images/cbrt-notation.webp" alt="Radical notation index diagram for racine cubique calculator" loading="lazy" decoding="async" fetchpriority="low" sizes="(max-width: 840px) 100vw, 800px" width="800" height="448">
        <figcaption>{content.s3Caption}</figcaption>
    </figure>

    <!-- Section 4: Formula -->
    <section class="article-section article-section--alt" id="section-cbrt-formula">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg></span>
                {content.s4Eyebrow}
            </div>
            <h2 class="article-h2">{content.s4Title}</h2>
            <p>{content.s4Intro}</p>
            <div class="math-block">
                <span class="math-formula">If y = ∛x, then y × y × y = x (or y³ = x)</span>
                <button type="button" class="btn-copy-formula" data-formula="If y = ∛x, then y³ = x" title={ui.copyBtn}>{ui.copyBtn}</button>
            </div>
            <p>{content.s4P1}</p>
        </div>
    </section>

    <!-- Section 5: Five Core Laws -->
    <section class="article-section" id="section-cbrt-laws">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
                {content.s5Eyebrow}
            </div>
            <h2 class="article-h2">{content.s5Title}</h2>
            <p>{content.s5Intro}</p>
            <div class="law-cards">
                {content.s5Laws.map((law, idx) => (
                  <div class="law-card">
                      <div class="law-header">
                        <div class="law-number">{idx + 1}</div>
                        <div>
                          <div class="law-label">{law.name}</div>
                          <div class="law-subtitle">{law.subtitle}</div>
                        </div>
                      </div>
                      <div class="math-block">
                          <span class="math-formula">{law.example}</span>
                          <button type="button" class="btn-copy-formula" data-formula={law.example} title={ui.copyBtn}>{ui.copyBtn}</button>
                      </div>
                      <p class="law-explanation">{law.explanation}</p>
                  </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Section 6: Calculation Methods -->
    <section class="article-section article-section--alt" id="section-cbrt-methods">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg></span>
                {content.s6Eyebrow}
            </div>
            <h2 class="article-h2">{content.s6Title}</h2>
            <p>{content.s6Intro}</p>

            <!-- Interactive Method Switcher Tabs -->
            <div class="method-tabs-wrapper">
                <div class="method-tabs-nav" role="tablist">
                    <button type="button" class="method-tab-btn active" data-method="calculator" role="tab">{ui.methodCalc}</button>
                    <button type="button" class="method-tab-btn" data-method="factorization" role="tab">{ui.methodFactors}</button>
                    <button type="button" class="method-tab-btn" data-method="estimation" role="tab">{ui.methodEstimate}</button>
                </div>

                <div class="method-panels">
                    <!-- Method 1: Calculator -->
                    <div class="method-panel active" id="method-panel-calculator">
                        <div class="method-badge">Method 1</div>
                        <h3 class="method-title">{content.s6M1Title}</h3>
                        <p>{content.s6M1Text}</p>
                        <div class="method-action-box">
                            <button type="button" class="btn-calc-primary btn-test-calc" data-cbrt-num="3375">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                                <span>{ui.testBtn} (∛3375)</span>
                            </button>
                        </div>
                    </div>

                    <!-- Method 2: Prime Factorization -->
                    <div class="method-panel" id="method-panel-factorization">
                        <div class="method-badge">Method 2</div>
                        <h3 class="method-title">{content.s6M2Title}</h3>
                        <p>{content.s6M2Intro}</p>
                        <div class="worked-example">
                            <div class="example-tag">{content.s6M2ExTitle}</div>
                            <ol class="example-steps">
                                {content.s6M2Steps.map(step => (
                                  <li>{step}</li>
                                ))}
                            </ol>
                        </div>
                        <div class="worked-example" style="margin-top: 16px;">
                            <div class="example-tag">Extended Example: Find ∛3375</div>
                            <ol class="example-steps">
                                <li>Decompose into prime factors: 3375 = 3 × 3 × 3 × 5 × 5 × 5</li>
                                <li>Group into sets of three: (3 × 3 × 3) × (5 × 5 × 5) = 3³ × 5³</li>
                                <li>Take one factor from each group: 3 × 5 = 15</li>
                                <li>Therefore, ∛3375 = 15.</li>
                            </ol>
                        </div>
                    </div>

