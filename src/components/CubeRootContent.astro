---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getCbrtContent } from '../data/i18n/content/cbrtContent';
import { getAuthorByline } from '../data/i18n/commonI18n';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}
const { lang = DEFAULT_LOCALE, faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getCbrtContent(lang);
const authorByline = getAuthorByline(lang);

const table100Rows = Array.from({ length: 100 }, (_, i) => {
  const n = i + 1;
  const root = Math.cbrt(n);
  const isPerfect = Math.round(root) ** 3 === n;
  return {
    n,
    rootFormatted: root.toFixed(3),
    isPerfect
  };
});

const perfectCubesList = [
  { n1: 1, c1: 1, n2: 6, c2: 216 },
  { n1: 2, c1: 8, n2: 7, c2: 343 },
  { n1: 3, c1: 27, n2: 8, c2: 512 },
  { n1: 4, c1: 64, n2: 9, c2: 729 },
  { n1: 5, c1: 125, n2: 10, c2: 1000 },
];
---

<article class="seo-article" id="what-is-cubique">

        <!-- Table of Contents -->
        <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
            <TableOfContents items={content.toc} title={content.tocTitle} isOpen={false} lang={lang} />
        </div>

        <!-- Section 1: What Is Racine Cubique -->
        <section class="article-section" id="section-what-is-cube-root">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span> {content.s1Eyebrow}</div>
                <h2 class="article-h2">{content.s1Title}</h2>
                <p>{content.s1P1}</p>
                <p>{content.s1P2}</p>
                <div class="examples-grid">
                    {content.s1Cards.map(c => (
                      <div class="example-card"><span class="example-expr">{c.expr}</span><span class="example-reason">{c.reason}</span></div>
                    ))}
                </div>
                <p>{content.s1P3}</p>
            </div>
        </section>

        <figure class="section-image">
            <img src="/images/cbrt-concept.webp" alt="3D cube geometry diagram for racine cubique calculator" loading="lazy" decoding="async" fetchpriority="low" sizes="(max-width: 840px) 100vw, 800px" width="800" height="448">
            <figcaption>{content.s1Caption}</figcaption>
        </figure>

        <!-- Section 2: How to Use -->
        <section class="article-section article-section--alt" id="section-cbrt-how-to-use">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span> {content.s2Eyebrow}</div>
                <h2 class="article-h2">{content.s2Title}</h2>
                <p>{content.s2Intro}</p>
                <div class="steps-visual">
                    <div class="step-card" id="cbrt-step-input"><div class="step-number">1</div><div class="step-content"><h3>{content.s2Steps[0]?.title}</h3><p>{content.s2Steps[0]?.text}</p></div></div>
                    <div class="step-card" id="cbrt-step-calc"><div class="step-number">2</div><div class="step-content"><h3>{content.s2Steps[1]?.title}</h3><p>{content.s2Steps[1]?.text}</p></div></div>
                    <div class="step-card" id="cbrt-step-result"><div class="step-number">3</div><div class="step-content"><h3>{content.s2Steps[2]?.title}</h3><p>{content.s2Steps[2]?.text}</p></div></div>
                </div>
                <p>{content.s2Conclusion}</p>
            </div>
        </section>

        <!-- Section 3: Notation -->
        <section class="article-section" id="section-cbrt-notation">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17c2 0 2.8-1 2.8-2.8V10c0-2 1-3.3 3.2-3"/><path d="M9 11.2h5.7"/></svg></span> {content.s3Eyebrow}</div>
                <h2 class="article-h2">{content.s3Title}</h2>
                <p>{content.s3Intro}</p>
                <div class="examples-grid">
                    {content.s3Cards.map(c => (
                      <div class="example-card"><span class="example-expr">{c.expr}</span><span class="example-reason">{c.reason}</span></div>
                    ))}
                </div>
                <p>{content.s3P1}</p>
                <div class="math-block"><span class="math-formula">x^(1/3) = ∛x</span></div>
                <p>{content.s3P2}</p>
                <p>{content.s3P3}</p>
            </div>
        </section>

        <figure class="section-image">
            <img src="/images/cbrt-notation.webp" alt="Radical notation index diagram for racine cubique calculator" loading="lazy" decoding="async" fetchpriority="low" sizes="(max-width: 840px) 100vw, 800px" width="800" height="448">
            <figcaption>{content.s3Caption}</figcaption>
        </figure>

        <!-- Section 4: Formula -->
        <section class="article-section article-section--alt" id="section-cbrt-formula">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg></span> {content.s4Eyebrow}</div>
                <h2 class="article-h2">{content.s4Title}</h2>
                <p>{content.s4Intro}</p>
                <div class="math-block"><span class="math-formula">If x = ∛y, then x × x × x = y (or x³ = y)</span></div>
                <p>{content.s4P1}</p>
            </div>
        </section>

        <!-- Section 5: Five Core Laws -->
        <section class="article-section" id="section-cbrt-laws">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span> {content.s5Eyebrow}</div>
                <h2 class="article-h2">{content.s5Title}</h2>
                <p>{content.s5Intro}</p>
                <div class="law-cards">
                    {content.s5Laws.map((law, idx) => (
                      <div class="law-card">
                          <div class="law-header">
                            <div class="law-number">{idx + 1}</div>
                            <div><div class="law-label">{law.name}</div><div class="law-subtitle">{law.subtitle}</div></div>
                          </div>
                          <div class="math-block"><span class="math-formula">{law.example}</span></div>
                          <p class="law-explanation">{law.explanation}</p>
                      </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Section 6: Calculation Methods -->
        <section class="article-section article-section--alt" id="section-cbrt-methods">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg></span> {content.s6Eyebrow}</div>
                <h2 class="article-h2">{content.s6Title}</h2>
                <p>{content.s6Intro}</p>

                <div class="method-card" id="cbrt-method-calculator">
                    <div class="method-badge">Method 1</div>
                    <h3 class="method-title">{content.s6M1Title}</h3>
                    <p>{content.s6M1Text}</p>
                </div>

                <div class="method-card" id="cbrt-method-factorization">
                    <div class="method-badge">Method 2</div>
                    <h3 class="method-title">{content.s6M2Title}</h3>
                    <p>{content.s6M2Intro}</p>
                    <div class="worked-example">
                        <div class="example-tag">{content.s6M2ExTitle}</div>
                        <ol class="example-steps">
                            {content.s6M2Steps.map(step => (
                              <li>{step}</li>
                            ))}
                        </ol>
                    </div>
                </div>

                <div class="method-card" id="cbrt-method-newton">
                    <div class="method-badge">Method 3</div>
                    <h3 class="method-title">{content.s6M3Title}</h3>
                    <p>{content.s6M3Text}</p>
                    <div class="math-block"><span class="math-formula">x_(n+1) = (2·x_n + A / x_n²) / 3</span></div>
                </div>

                <div class="method-card" id="cbrt-method-estimation">
                    <div class="method-badge">Method 4</div>
                    <h3 class="method-title">{content.s6M4Title}</h3>
                    <p>{content.s6M4Intro}</p>
                    <div class="worked-example">
                        <div class="example-tag">{content.s6M4ExTitle}</div>
                        <ol class="example-steps">
                            {content.s6M4Steps.map(step => (
                              <li>{step}</li>
                            ))}
                        </ol>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 7: Positive Numbers -->
        <section class="article-section" id="section-cbrt-positive">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg></span> {content.s7Eyebrow}</div>
                <h2 class="article-h2">{content.s7Title}</h2>
                <p>{content.s7Intro}</p>
                <div class="table-scroll-wrapper">
                    <table class="data-table">
                        <thead><tr><th>{content.s7ThNumber}</th><th>{content.s7ThRoot}</th><th>{content.s7ThWhy}</th></tr></thead>
                        <tbody>
                            <tr><td>8</td><td>2</td><td>{content.s7Row8}</td></tr>
                            <tr><td>125</td><td>5</td><td>{content.s7Row125}</td></tr>
                            <tr><td>512</td><td>8</td><td>{content.s7Row512}</td></tr>
                            <tr><td>1,000</td><td>10</td><td>{content.s7Row10}</td></tr>
                        </tbody>
                    </table>
                </div>
                <p>{content.s7Conclusion}</p>
            </div>
        </section>

        <!-- Section 8: Negative Numbers -->
        <section class="article-section article-section--alt" id="section-cbrt-negative">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg></span> {content.s8Eyebrow}</div>
                <h2 class="article-h2">{content.s8Title}</h2>
                <p>{content.s8P1}</p>
                <p>{content.s8P2}</p>
                <div class="worked-example">
                    <div class="example-tag">{content.s8ExTitle}</div>
                    <p>{content.s8ExStep}</p>
                </div>
                <p>{content.s8Conclusion}</p>
                <div class="warning-box">
                    <div class="warning-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
                    <div class="warning-content">
                        <strong>{content.s8WarningTitle}</strong>
                        <p>{content.s8WarningText}</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section 9: Difference vs Square Root -->
        <section class="article-section" id="section-cbrt-diff">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span> {content.s9Eyebrow}</div>
                <h2 class="article-h2">{content.s9Title}</h2>
                <p>{content.s9Intro}</p>
                <div class="table-scroll-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Property</th><th>{content.s9ThCube}</th><th>{content.s9ThSquare}</th></tr></thead>
                        <tbody>
                            <tr><td>{content.s9RowSymbol}</td><td>∛ (index 3)</td><td>√ (index 2)</td></tr>
                            <tr><td>{content.s9RowMult}</td><td>{content.s9RowMultCube}</td><td>{content.s9RowMultSquare}</td></tr>
                            <tr><td>{content.s9RowEx}</td><td>{content.s9RowExCube}</td><td>{content.s9RowExSquare}</td></tr>
                            <tr><td>{content.s9RowNegative}</td><td>{content.s9RowNegativeCube}</td><td>{content.s9RowNegativeSquare}</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Section 10: Real-Life Applications -->
        <section class="article-section article-section--alt" id="section-cbrt-applications">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></span> {content.s10Eyebrow}</div>
                <h2 class="article-h2">{content.s10Title}</h2>
                <p>{content.s10Intro}</p>
                <div class="app-cards-grid">
                    {content.s10Apps.map(app => (
                      <div class="app-card">
                          <h3>{app.title}</h3>
                          <p>{app.text}</p>
                      </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Section 11: Simplification Table -->
        <section class="article-section" id="section-cbrt-simplification">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></span> {content.s11Eyebrow}</div>
                <h2 class="article-h2">{content.s11Title}</h2>
                <p>{content.s11Intro}</p>
                <div class="table-scroll-wrapper">
                    <table class="data-table">
                        <thead><tr><th>{content.s11ThExpr}</th><th>{content.s11ThForm}</th><th>{content.s11ThWhy}</th></tr></thead>
                        <tbody>
                            <tr><td>∛16</td><td>2∛2</td><td>∛(8 × 2) = ∛8 × ∛2 = 2∛2</td></tr>
                            <tr><td>∛24</td><td>2∛3</td><td>∛(8 × 3) = ∛8 × ∛3 = 2∛3</td></tr>
                            <tr><td>∛32</td><td>2∛4</td><td>∛(8 × 4) = ∛8 × ∛4 = 2∛4</td></tr>
                            <tr><td>∛40</td><td>2∛5</td><td>∛(8 × 5) = ∛8 × ∛5 = 2∛5</td></tr>
                            <tr><td>∛48</td><td>2∛6</td><td>∛(8 × 6) = ∛8 × ∛6 = 2∛6</td></tr>
                            <tr><td>∛54</td><td>3∛2</td><td>∛(27 × 2) = ∛27 × ∛2 = 3∛2</td></tr>
                            <tr><td>∛56</td><td>2∛7</td><td>∛(8 × 7) = ∛8 × ∛7 = 2∛7</td></tr>
                            <tr><td>∛72</td><td>2∛9</td><td>∛(8 × 9) = ∛8 × ∛9 = 2∛9</td></tr>
                            <tr><td>∛108</td><td>3∛4</td><td>∛(27 × 4) = ∛27 × ∛4 = 3∛4</td></tr>
                            <tr><td>∛128</td><td>4∛2</td><td>∛(64 × 2) = ∛64 × ∛2 = 4∛2</td></tr>
                        </tbody>
                    </table>
                </div>
                <p>{content.s11Conclusion}</p>
            </div>
        </section>

        <!-- Section 12: Reference Table 1-100 -->
        <section class="article-section article-section--alt" id="section-cbrt-reference">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg></span> {content.s12Eyebrow}</div>
                <h2 class="article-h2">{content.s12Title}</h2>
                <p>{content.s12Intro}</p>
                <p class="scroll-hint"><span class="scroll-hint-icon">👉</span> {content.s12ScrollHint}</p>
                <div class="table-scroll-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>{content.s12ColNumber}</th>
                                <th>{content.s12ColRoot}</th>
                                <th>{content.s12ColType}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {table100Rows.map(row => (
                                <tr class={row.isPerfect ? "tr-perfect" : ""}>
                                    <td>{row.n}</td>
                                    <td>{row.rootFormatted}</td>
                                    <td>
                                        {row.isPerfect ? (
                                            <span class="badge-perfect">{content.s12BadgePerfect}</span>
                                        ) : (
                                            content.s12BadgeIrrational
                                        )}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Section 13: Perfect Cubes -->
        <section class="article-section" id="section-cbrt-perfect-cubes">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></span> {content.s13Eyebrow}</div>
                <h2 class="article-h2">{content.s13Title}</h2>
                <p>{content.s13Intro}</p>
                <div class="table-scroll-wrapper">
                    <table class="data-table">
                        <thead><tr><th>Number</th><th>Cube</th><th>Number</th><th>Cube</th></tr></thead>
                        <tbody>
                            {perfectCubesList.map(item => (
                              <tr>
                                <td>{item.n1}</td>
                                <td>{item.c1}</td>
                                <td>{item.n2}</td>
                                <td>{item.c2}</td>
                              </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

