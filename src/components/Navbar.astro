---
import { DEFAULT_LOCALE, LOCALES, getLocalizedUrl, type Locale } from '../../theme/i18n/utils';
import { useTranslations } from '../../theme/i18n/translations';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  lang?: string;
  contentLang?: string;
}

const { lang = DEFAULT_LOCALE, contentLang = DEFAULT_LOCALE } = Astro.props;
const localePrefixPattern = new RegExp(`^/(${LOCALES.join('|')})(?=/|$)`);
const pathLocale = Astro.url.pathname.match(localePrefixPattern)?.[1];
const requestedLocale = Astro.url.searchParams.get('lang') || pathLocale || lang;
const activeLocale = LOCALES.includes(requestedLocale as Locale)
  ? requestedLocale as Locale
  : DEFAULT_LOCALE;
const contentLocale = LOCALES.includes(contentLang as Locale) ? contentLang : DEFAULT_LOCALE;
const currentPathWithoutLocale = Astro.url.pathname.replace(localePrefixPattern, '') || '/';
const isHomePath = currentPathWithoutLocale === '/';
const homeUrl = getLocalizedUrl('/', activeLocale);
const sectionHref = (id: string) => isHomePath ? `#${id}` : `${homeUrl}#${id}`;
const pageHref = (path: string) => {
  if (activeLocale === DEFAULT_LOCALE) return path;
  const params = new URLSearchParams();
  params.set('lang', activeLocale);
  return `${path}?${params.toString()}`;
};
const t = await useTranslations(contentLocale);
const brand = t('footer.brand', 'Racine Carrée Calculator');

const isCubiquePage = currentPathWithoutLocale.includes('racine-cubique');
const isNthRootPage = currentPathWithoutLocale.includes('nth-root');
const isCalculatorSubPage = isCubiquePage || isNthRootPage;
---

<nav class="navbar" id="navbar" aria-label="Main navigation">
    <div class="nav-container">
        <a href={isHomePath ? '#hero' : homeUrl} class="nav-logo" aria-label={brand}>
            <span class="logo-icon">√</span>
            <span class="logo-text">{brand}</span>
        </a>
        <ul class="nav-links" id="navLinks">
            <li><a href={sectionHref('hero')} class:list={['nav-link', { active: isHomePath }]} data-section="hero">{t('nav.home', 'Home')}</a></li>
            <li class="nav-dropdown">
                <button class:list={['nav-link', 'dropdown-trigger', { active: isCalculatorSubPage }]} type="button" aria-expanded="false" aria-haspopup="true">
                    {t('nav.calculators', 'Calculators')}
                    <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <ul class="dropdown-menu" role="menu">
                    <li role="none"><a href={pageHref('/racine-cubique-calculator/')} class:list={['dropdown-item', { active: isCubiquePage }]} role="menuitem">
                        Racine Cubique Calculator
                    </a></li>
                    <li role="none"><a href={pageHref('/nth-root-calculator/')} class:list={['dropdown-item', { active: isNthRootPage }]} role="menuitem">
                        Nth Root Calculator
                    </a></li>
                </ul>
            </li>
            <li><a href={pageHref('/about-us/')} class="nav-link" data-section="about">{t('nav.about', 'About Us')}</a></li>
            <li><a href={pageHref('/contact-us/')} class="nav-link" data-section="contact">{t('nav.contact', 'Contact')}</a></li>
        </ul>
        <div class="nav-actions">
            <LanguagePicker lang={activeLocale} id="header-language-picker" />
            <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Toggle dark mode">
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </button>
            <button class="nav-toggle" id="navToggle" type="button" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="navLinks">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>
</nav>

