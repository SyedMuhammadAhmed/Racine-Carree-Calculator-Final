---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getAuthorByline, getScrollHint } from '../data/i18n/commonI18n';
import { getNthContent } from '../data/i18n/content/nthContent';
import { getLocaleFaqs } from '../../theme/i18n/translations';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const { lang = 'en', faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);
const authorByline = getAuthorByline(lang);
const content = getNthContent(lang);
const ui = content.interactive;
const scrollHintText = getScrollHint(lang) || ui.scrollHint;

const fallbackFaqs = getLocaleFaqs(lang, 'nth');
const activeFaqs = (faqs && faqs.length > 0) ? faqs : fallbackFaqs;

// Benchmark table rows for degrees n = 2 through 10
const benchmarkRootsData = [
  { index: 2, radicand: 16, answer: "4", expr: "√16 = 16^(1/2)", isPerfect: true },
  { index: 2, radicand: 49, answer: "7", expr: "√49 = 49^(1/2)", isPerfect: true },
  { index: 2, radicand: 144, answer: "12", expr: "√144 = 144^(1/2)", isPerfect: true },
  { index: 3, radicand: 27, answer: "3", expr: "∛27 = 27^(1/3)", isPerfect: true },
  { index: 3, radicand: 64, answer: "4", expr: "∛64 = 64^(1/3)", isPerfect: true },
  { index: 3, radicand: 125, answer: "5", expr: "∛125 = 125^(1/3)", isPerfect: true },
  { index: 3, radicand: 1000, answer: "10", expr: "∛1000 = 1000^(1/3)", isPerfect: true },
  { index: 4, radicand: 16, answer: "2", expr: "⁴√16 = 16^(1/4)", isPerfect: true },
  { index: 4, radicand: 81, answer: "3", expr: "⁴√81 = 81^(1/4)", isPerfect: true },
  { index: 4, radicand: 256, answer: "4", expr: "⁴√256 = 256^(1/4)", isPerfect: true },
  { index: 4, radicand: 625, answer: "5", expr: "⁴√625 = 625^(1/4)", isPerfect: true },
  { index: 4, radicand: 1296, answer: "6", expr: "⁴√1296 = 1296^(1/4)", isPerfect: true },
  { index: 5, radicand: 32, answer: "2", expr: "⁵√32 = 32^(1/5)", isPerfect: true },
  { index: 5, radicand: 243, answer: "3", expr: "⁵√243 = 243^(1/5)", isPerfect: true },
  { index: 5, radicand: 1024, answer: "4", expr: "⁵√1024 = 1024^(1/5)", isPerfect: true },
  { index: 5, radicand: 3125, answer: "5", expr: "⁵√3125 = 3125^(1/5)", isPerfect: true },
  { index: 6, radicand: 64, answer: "2", expr: "⁶√64 = 64^(1/6)", isPerfect: true },
  { index: 6, radicand: 729, answer: "3", expr: "⁶√729 = 729^(1/6)", isPerfect: true },
  { index: 6, radicand: 4096, answer: "4", expr: "⁶√4096 = 4096^(1/6)", isPerfect: true },
  { index: 7, radicand: 128, answer: "2", expr: "⁷√128 = 128^(1/7)", isPerfect: true },
  { index: 7, radicand: 2187, answer: "3", expr: "⁷√2187 = 2187^(1/7)", isPerfect: true },
  { index: 8, radicand: 256, answer: "2", expr: "⁸√256 = 256^(1/8)", isPerfect: true },
  { index: 8, radicand: 6561, answer: "3", expr: "⁸√6561 = 6561^(1/8)", isPerfect: true },
  { index: 10, radicand: 1024, answer: "2", expr: "¹⁰√1024 = 1024^(1/10)", isPerfect: true },
  { index: 10, radicand: 59049, answer: "3", expr: "¹⁰√59049 = 59049^(1/10)", isPerfect: true }
];

// Quick test chips
const quickNthChips = [
  { degree: 4, value: 81, label: "⁴√81 = 3" },
  { degree: 5, value: 32, label: "⁵√32 = 2" },
  { degree: 6, value: 64, label: "⁶√64 = 2" },
  { degree: 4, value: 625, label: "⁴√625 = 5" },
  { degree: 5, value: 1024, label: "⁵√1024 = 4" },
  { degree: 3, value: -125, label: "∛(-125) = -5" },
  { degree: 8, value: 256, label: "⁸√256 = 2" },
  { degree: 10, value: 1024, label: "¹⁰√1024 = 2" }
];

// Localized simulator verdict dictionary passed to client script
const simVerdicts = {
  zero: {
    badge: ui.simZeroBadge,
    desc: ui.simZeroDesc
  },
  evenPos: {
    badge: ui.simEvenPosBadge,
    desc: ui.simEvenPosDesc
  },
  evenNeg: {
    badge: ui.simEvenNegBadge,
    desc: ui.simEvenNegDesc
  },
  oddPos: {
    badge: ui.simOddPosBadge,
    desc: ui.simOddPosDesc
  },
  oddNeg: {
    badge: ui.simOddNegBadge,
    desc: ui.simOddNegDesc
  }
};
---

<article class="seo-article" id="nth-root-article">

    <!-- Interactive Ribbon & Quick Chips -->
    <div class="article-container" style="padding-bottom: var(--space-md);">
        <div class="interactive-ribbon">
            <div class="ribbon-badges">
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    {ui.badgeArbitrary}
                </span>
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg>
                    {ui.badgeExact}
                </span>
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    {ui.badgeSteps}
                </span>
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {ui.badgeFree}
                </span>
            </div>

            <!-- Quick-Try Interactive Chips -->
            <div class="quick-try-bar">
                <span class="quick-try-label">{ui.quickTryLabel}</span>
                <div class="quick-try-chips">
                    {quickNthChips.map(chip => (
                      <button type="button" class="quick-try-chip nth-quick-chip" data-degree={chip.degree} data-value={chip.value} title={`${ui.btnTest}: ${chip.label}`}>
                        {chip.label}
                      </button>
                    ))}
                </div>
            </div>
        </div>
    </div>

    <!-- Table of Contents -->
    <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
        <TableOfContents items={content.toc} title={content.tocTitle} isOpen={false} lang={lang} />
    </div>

    <!-- Section 1: What Is an Nth Root? -->
    <section class="article-section" id="section-what-is-nth-root">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span>
                {content.s1Eyebrow}
            </div>
            <h2 class="article-h2">{content.s1Title}</h2>
            <p>
                {content.s1P1}
            </p>
            <p>
                {content.s1P2}
            </p>

            <!-- Interactive Radical Anatomy Explorer -->
            <div class="anatomy-box" id="nthRadicalAnatomy">
                <div class="anatomy-header">
                    <span class="anatomy-tag">{ui.anatomyTag}</span>
                    <span class="anatomy-hint">{ui.anatomyHint}</span>
                </div>
                <div class="anatomy-visual">
                    <span class="anatomy-part anatomy-part--degree active" data-part="degree" tabindex="0" role="button" aria-label="Index 4">⁴</span>
                    <span class="anatomy-part anatomy-part--symbol" data-part="symbol" tabindex="0" role="button" aria-label="Radical Symbol">√</span>
                    <span class="anatomy-part anatomy-part--radicand" data-part="radicand" tabindex="0" role="button" aria-label="Radicand 81">81</span>
                    <span class="anatomy-equals">=</span>
                    <span class="anatomy-part anatomy-part--root" data-part="root" tabindex="0" role="button" aria-label="Principal Root 3">3</span>
                </div>
                <div class="anatomy-cards-grid">
                    <div class="anatomy-info-card active" id="info-degree">
                        <div class="anatomy-card-title">{ui.anatomyDegree}</div>
                        <p class="anatomy-card-desc">{ui.anatomyDegreeDesc}</p>
                    </div>
                    <div class="anatomy-info-card" id="info-symbol">
                        <div class="anatomy-card-title">{ui.anatomySymbol}</div>
                        <p class="anatomy-card-desc">{ui.anatomySymbolDesc}</p>
                    </div>
                    <div class="anatomy-info-card" id="info-radicand">
                        <div class="anatomy-card-title">{ui.anatomyRadicand}</div>
                        <p class="anatomy-card-desc">{ui.anatomyRadicandDesc}</p>
                    </div>
                    <div class="anatomy-info-card" id="info-root">
                        <div class="anatomy-card-title">{ui.anatomyRoot}</div>
                        <p class="anatomy-card-desc">{ui.anatomyRootDesc}</p>
                    </div>
                </div>
            </div>

            <p style="margin-top: var(--space-md);">
                {content.s1P3}
            </p>
        </div>
    </section>

    <!-- First SVG Illustration: Anatomy & Fractional Exponents -->
    <figure class="section-image">
        <img src="/images/nth-root-radical-anatomy.svg" alt={content.s1Caption || content.s1Title} loading="lazy" decoding="async" width="800" height="440" />
        <figcaption>{content.s1Caption}</figcaption>
    </figure>

    <!-- Section 2: Formula & Fractional Exponent Equivalence -->
    <section class="article-section article-section--alt" id="section-nth-formula">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg></span>
                {content.s4Eyebrow}
            </div>
            <h2 class="article-h2">{content.s4Title}</h2>
            <p>
                {content.s4Intro}
            </p>

            <div class="math-block">
                <span class="math-formula">ⁿ√x = x^(1/n)</span>
            </div>

            <p>
                {content.s4P1}
            </p>

            <div class="math-block">
                <span class="math-formula">ⁿ√(x^m) = (ⁿ√x)^m = x^(m/n)</span>
            </div>

            <div class="law-cards">
                <div class="law-card">
                    <div class="law-header">
                        <div class="law-number">n = 2</div>
                        <div>
                            <div class="law-label">{content.s1Cards[0]?.expr || "n = 2"}</div>
                            <div class="law-subtitle">{content.s1Cards[0]?.reason || "√x"}</div>
                        </div>
                    </div>
                    <p class="law-example">√64 = 64^(1/2) = 8</p>
                </div>

                <div class="law-card">
                    <div class="law-header">
                        <div class="law-number">n = 3</div>
                        <div>
                            <div class="law-label">{content.s1Cards[1]?.expr || "n = 3"}</div>
                            <div class="law-subtitle">{content.s1Cards[1]?.reason || "∛x"}</div>
                        </div>
                    </div>
                    <p class="law-example">∛125 = 125^(1/3) = 5</p>
                </div>

                <div class="law-card">
                    <div class="law-header">
                        <div class="law-number">n = 4</div>
                        <div>
                            <div class="law-label">{content.s1Cards[2]?.expr || "n = 4"}</div>
                            <div class="law-subtitle">{content.s1Cards[2]?.reason || "⁴√x"}</div>
                        </div>
                    </div>
                    <p class="law-example">⁴√625 = 625^(1/4) = 5</p>
                </div>

                <div class="law-card">
                    <div class="law-header">
                        <div class="law-number">n = 5</div>
                        <div>
                            <div class="law-label">{content.s1Cards[3]?.expr || "n = 5"}</div>
                            <div class="law-subtitle">{content.s1Cards[3]?.reason || "⁵√x"}</div>
                        </div>
                    </div>
                    <p class="law-example">⁵√1024 = 1024^(1/5) = 4</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 3: Even vs Odd Root Rules (Interactive Simulator) -->
    <section class="article-section" id="section-nth-even-odd">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg></span>
                {content.s6Eyebrow}
            </div>
            <h2 class="article-h2">{content.s6Title}</h2>
            <p>
                {content.s6Intro}
            </p>

            <!-- Interactive Domain Simulator -->
            <div class="simulator-card" id="domainSimulator">
                <div class="simulator-header">
                    <h3 class="simulator-title">{ui.simTitle}</h3>
                    <p class="simulator-subtitle">{ui.simSubtitle}</p>
                </div>
                <div class="simulator-controls">
                    <div class="sim-control-group">
                        <span class="sim-label">{ui.simDegreeLabel}</span>
                        <div class="sim-buttons" id="simDegreeBtns">
                            <button type="button" class="sim-btn active" data-degree-type="even">{ui.simDegreeEven}</button>
                            <button type="button" class="sim-btn" data-degree-type="odd">{ui.simDegreeOdd}</button>
                        </div>
                    </div>
                    <div class="sim-control-group">
                        <span class="sim-label">{ui.simRadicandLabel}</span>
                        <div class="sim-buttons" id="simSignBtns">
                            <button type="button" class="sim-btn active" data-sign="positive">{ui.simRadicandPos}</button>
                            <button type="button" class="sim-btn" data-sign="negative">{ui.simRadicandNeg}</button>
                            <button type="button" class="sim-btn" data-sign="zero">{ui.simRadicandZero}</button>
                        </div>
                    </div>
                </div>

                <div class="sim-verdict-box" id="simVerdictBox">
                    <div class="sim-verdict-badge" id="simVerdictBadge">{ui.simEvenPosBadge}</div>
                    <h4 class="sim-verdict-expr" id="simVerdictExpr">⁴√81 = 3</h4>
                    <p class="sim-verdict-desc" id="simVerdictDesc">{ui.simEvenPosDesc}</p>
                    <button type="button" class="btn-calc-primary sim-apply-btn" id="simApplyBtn" data-degree="4" data-value="81">
                        <span>{ui.simBtnTest}</span>
                    </button>
                </div>
            </div>

            <div class="warning-box" style="margin-top: var(--space-lg);">
                <div class="warning-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                </div>
                <div class="warning-content">
                    <strong>{content.s6BoxTitle}:</strong>
                    <p>
                        {content.s6BoxText}
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Second SVG Illustration: Even vs Odd Rules -->
    <figure class="section-image">
        <img src="/images/nth-root-even-odd-rules.svg" alt={content.s6Title} loading="lazy" decoding="async" width="800" height="440" />
        <figcaption>{content.s6Intro}</figcaption>
    </figure>

    <!-- Section 4: How to Calculate an Nth Root (Methods & Stepper) -->
    <section class="article-section article-section--alt" id="section-nth-simplify">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
                {content.s2Eyebrow}
            </div>
            <h2 class="article-h2">{content.s2Title}</h2>
            <p>
                {content.s7Intro}
            </p>

            <!-- Interactive Method Switcher Tabs -->
            <div class="method-tabs-wrapper">
                <div class="method-tabs-nav" role="tablist">
                    <button type="button" class="method-tab-btn active" data-method="factorization" role="tab">{ui.method1Tab}</button>
                    <button type="button" class="method-tab-btn" data-method="calculator" role="tab">{ui.method2Tab}</button>
                    <button type="button" class="method-tab-btn" data-method="newton" role="tab">{ui.method3Tab}</button>
                </div>

                <div class="method-panels">
                    <!-- Method 1: Prime Factorization -->
                    <div class="method-panel active" id="method-panel-factorization">
                        <div class="method-badge">{ui.method1Badge}</div>
                        <h3 class="method-title">{ui.method1Title}</h3>
                        <p>
                            {content.s7Intro}
                        </p>
                        <div class="worked-example">
                            <div class="example-tag">{content.s7ExTitle}</div>
                            <ol class="example-steps">
                                <li>{content.s7Step1}</li>
                                <li>{content.s7Step2}</li>
                                <li>{content.s7Conclusion}</li>
                            </ol>
                        </div>
                    </div>

                    <!-- Method 2: Fractional Exponents -->
                    <div class="method-panel" id="method-panel-calculator">
                        <div class="method-badge">{ui.method2Badge}</div>
                        <h3 class="method-title">{ui.method2Title}</h3>
                        <p>
                            {content.s4Intro}
                        </p>
                        <div class="steps-visual">
                            {content.s2Steps.map((step, idx) => (
                                <div class="step-card">
                                    <div class="step-number">{idx + 1}</div>
                                    <div class="step-content">
                                        <h3>{step.title}</h3>
                                        <p>{step.text}</p>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Method 3: Newton-Raphson -->
                    <div class="method-panel" id="method-panel-newton">
                        <div class="method-badge">{ui.method3Badge}</div>
                        <h3 class="method-title">{ui.method3Title}</h3>
                        <p>
                            {ui.method3Desc}
                        </p>
                        <div class="math-block">
                            <span class="math-formula">x_(k+1) = (1/n) · [ (n - 1)·x_k + A / (x_k^(n-1)) ]</span>
                        </div>
                        <div class="worked-example">
                            <div class="example-tag">{ui.method3ExTitle}</div>
                            <ol class="example-steps">
                                {ui.method3Steps.map(step => (
                                    <li>{step}</li>
                                ))}
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
            <p style="margin-top: 14px; font-weight: 500;">
                Checking integer powers? <a href={localizedUrl('/perfect-square-calculator/')} style="color: var(--primary-600); font-weight: 700; text-decoration: underline;">
                    Test for perfect square prime factor exponents &rarr;
                </a>
            </p>
        </div>
    </section>

    <!-- Third SVG Illustration: Prime Factorization -->
    <figure class="section-image">
        <img src="/images/nth-root-prime-factorization.svg" alt={content.s7Title} loading="lazy" decoding="async" width="800" height="440" />
        <figcaption>{content.s7Conclusion || content.s7Intro}</figcaption>
    </figure>

    <!-- Section 5: Essential Algebraic Properties -->
    <section class="article-section" id="section-nth-notation">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17c2 0 2.8-1 2.8-2.8V10c0-2 1-3.3 3.2-3"/><path d="M9 11.2h5.7"/></svg></span>
                {content.s3Eyebrow}
            </div>
            <h2 class="article-h2">{content.s3Title}</h2>
            <p>
                {content.s3Intro}
            </p>

            <div class="examples-grid">
                {content.s3Cards.map(card => (
                    <div class="example-card">
                        <span class="example-expr">{card.expr}</span>
                        <span class="example-reason">{card.reason}</span>
                    </div>
                ))}
            </div>

