<script is:inline define:vars={{ simVerdicts }}>
  // Client-Side Interactive Script for Nth Root Calculator Page
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Quick-Try Calculation Trigger
    const triggerNthCalculation = (degree, value) => {
      const degreeInput = document.getElementById('nthDegree');
      const valueInput = document.getElementById('nthValue');
      const btn = document.getElementById('nthCalcBtn');
      if (degreeInput && valueInput && btn) {
        degreeInput.value = degree;
        valueInput.value = value;
        degreeInput.dispatchEvent(new Event('input', { bubbles: true }));
        valueInput.dispatchEvent(new Event('input', { bubbles: true }));
        degreeInput.dispatchEvent(new Event('change', { bubbles: true }));
        valueInput.dispatchEvent(new Event('change', { bubbles: true }));
        btn.click();
        const stage = document.getElementById('calculators') || degreeInput;
        stage.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };

    document.querySelectorAll('.nth-quick-chip').forEach(elem => {
      elem.addEventListener('click', (e) => {
        e.preventDefault();
        const degree = elem.getAttribute('data-degree');
        const value = elem.getAttribute('data-value');
        if (degree && value) triggerNthCalculation(degree, value);
      });
    });

    // 2. Radical Anatomy Interactive Switcher
    const anatomyParts = document.querySelectorAll('#nthRadicalAnatomy .anatomy-part');
    const anatomyCards = document.querySelectorAll('#nthRadicalAnatomy .anatomy-info-card');

    anatomyParts.forEach(part => {
      const activatePart = () => {
        const target = part.getAttribute('data-part');
        if (!target) return;
        anatomyParts.forEach(p => p.classList.remove('active'));
        part.classList.add('active');
        anatomyCards.forEach(c => {
          c.classList.remove('active');
          if (c.id === `info-${target}`) {
            c.classList.add('active');
          }
        });
      };
      part.addEventListener('click', activatePart);
      part.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activatePart();
        }
      });
    });

    // 3. Even vs Odd Domain Simulator (Localized Verdicts)
    let simDegreeType = 'even';
    let simSign = 'positive';

    const simVerdictBadge = document.getElementById('simVerdictBadge');
    const simVerdictExpr = document.getElementById('simVerdictExpr');
    const simVerdictDesc = document.getElementById('simVerdictDesc');
    const simApplyBtn = document.getElementById('simApplyBtn');

    const updateSimulatorVerdict = () => {
      if (!simVerdictBadge || !simVerdictExpr || !simVerdictDesc) return;

      if (simSign === 'zero') {
        simVerdictBadge.textContent = simVerdicts.zero.badge;
        simVerdictBadge.style.background = 'var(--primary-100)';
        simVerdictBadge.style.color = 'var(--primary-700)';
        simVerdictExpr.textContent = simDegreeType === 'even' ? '⁴√0 = 0' : '⁵√0 = 0';
        simVerdictDesc.textContent = simVerdicts.zero.desc;
        if (simApplyBtn) {
          simApplyBtn.setAttribute('data-degree', simDegreeType === 'even' ? '4' : '5');
          simApplyBtn.setAttribute('data-value', '0');
        }
        return;
      }

      if (simDegreeType === 'even') {
        if (simSign === 'positive') {
          simVerdictBadge.textContent = simVerdicts.evenPos.badge;
          simVerdictBadge.style.background = 'var(--green-100)';
          simVerdictBadge.style.color = 'var(--green-700)';
          simVerdictExpr.textContent = '⁴√81 = 3';
          simVerdictDesc.textContent = simVerdicts.evenPos.desc;
          if (simApplyBtn) {
            simApplyBtn.setAttribute('data-degree', '4');
            simApplyBtn.setAttribute('data-value', '81');
          }
        } else {
          simVerdictBadge.textContent = simVerdicts.evenNeg.badge;
          simVerdictBadge.style.background = 'var(--rose-100)';
          simVerdictBadge.style.color = 'var(--rose-700)';
          simVerdictExpr.textContent = '⁴√(-81) ∉ ℝ (±2.121 ± 2.121i)';
          simVerdictDesc.textContent = simVerdicts.evenNeg.desc;
          if (simApplyBtn) {
            simApplyBtn.setAttribute('data-degree', '4');
            simApplyBtn.setAttribute('data-value', '-81');
          }
        }
      } else {
        // Odd index
        if (simSign === 'positive') {
          simVerdictBadge.textContent = simVerdicts.oddPos.badge;
          simVerdictBadge.style.background = 'var(--green-100)';
          simVerdictBadge.style.color = 'var(--green-700)';
          simVerdictExpr.textContent = '⁵√32 = 2';
          simVerdictDesc.textContent = simVerdicts.oddPos.desc;
          if (simApplyBtn) {
            simApplyBtn.setAttribute('data-degree', '5');
            simApplyBtn.setAttribute('data-value', '32');
          }
        } else {
          simVerdictBadge.textContent = simVerdicts.oddNeg.badge;
          simVerdictBadge.style.background = 'var(--indigo-100)';
          simVerdictBadge.style.color = 'var(--indigo-700)';
          simVerdictExpr.textContent = '⁵√(-32) = -2';
          simVerdictDesc.textContent = simVerdicts.oddNeg.desc;
          if (simApplyBtn) {
            simApplyBtn.setAttribute('data-degree', '5');
            simApplyBtn.setAttribute('data-value', '-32');
          }
        }
      }
    };

    document.querySelectorAll('#simDegreeBtns .sim-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#simDegreeBtns .sim-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        simDegreeType = btn.getAttribute('data-degree-type') || 'even';
        updateSimulatorVerdict();
      });
    });

    document.querySelectorAll('#simSignBtns .sim-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#simSignBtns .sim-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        simSign = btn.getAttribute('data-sign') || 'positive';
        updateSimulatorVerdict();
      });
    });

    if (simApplyBtn) {
      simApplyBtn.addEventListener('click', () => {
        const d = simApplyBtn.getAttribute('data-degree');
        const v = simApplyBtn.getAttribute('data-value');
        if (d && v) triggerNthCalculation(d, v);
      });
    }

    // 4. Method Switcher Tabs
    const methodTabs = document.querySelectorAll('.method-tab-btn');
    const methodPanels = document.querySelectorAll('.method-panel');

    methodTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const method = tab.getAttribute('data-method');
        if (!method) return;
        methodTabs.forEach(t => t.classList.remove('active'));
        methodPanels.forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        const activePanel = document.getElementById(`method-panel-${method}`);
        if (activePanel) activePanel.classList.add('active');
      });
    });

    // 5. Benchmark Reference Table Degree Filter
    const filterPills = document.querySelectorAll('#tableDegreeFilter .filter-pill');
    const tableRows = document.querySelectorAll('#nthBenchmarkTable tbody tr');

    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const filterVal = pill.getAttribute('data-filter');

        tableRows.forEach(row => {
          const rowDegree = row.getAttribute('data-degree');
          if (filterVal === 'all' || rowDegree === filterVal) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      });
    });
  });
</script>

