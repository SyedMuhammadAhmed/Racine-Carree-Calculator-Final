---
import { useTranslations } from '../../theme/i18n/translations';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await useTranslations(lang);
---

<div class="interactive-diagram-container" id="fractionDiagramContainer">
  <div class="diagram-header">
    <h3 class="diagram-title">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="title-icon"><line x1="4" y1="12" x2="20" y2="12"/><circle cx="12" cy="5" r="2"/><circle cx="12" cy="19" r="2"/></svg>
      {t('diagram.fraction.title', 'Interactive Geometry: The Quotient Rule')}
    </h3>
    <div class="diagram-controls" role="group" aria-label="Toggle diagram mode">
      <button class="diagram-toggle active" data-mode="combined" type="button">
        Combined Root
      </button>
      <button class="diagram-toggle" data-mode="split" type="button">
        Split Roots
      </button>
    </div>
  </div>

  <div class="diagram-stage">
    <!-- SVG Canvas -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200" class="geom-svg">
      
      <!-- Group: Combined Root (Active) -->
      <g id="combinedGroup" class="geom-group active">
        <!-- Radical Symbol -->
        <path d="M 100 110 L 115 110 L 130 140 L 150 60 L 210 60" fill="none" stroke="var(--primary-500)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
        
        <!-- Fraction Line -->
        <line x1="160" y1="105" x2="200" y2="105" stroke="var(--text-main)" stroke-width="3" stroke-linecap="round"/>
        
        <!-- Variables -->
        <text x="180" y="90" class="svg-text-large primary-text-svg">a</text>
        <text x="180" y="140" class="svg-text-large primary-text-svg">b</text>
      </g>

      <!-- Group: Split Roots (Hidden) -->
      <g id="splitGroup" class="geom-group hidden">
        <!-- Main Fraction Line -->
        <line x1="100" y1="105" x2="210" y2="105" stroke="var(--text-main)" stroke-width="3" stroke-linecap="round"/>
        
        <!-- Top Radical (Numerator) -->
        <path d="M 120 70 L 130 70 L 140 85 L 150 40 L 190 40" fill="none" stroke="var(--accent-500)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        <text x="170" y="70" class="svg-text-large accent-text-svg">a</text>
        
        <!-- Bottom Radical (Denominator) -->
        <path d="M 120 150 L 130 150 L 140 165 L 150 120 L 190 120" fill="none" stroke="var(--accent-500)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        <text x="170" y="150" class="svg-text-large accent-text-svg">b</text>
      </g>
      
    </svg>
  </div>

  <div class="diagram-info">
    <div id="infoCombined" class="info-card active">
      <div class="info-formula primary-text">√(a / b)</div>
      <p class="info-desc">
        A square root applied to an entire fraction means you are finding the root of the quotient as a single number.
      </p>
    </div>
    <div id="infoSplit" class="info-card hidden">
      <div class="info-formula accent-text">√a / √b</div>
      <p class="info-desc">
        The Quotient Rule states you can split the root across the numerator and denominator perfectly. This makes simplifying fractions much easier!
      </p>
    </div>
  </div>
</div>

<style>
  .interactive-diagram-container {
    background: var(--bg-card);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-default);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    margin: var(--space-xl) 0;
    font-family: var(--font-sans);
    transition: box-shadow var(--duration-normal) var(--ease-out);
  }
  
  .interactive-diagram-container:hover {
    box-shadow: var(--shadow-md);
  }

  .diagram-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-glass-strong);
  }

  .diagram-title {
    color: var(--text-main);
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .title-icon {
    color: var(--primary-500);
  }

  .diagram-controls {
    display: flex;
    gap: 4px;
    background: var(--bg-subtle);
    padding: 4px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .diagram-toggle {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 6px 14px;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .diagram-toggle.active {
    background: var(--bg-card);
    color: var(--primary-500);
    box-shadow: var(--shadow-sm);
  }
  
  [data-mode="split"].active {
    color: var(--accent-500);
  }

  .diagram-stage {
    width: 100%;
    height: 250px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--bg-body);
    background-image: radial-gradient(var(--border-subtle) 1px, transparent 1px);
    background-size: 20px 20px;
    position: relative;
  }

  .geom-svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
  }

  .primary-text-svg { fill: var(--primary-500); }
  .accent-text-svg { fill: var(--accent-500); }
  
  .primary-text { color: var(--primary-500); }
  .accent-text { color: var(--accent-500); }
  
  .svg-text-large {
    font-size: 32px;
    font-weight: 800;
    text-anchor: middle;
    font-family: var(--font-mono);
  }

  .geom-group {
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  .geom-group.hidden {
    opacity: 0;
    transform: scale(0.9);
    pointer-events: none;
  }

  .geom-group.active {
    opacity: 1;
    transform: scale(1);
  }

  .diagram-info {
    padding: var(--space-lg);
    background: var(--bg-card);
    border-top: 1px solid var(--border-subtle);
    min-height: 140px;
  }

  .info-card {
    display: none;
    text-align: center;
  }

  .info-card.active {
    display: block;
    animation: fadeIn 0.4s ease;
  }

  .info-formula {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    margin-bottom: var(--space-sm);
  }

  .info-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 650px;
    margin: 0 auto;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .diagram-header {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
    .diagram-stage {
      height: 200px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('fractionDiagramContainer');
    if (!container) return;

    const toggles = container.querySelectorAll('.diagram-toggle');
    const combinedGroup = document.getElementById('combinedGroup');
    const splitGroup = document.getElementById('splitGroup');
    const infoCombined = document.getElementById('infoCombined');
    const infoSplit = document.getElementById('infoSplit');

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        toggles.forEach(t => t.classList.remove('active'));
        toggle.classList.add('active');

        const mode = toggle.getAttribute('data-mode');
        
        if (mode === 'combined') {
          combinedGroup.classList.replace('hidden', 'active');
          splitGroup.classList.replace('active', 'hidden');
          infoCombined.classList.replace('hidden', 'active');
          infoSplit.classList.replace('active', 'hidden');
        } else {
          splitGroup.classList.replace('hidden', 'active');
          combinedGroup.classList.replace('active', 'hidden');
          infoSplit.classList.replace('hidden', 'active');
          infoCombined.classList.replace('active', 'hidden');
        }
      });
    });
  });
</script>
