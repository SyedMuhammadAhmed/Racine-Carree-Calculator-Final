---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getHomeContent } from '../data/i18n/content/homeContent';
import { getAuthorByline } from '../data/i18n/commonI18n';
import {
  REFERENCE_TABLE_50,
  PERFECT_SQUARES_20,
  SIMPLIFICATION_11,
  IRRATIONAL_EXAMPLES,
  DECIMAL_EXAMPLES,
  FRACTION_EXAMPLES,
  NEGATIVE_EXAMPLES
} from '../data/sqrtData';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}

const { lang = DEFAULT_LOCALE, faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getHomeContent(lang);
const authorByline = getAuthorByline(lang);
const displayFaqs = (faqs && faqs.length > 0) ? faqs : content.faqs;
---

<article class="seo-article" id="what-is-racine">

    <!-- Interactive Hero Feature Ribbon -->
    <div class="article-container" style="padding-bottom: var(--space-md);">
        <div class="interactive-ribbon">
            <div class="ribbon-badges">
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    {content.badgeInstant}
                </span>
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg>
                    {content.badgeRadical}
                </span>
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    {content.badgeSteps}
                </span>
                <span class="ribbon-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {content.badgeFree}
                </span>
            </div>

            <!-- Quick-Try Interactive Chips -->
            <div class="quick-try-bar">
                <span class="quick-try-label">{content.quickTryLabel}</span>
                <div class="quick-try-chips">
                    <button type="button" class="quick-try-chip" data-num="144" title="Test √144 in calculator">√144 = 12</button>
                    <button type="button" class="quick-try-chip" data-num="72" title="Test √72 in calculator">√72 = 6√2</button>
                    <button type="button" class="quick-try-chip" data-num="50" title="Test √50 in calculator">√50 ≈ 7.07</button>
                    <button type="button" class="quick-try-chip" data-num="0.25" title="Test √0.25 in calculator">√0.25 = 0.5</button>
                    <button type="button" class="quick-try-chip" data-num="-16" title="Test √(-16) in calculator">√(-16) = 4i</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table of Contents -->
    <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
        <TableOfContents items={content.toc} title={content.tocTitle} isOpen={false} lang={lang} />
    </div>

    <!-- Section 1: What Is Racine Carrée (Square Root)? -->
    <section class="article-section" id="section-what-is-square-root">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </span>
                {content.s1Eyebrow}
            </div>
            <h2 class="article-h2">{content.s1Title}</h2>
            <p>{content.s1P1}</p>
            <p>{content.s1P2}</p>
            <p>{content.s1P3}</p>

            <!-- Interactive Anatomy Card -->
            <div class="anatomy-box" id="radicalAnatomy">
                <div class="anatomy-header">
                    <span class="anatomy-tag">{content.s1AnatomyTitle}</span>
                    <span class="anatomy-hint">Click or hover over any part</span>
                </div>
                <div class="anatomy-visual">
                    <span class="anatomy-part anatomy-part--symbol" data-part="symbol" tabindex="0" role="button" aria-label="Radical Symbol">√</span>
                    <span class="anatomy-part anatomy-part--radicand" data-part="radicand" tabindex="0" role="button" aria-label="Radicand">49</span>
                    <span class="anatomy-equals">=</span>
                    <span class="anatomy-part anatomy-part--root" data-part="root" tabindex="0" role="button" aria-label="Root Result">7</span>
                </div>
                <div class="anatomy-cards-grid">
                    <div class="anatomy-info-card active" id="info-symbol">
                        <span class="anatomy-info-badge">√</span>
                        <div>
                            <strong>{content.s1RadicalSymbol}</strong>
                            <p>{content.s1RadicalSymbolDesc}</p>
                        </div>
                    </div>
                    <div class="anatomy-info-card" id="info-radicand">
                        <span class="anatomy-info-badge">49</span>
                        <div>
                            <strong>{content.s1Radicand}</strong>
                            <p>{content.s1RadicandDesc}</p>
                        </div>
                    </div>
                    <div class="anatomy-info-card" id="info-root">
                        <span class="anatomy-info-badge">7</span>
                        <div>
                            <strong>{content.s1Root}</strong>
                            <p>{content.s1RootDesc}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Basic Examples Grid -->
            <div class="examples-grid">
                {content.s1Cards.map(card => (
                  <div class="example-card">
                      <span class="example-expr">{card.expr}</span>
                      <span class="example-reason">{card.reason}</span>
                  </div>
                ))}
            </div>
        </div>
    </section>

    <figure class="section-image">
        <img src="/images/sqrt-geometric-concept.svg" alt={content.s1Caption} loading="lazy" decoding="async" fetchpriority="low" width="800" height="450">
        <figcaption>{content.s1Caption}</figcaption>
    </figure>

    <!-- Section 2: How to Use the Racine Carree Calculator -->
    <section class="article-section article-section--alt" id="section-how-to-use">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </span>
                {content.s2Eyebrow}
            </div>
            <h2 class="article-h2">{content.s2Title}</h2>
            <p>{content.s2Intro}</p>

            <div class="steps-visual">
                {content.s2Steps.map((step, idx) => (
                  <div class="step-card" id={`step-${idx === 0 ? 'input' : idx === 1 ? 'calc' : 'result'}`}>
                      <div class="step-number">{idx + 1}</div>
                      <div class="step-content">
                          <h3>{step.title}</h3>
                          <p>{step.text}</p>
                      </div>
                  </div>
                ))}
            </div>
            <p class="reassurance-note">{content.s2Conclusion}</p>
        </div>
    </section>

    <!-- Section 3: Square Root Notation: The √ Symbol and x^(1/2) -->
    <section class="article-section" id="section-notation">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17c2 0 2.8-1 2.8-2.8V10c0-2 1-3.3 3.2-3"/><path d="M9 11.2h5.7"/></svg>
                </span>
                {content.s3Eyebrow}
            </div>
            <h2 class="article-h2">{content.s3Title}</h2>
            <p>{content.s3Intro}</p>

            <div class="examples-grid">
                {content.s3Cards.map(card => (
                  <div class="example-card">
                      <span class="example-expr">{card.expr}</span>
                      <span class="example-reason">{card.reason}</span>
                  </div>
                ))}
            </div>

            <p>{content.s3P1}</p>
            <p>{content.s3P2}</p>

            <!-- Interactive Notation Mode Switcher -->
            <div class="interactive-notation-switcher">
                <div class="notation-tabs" role="tablist">
                    <button type="button" class="notation-tab active" data-format="radical">{content.s3ToggleRadical}</button>
                    <button type="button" class="notation-tab" data-format="exponent">{content.s3ToggleExponent}</button>
                    <button type="button" class="notation-tab" data-format="code">{content.s3ToggleCode}</button>
                </div>
                <div class="notation-display">
                    <div class="notation-view active" id="view-radical">
                        <span class="math-formula">√x = y &nbsp;&Longleftrightarrow&nbsp; y² = x</span>
                        <span class="view-desc">Standard mathematical radical sign</span>
                    </div>
                    <div class="notation-view" id="view-exponent">
                        <span class="math-formula">x^(1/2) = √x &nbsp;&Longleftrightarrow&nbsp; 49^(1/2) = 7</span>
                        <span class="view-desc">Fractional power notation used in advanced algebra</span>
                    </div>
                    <div class="notation-view" id="view-code">
                        <span class="math-formula">Math.sqrt(x) /* JavaScript */ &nbsp;|&nbsp; x ** 0.5 /* Python */</span>
                        <span class="view-desc">Syntax used in programming and scientific calculators</span>
                    </div>
                </div>
            </div>

            <p>{content.s3P3}</p>
        </div>
    </section>

    <figure class="section-image">
        <img src="/images/sqrt-radical-anatomy.svg" alt={content.s3Caption} loading="lazy" decoding="async" fetchpriority="low" width="800" height="420">
        <figcaption>{content.s3Caption}</figcaption>
    </figure>

    <!-- Section 4: What Is the Square Root Formula? -->
    <section class="article-section article-section--alt" id="section-formula">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
                </span>
                {content.s4Eyebrow}
            </div>
            <h2 class="article-h2">{content.s4Title}</h2>
            <p>{content.s4Intro}</p>

            <div class="math-block">
                <span class="math-formula">If y = √x, then y × y = x &nbsp;(or y² = x)</span>
            </div>

            <p>{content.s4P1}</p>

            <!-- Principal Root Callout Box -->
            <div class="principal-root-card">
                <div class="principal-root-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                    <h3>{content.s4PrincipalTitle}</h3>
                </div>
                <p>{content.s4PrincipalText}</p>
                <div class="principal-comparison">
                    <div class="comparison-pill positive">
                        <span class="pill-label">Principal Root</span>
                        <code>√25 = +5</code>
                    </div>
                    <div class="comparison-pill negative">
                        <span class="pill-label">Dual Algebraic Solutions</span>
                        <code>x² = 25 &rArr; x = &plusmn;5</code>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 5: Five Essential Properties of Square Roots -->
    <section class="article-section" id="section-laws">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </span>
                {content.s5Eyebrow}
            </div>
            <h2 class="article-h2">{content.s5Title}</h2>
            <p>{content.s5Intro}</p>

            <div class="law-cards">
                {content.s5Laws.map((law, idx) => (
                  <div class="law-card">
                      <div class="law-header">
                        <div class="law-number">{idx + 1}</div>
                        <div>
                          <div class="law-label">{law.name}</div>
                          <div class="law-subtitle">{law.subtitle}</div>
                        </div>
                        <button type="button" class="btn-copy-formula" data-formula={law.subtitle} title="Copy formula">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        </button>
                      </div>
                      <div class="math-block">
                        <span class="math-formula">
                          {idx === 0 && '√(a × b) = √a × √b'}
                          {idx === 1 && '√(a ÷ b) = √a ÷ √b'}
                          {idx === 2 && '√(a²) = |a|'}
                          {idx === 3 && '√a × √a = a'}
                          {idx === 4 && '√(√a) = a^(1/4)'}
                        </span>
                      </div>
                      <p class="law-example"><strong>{law.example}</strong></p>
                      <p class="law-explanation">{law.explanation}</p>
                  </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Section 6: How to Calculate Square Root: Four Methods -->
    <section class="article-section article-section--alt" id="section-methods">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                </span>
                {content.s6Eyebrow}
            </div>
            <h2 class="article-h2">{content.s6Title}</h2>
            <p>{content.s6Intro}</p>

            <!-- Interactive Method Tabs Switcher -->
            <div class="method-interactive-tabs">
                <div class="method-tabs-nav" role="tablist">
                    <button type="button" class="method-tab-btn active" data-method="m1">
                        <span class="tab-badge">1</span>
                        <span>{content.s6M1Title.split(':')[0]}</span>
                    </button>
                    <button type="button" class="method-tab-btn" data-method="m2">
                        <span class="tab-badge">2</span>
                        <span>{content.s6M2Title.split(':')[0]}</span>
                    </button>
                    <button type="button" class="method-tab-btn" data-method="m3">
                        <span class="tab-badge">3</span>
                        <span>{content.s6M3Title.split(':')[0]}</span>
                    </button>
                    <button type="button" class="method-tab-btn" data-method="m4">
                        <span class="tab-badge">4</span>
                        <span>{content.s6M4Title.split(':')[0]}</span>
                    </button>
                </div>

                <!-- Method 1 Content -->
                <div class="method-panel active" id="method-panel-m1">
                    <h3 class="article-h3" id="method-calculator">{content.s6M1Title}</h3>
                    <p>{content.s6M1Text}</p>
                    <div style="margin-top: 16px;">
                        <a href="#hero" class="btn-calc-action">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
                            {content.s6M1Action}
                        </a>
                    </div>
                </div>

                <!-- Method 2 Content -->
                <div class="method-panel" id="method-panel-m2">
                    <h3 class="article-h3" id="method-factorization">{content.s6M2Title}</h3>
                    <p>{content.s6M2Intro}</p>
                    <div class="method-example">
                        <div class="method-title">{content.s6M2ExTitle}</div>
                        <ul class="method-steps-list">
                            {content.s6M2Steps.map(step => (
                              <li>{step}</li>
                            ))}
                        </ul>
                        <div class="factorization-cards">
                            <div class="factor-demo-box">
                                <span class="demo-target">√144</span>
                                <span class="demo-arrow">&rarr;</span>
                                <span class="demo-calc">2 &times; 2 &times; 2 &times; 2 &times; 3 &times; 3 &rarr; (2&times;2) &times; (2&times;2) &times; (3&times;3) &rarr; 2 &times; 2 &times; 3 = <strong>12</strong></span>
                            </div>
                            <div class="factor-demo-box">
                                <span class="demo-target">√72</span>
                                <span class="demo-arrow">&rarr;</span>
                                <span class="demo-calc">2 &times; 2 &times; 2 &times; 3 &times; 3 &rarr; 6 stays outside, 2 stays inside &rarr; <strong>6√2</strong> (&approx;8.485)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Method 3 Content -->
                <div class="method-panel" id="method-panel-m3">
                    <h3 class="article-h3" id="method-division">{content.s6M3Title}</h3>
                    <p>{content.s6M3Intro}</p>
                    <div class="method-example">
                        <ul class="method-steps-list">
                            {content.s6M3Steps.map(step => (
                              <li>{step}</li>
                            ))}
                        </ul>
                    </div>
                    <p style="margin-top: 12px;">{content.s6M3Text}</p>
                </div>

                <!-- Method 4 Content -->
                <div class="method-panel" id="method-panel-m4">
                    <h3 class="article-h3" id="method-estimation">{content.s6M4Title}</h3>
                    <p>{content.s6M4Intro}</p>
                    <div class="method-example">
                        <div class="method-title">{content.s6M4ExTitle}</div>
                        <ul class="method-steps-list">
                            {content.s6M4Steps.map(step => (
                              <li>{step}</li>
                            ))}
                        </ul>
                    </div>
                    <p class="reassurance-note" style="margin-top: 12px;">{content.s6M4Note}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 7: Perfect Squares: What They Are and Why They Matter -->
    <section class="article-section" id="section-perfect-squares">
        <div class="article-container">
            <div class="section-eyebrow">
                <span class="eyebrow-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg>
                </span>
                {content.s7Eyebrow}
            </div>
            <h2 class="article-h2">{content.s7Title}</h2>
            <p>{content.s7Intro}</p>

            <div class="table-scroll-wrapper">
                <table class="data-table data-table--compact">
                    <thead>
                        <tr>
                            <th>{content.s7ThNumber}</th>
                            <th>{content.s7ThSquare}</th>
                            <th>{content.s7ThRoot}</th>
                            <th>{content.s7ThNumber}</th>
                            <th>{content.s7ThSquare}</th>
                            <th>{content.s7ThRoot}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {Array.from({ length: 10 }).map((_, i) => {
                          const r1 = PERFECT_SQUARES_20[i];
                          const r2 = PERFECT_SQUARES_20[i + 10];
                          return (
                            <tr>
                                <td><strong>{r1.n}</strong></td>
                                <td><span class="badge-perfect">{r1.square}</span></td>
                                <td>√{r1.square} = {r1.root}</td>
                                <td><strong>{r2.n}</strong></td>
                                <td><span class="badge-perfect">{r2.square}</span></td>
                                <td>√{r2.square} = {r2.root}</td>
                            </tr>
                          );
                        })}
                    </tbody>
                </table>
            </div>
            <p style="margin-top: 14px; font-weight: 500;">
                {content.s7Conclusion}
                &nbsp;Want to test any specific number? <a href={localizedUrl('/perfect-square-calculator/')} style="color: var(--primary-600); font-weight: 700; text-decoration: underline;">
                    Check if any number is a perfect square using our checker &rarr;
                </a>
            </p>
        </div>
    </section>

    <figure class="section-image">
        <img src="/images/sqrt-perfect-squares-grid.svg" alt={content.s7Caption} loading="lazy" decoding="async" fetchpriority="low" width="800" height="420">
        <figcaption>{content.s7Caption}</figcaption>
    </figure>

    <!-- Section 8: Non-Perfect Squares and Irrational Numbers -->
