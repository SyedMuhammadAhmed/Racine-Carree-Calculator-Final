    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-glass);
  }

  .btn-test-calc {
    background: var(--bg-glass-strong);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    color: var(--primary-600);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-test-calc:hover {
    background: var(--primary-500);
    color: #fff;
  }

  /* --- Recap Summary Card --- */
  .recap-summary-card {
    background: var(--bg-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
    margin-top: var(--space-lg);
  }

  .recap-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--space-md);
  }

  .recap-star-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--gradient-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .recap-header h3 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--text-heading);
  }

  .recap-body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: var(--space-lg);
  }

  .recap-bullets {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px dashed var(--border-light);
    padding-top: var(--space-md);
  }

  .recap-bullet {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--text-heading);
  }

  .recap-bullet-icon {
    color: #10b981;
    font-weight: 900;
    font-size: 1.1rem;
    line-height: 1;
  }

  .reassurance-note {
    font-style: italic;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: var(--space-md);
  }

  .faq-chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
    color: var(--text-muted);
  }

  details[open] .faq-chevron {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
(function() {
  function initContentInteractions() {
    // 1. Quick-try chips & Table test buttons: Send values to calculator
    const quickChips = document.querySelectorAll('.quick-try-chip, .btn-test-calc');
    quickChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const num = chip.getAttribute('data-num');
        if (!num) return;
        
        const calcInput = document.getElementById('sqrtInput') || document.querySelector('#calculator-section input[type="number"], .calculator-card input');
        const calcBtn = document.getElementById('sqrtCalcBtn') || document.querySelector('#calculator-section button[type="submit"], .calculator-card button[type="submit"], .calc-submit-btn');
        
        if (calcInput) {
          calcInput.value = num;
          calcInput.dispatchEvent(new Event('input', { bubbles: true }));
          calcInput.dispatchEvent(new Event('change', { bubbles: true }));
          
          if (calcBtn) {
            calcBtn.click();
          }
          
          // Smooth scroll to calculator
          const targetSection = document.getElementById('calculator-section') || document.getElementById('hero') || calcInput;
          const headerOffset = 80;
          const elementPosition = targetSection.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
          
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
          
          calcInput.focus();
        }
      });
    });

    // 2. Radical Anatomy Interactive Inspector
    const anatomyParts = document.querySelectorAll('.anatomy-part');
    const anatomyCards = document.querySelectorAll('.anatomy-info-card');
    
    function activateAnatomyPart(partName) {
      anatomyParts.forEach(p => {
        if (p.getAttribute('data-part') === partName) {
          p.classList.add('active');
        } else {
          p.classList.remove('active');
        }
      });
      anatomyCards.forEach(c => {
        if (c.id === 'info-' + partName) {
          c.classList.add('active');
        } else {
          c.classList.remove('active');
        }
      });
    }

    anatomyParts.forEach(part => {
      const partName = part.getAttribute('data-part');
      part.addEventListener('mouseenter', () => activateAnatomyPart(partName));
      part.addEventListener('click', () => activateAnatomyPart(partName));
      part.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activateAnatomyPart(partName);
        }
      });
    });

    anatomyCards.forEach(card => {
      const partName = card.id.replace('info-', '');
      card.addEventListener('click', () => activateAnatomyPart(partName));
    });

    // 3. Notation Mode Switcher
    const notationTabs = document.querySelectorAll('.notation-tab');
    const notationViews = document.querySelectorAll('.notation-view');
    
    notationTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const format = tab.getAttribute('data-format');
        notationTabs.forEach(t => t.classList.toggle('active', t === tab));
        notationViews.forEach(v => {
          v.classList.toggle('active', v.id === 'view-' + format);
        });
      });
    });

    // 4. Method Tabs (Section 6)
    const methodTabs = document.querySelectorAll('.method-tab-btn');
    const methodPanels = document.querySelectorAll('.method-panel');
    
    methodTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const method = tab.getAttribute('data-method');
        methodTabs.forEach(t => t.classList.toggle('active', t === tab));
        methodPanels.forEach(p => {
          p.classList.toggle('active', p.id === 'method-panel-' + method);
        });
      });
    });

    // 5. 1 to 50 Reference Table Filter & Search
    const refTable = document.getElementById('refTable50');
    const searchInput = document.getElementById('sqrtTableSearch');
    const filterPills = document.querySelectorAll('.tbl-filter-pill');
    
    if (refTable) {
      let currentFilter = 'all';
      let currentQuery = '';
      const rows = Array.from(refTable.querySelectorAll('tbody tr'));
      
      function updateTableFilter() {
        rows.forEach(row => {
          const isPerfect = row.getAttribute('data-perfect') === 'true';
          const num = row.getAttribute('data-num') || '';
          const root = (row.getAttribute('data-root') || '').toLowerCase();
          const simp = (row.getAttribute('data-simp') || '').toLowerCase();
          
          let matchesFilter = true;
          if (currentFilter === 'perfect') {
            matchesFilter = isPerfect;
          } else if (currentFilter === 'irrational') {
            matchesFilter = !isPerfect;
          }
          
          let matchesSearch = true;
          if (currentQuery) {
            matchesSearch = num.includes(currentQuery) || root.includes(currentQuery) || simp.includes(currentQuery);
          }
          
          row.style.display = (matchesFilter && matchesSearch) ? '' : 'none';
        });
      }

      filterPills.forEach(pill => {
        pill.addEventListener('click', () => {
          filterPills.forEach(p => p.classList.toggle('active', p === pill));
          currentFilter = pill.getAttribute('data-filter') || 'all';
          updateTableFilter();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target.value || '').trim().toLowerCase();
          updateTableFilter();
        });
      }
    }

    // 6. Interactive Math Formula Copy
    const copyButtons = document.querySelectorAll('.btn-copy-formula');
    copyButtons.forEach(btn => {
      btn.addEventListener('click', async () => {
        const formula = btn.getAttribute('data-formula') || btn.parentElement?.textContent?.trim() || '';
        try {
          await navigator.clipboard.writeText(formula);
          const origText = btn.innerHTML;
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.innerHTML = origText;
            btn.classList.remove('copied');
          }, 2000);
        } catch (err) {
          console.warn('Clipboard copy failed:', err);
        }
      });
    });
  }

  // Initialize on DOM load and Astro page swaps
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContentInteractions);
  } else {
    initContentInteractions();
  }
  document.addEventListener('astro:page-load', initContentInteractions);
})();
</script>
