                <h3 class="article-h3">Calculator Features Comparison</h3>
                <div class="table-scroll-wrapper">
                    <div class="table-scroll-hint">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8L22 12L18 16"/><path d="M6 8L2 12L6 16"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
                        Scroll horizontally to see all columns →
                    </div>
                    <table class="data-table">
                        <thead><tr><th>Feature</th><th>Our Calculator</th></tr></thead>
                        <tbody>
                            <tr><td>Square root + cube root in one tool</td><td class="cell-check">✅</td></tr>
                            <tr><td>Simplified radical form</td><td class="cell-check">✅</td></tr>
                            <tr><td>Step-by-step Newton-Raphson display</td><td class="cell-check">✅</td></tr>
                            <tr><td>Negative number support</td><td class="cell-check">✅</td></tr>
                            <tr><td>Precision up to 10 decimal places</td><td class="cell-check">✅</td></tr>
