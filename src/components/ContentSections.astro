---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getHomeContent } from '../data/i18n/content/homeContent';
import { getAuthorByline } from '../data/i18n/commonI18n';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}
const { lang = DEFAULT_LOCALE, faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getHomeContent(lang);
const authorByline = getAuthorByline(lang);

const table100Rows = Array.from({ length: 100 }, (_, i) => {
  const n = i + 1;
  const root = Math.sqrt(n);
  const isPerfect = Number.isInteger(root);
  return {
    n,
    rootFormatted: root.toFixed(3),
    isPerfect
  };
});

const perfectSquaresList = [
  { n1: 1, sq1: 1, n2: 11, sq2: 121 },
  { n1: 2, sq1: 4, n2: 12, sq2: 144 },
  { n1: 3, sq1: 9, n2: 13, sq2: 169 },
  { n1: 4, sq1: 16, n2: 14, sq2: 196 },
  { n1: 5, sq1: 25, n2: 15, sq2: 225 },
  { n1: 6, sq1: 36, n2: 16, sq2: 256 },
  { n1: 7, sq1: 49, n2: 17, sq2: 289 },
  { n1: 8, sq1: 64, n2: 18, sq2: 324 },
  { n1: 9, sq1: 81, n2: 19, sq2: 361 },
  { n1: 10, sq1: 100, n2: 20, sq2: 400 },
];
---

<article class="seo-article" id="what-is-racine">

        <!-- Table of Contents -->
        <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
            <TableOfContents items={content.toc} title={content.tocTitle} isOpen={false} lang={lang} />
        </div>

        <!-- Section 1: What Is Racine Carrée -->
        <section class="article-section" id="section-what-is-square-root">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span> {content.s1Eyebrow}</div>
                <h2 class="article-h2">{content.s1Title}</h2>
                <p>{content.s1P1}</p>
                <p>
                  {content.s1P2}
                  &nbsp;<a href={localizedUrl('/racine-cubique-calculator/')} style="color: var(--primary-500); font-weight: 600;">{content.s9ThCube}</a>,
                  &nbsp;<a href={localizedUrl('/nth-root-calculator/')} style="color: var(--primary-500); font-weight: 600;">ⁿ√x</a>.
                </p>
                <p>{content.s1P3}</p>

                <div class="examples-grid">
                    {content.s1Cards.map(card => (
                      <div class="example-card">
                          <span class="example-expr">{card.expr}</span>
                          <span class="example-reason">{card.reason}</span>
                      </div>
                    ))}
                </div>
            </div>
        </section>

        <figure class="section-image">
            <img src="/images/sqrt-concept.webp" alt={content.s1Caption} loading="lazy" decoding="async" fetchpriority="low" sizes="(max-width: 840px) 100vw, 800px" width="800" height="448">
            <figcaption>{content.s1Caption}</figcaption>
        </figure>

        <!-- Section 2: How to Use the Calculator -->
        <section class="article-section article-section--alt" id="section-how-to-use">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span> {content.s2Eyebrow}</div>
                <h2 class="article-h2">{content.s2Title}</h2>
                <p>{content.s2Intro}</p>
                <div class="steps-visual">
                    {content.s2Steps.map((step, idx) => (
                      <div class="step-card" id={`step-${idx === 0 ? 'input' : idx === 1 ? 'calc' : 'result'}`}>
                          <div class="step-number">{idx + 1}</div>
                          <div class="step-content">
                              <h3>{step.title}</h3>
                              <p>{step.text}</p>
                          </div>
                      </div>
                    ))}
                </div>
                <p>{content.s2Conclusion}</p>
            </div>
        </section>

        <!-- Section 3: Notation -->
        <section class="article-section" id="section-notation">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17c2 0 2.8-1 2.8-2.8V10c0-2 1-3.3 3.2-3"/><path d="M9 11.2h5.7"/></svg></span> {content.s3Eyebrow}</div>
                <h2 class="article-h2">{content.s3Title}</h2>
                <p>{content.s3Intro}</p>
                <div class="examples-grid">
                    {content.s3Cards.map(card => (
                      <div class="example-card">
                          <span class="example-expr">{card.expr}</span>
                          <span class="example-reason">{card.reason}</span>
                      </div>
                    ))}
                </div>
                <p>{content.s3P1}</p>
                <p>{content.s3P2}</p>
                <div class="math-block"><span class="math-formula">x^(1/2) = √x</span></div>
                <p>{content.s3P3}</p>
            </div>
        </section>

        <figure class="section-image">
            <img src="/images/sqrt-notation.webp" alt={content.s3Caption} loading="lazy" decoding="async" fetchpriority="low" sizes="(max-width: 840px) 100vw, 800px" width="800" height="448">
            <figcaption>{content.s3Caption}</figcaption>
        </figure>

        <!-- Section 4: Formula -->
        <section class="article-section article-section--alt" id="section-formula">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg></span> {content.s4Eyebrow}</div>
                <h2 class="article-h2">{content.s4Title}</h2>
                <p>{content.s4Intro}</p>
                <div class="math-block"><span class="math-formula">If x = √y, then x × x = y (or x² = y)</span></div>
                <p>{content.s4P1}</p>
            </div>
        </section>

        <!-- Section 5: Five Core Laws -->
        <section class="article-section" id="section-laws">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span> {content.s5Eyebrow}</div>
                <h2 class="article-h2">{content.s5Title}</h2>
                <p>{content.s5Intro}</p>
                <div class="law-cards">
                    {content.s5Laws.map((law, idx) => (
                      <div class="law-card">
                          <div class="law-header">
                            <div class="law-number">{idx + 1}</div>
                            <div>
                              <div class="law-label">{law.name}</div>
                              <div class="law-subtitle">{law.subtitle}</div>
                            </div>
                          </div>
                          <div class="math-block">
                            <span class="math-formula">
                              {idx === 0 && '√(a × b) = √a × √b'}
                              {idx === 1 && '√(a ÷ b) = √a ÷ √b'}
                              {idx === 2 && '√(a²) = a (for a ≥ 0)'}
                              {idx === 3 && '√a × √a = a'}
                              {idx === 4 && '√1 = 1   and   √0 = 0'}
                            </span>
                          </div>
                          <p class="law-example"><strong>{law.example}</strong></p>
                          <p class="law-explanation">{law.explanation}</p>
                      </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Section 6: Calculation Methods -->
        <section class="article-section article-section--alt" id="section-methods">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg></span> {content.s6Eyebrow}</div>
                <h2 class="article-h2">{content.s6Title}</h2>
                <p>{content.s6Intro}</p>

                <h3 class="article-h3" id="method-calculator">{content.s6M1Title}</h3>
                <p>{content.s6M1Text}</p>

                <h3 class="article-h3" id="method-factorization">{content.s6M2Title}</h3>
                <p>{content.s6M2Intro}</p>
                <div class="method-example">
                    <div class="method-title">{content.s6M2ExTitle}</div>
                    <ul class="method-steps-list">
                        {content.s6M2Steps.map(step => (
                          <li>{step}</li>
                        ))}
                    </ul>
                </div>

                <h3 class="article-h3" id="method-division">{content.s6M3Title}</h3>
                <p>{content.s6M3Text}</p>

                <h3 class="article-h3" id="method-estimation">{content.s6M4Title}</h3>
                <p>{content.s6M4Intro}</p>
                <div class="method-example">
                    <div class="method-title">{content.s6M4ExTitle}</div>
                    <ul class="method-steps-list">
                        {content.s6M4Steps.map(step => (
                          <li>{step}</li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>

        <!-- Section 7: Positive Numbers Table -->
        <section class="article-section" id="section-positive-numbers">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></span> {content.s7Eyebrow}</div>
                <h2 class="article-h2">{content.s7Title}</h2>
                <p>{content.s7Intro}</p>
                <div class="table-scroll-wrapper">
                    <div class="table-scroll-hint">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8L22 12L18 16"/><path d="M6 8L2 12L6 16"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
                        {content.s12ScrollHint}
                    </div>
                    <table class="data-table">
                        <thead><tr><th>{content.s7ThNumber}</th><th>{content.s7ThRoot}</th><th>{content.s7ThWhy}</th></tr></thead>
                        <tbody>
                            <tr><td>4</td><td>2</td><td>{content.s7Row4}</td></tr>
                            <tr><td>25</td><td>5</td><td>{content.s7Row25}</td></tr>
                            <tr><td>64</td><td>8</td><td>{content.s7Row64}</td></tr>
                            <tr><td>2</td><td>≈1.414</td><td>{content.s7Row2}</td></tr>
                        </tbody>
                    </table>
                </div>
                <p>{content.s7Conclusion}</p>
            </div>
        </section>

        <!-- Section 8: Negative Numbers & Imaginary -->
        <section class="article-section article-section--alt" id="section-negative-numbers">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg></span> {content.s8Eyebrow}</div>
                <h2 class="article-h2">{content.s8Title}</h2>
                <p>{content.s8P1}</p>
                <p>{content.s8P2}</p>
                <div class="math-block"><span class="math-formula">i = √(−1)</span></div>
                <p>{content.s8P3}</p>
                <div class="method-example">
                    <div class="method-title">{content.s8ExTitle}</div>
                    <ul class="method-steps-list">
                        <li>{content.s8ExStep}</li>
                    </ul>
                </div>
                <p>{content.s8Conclusion}</p>
            </div>
        </section>

        <!-- Section 9: Difference Between Racine Carrée and Racine Cubique -->
        <section class="article-section" id="section-difference-cubique">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span> {content.s9Eyebrow}</div>
                <h2 class="article-h2">{content.s9Title}</h2>
                <p>{content.s9Intro}</p>
                <div class="table-scroll-wrapper">
                    <table class="data-table data-table--comparison">
                        <thead><tr><th></th><th>{content.s9ThSquare}</th><th>{content.s9ThCube}</th></tr></thead>
                        <tbody>
                            <tr><td>{content.s9RowSymbol}</td><td>√</td><td>∛</td></tr>
                            <tr><td>{content.s9RowMult}</td><td>{content.s9RowMultSquare}</td><td>{content.s9RowMultCube}</td></tr>
                            <tr><td>{content.s9RowEx}</td><td>√25 = 5</td><td>∛27 = 3</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Section 10: Real-Life Applications -->
        <section class="article-section article-section--alt" id="section-applications">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></span> {content.s10Eyebrow}</div>
                <h2 class="article-h2">{content.s10Title}</h2>
                <p>{content.s10Intro}</p>
                <div class="applications-grid">
                    {content.s10Apps.map((app, idx) => (
                      <div class="app-card" id={`app-${idx === 0 ? 'construction' : idx === 1 ? 'finance' : idx === 2 ? 'physics' : idx === 3 ? 'cs' : 'everyday'}`}>
                          <div class="app-icon">
                            {idx === 0 && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><line x1="9" y1="22" x2="9" y2="2"/><line x1="15" y1="22" x2="15" y2="2"/><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="16" x2="20" y2="16"/></svg>}
                            {idx === 1 && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
                            {idx === 2 && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><ellipse cx="12" cy="12" rx="10" ry="4"/></svg>}
                            {idx === 3 && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>}
                            {idx === 4 && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>}
                          </div>
                          <div class="app-card-content">
                              <h3>{app.title}</h3>
                              <p>{app.text}</p>
                          </div>
                      </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Section 11: Simplification Table -->
        <section class="article-section" id="section-simplification">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg></span> {content.s11Eyebrow}</div>
                <h2 class="article-h2">{content.s11Title}</h2>
                <p>{content.s11Intro}</p>
                <div class="table-scroll-wrapper">
                    <table class="data-table data-table--compact">
                        <thead><tr><th>{content.s11ThExpr}</th><th>{content.s11ThForm}</th><th>{content.s11ThWhy}</th></tr></thead>
                        <tbody>
                            <tr><td>√8</td><td>2√2</td><td>8 = 4 × 2, √4 = 2</td></tr>
                            <tr><td>√12</td><td>2√3</td><td>12 = 4 × 3</td></tr>
                            <tr><td>√18</td><td>3√2</td><td>18 = 9 × 2</td></tr>
                            <tr><td>√20</td><td>2√5</td><td>20 = 4 × 5</td></tr>
                            <tr><td>√50</td><td>5√2</td><td>50 = 25 × 2</td></tr>
                            <tr><td>√72</td><td>6√2</td><td>72 = 36 × 2</td></tr>
                            <tr><td>√98</td><td>7√2</td><td>98 = 49 × 2</td></tr>
                        </tbody>
                    </table>
                </div>
                <p>{content.s11Conclusion}</p>
            </div>
        </section>

        <!-- Section 12: Reference Table 1-100 -->
        <section class="article-section article-section--alt" id="reference-tables">
            <div class="article-container">
                <div class="section-eyebrow"><span class="eyebrow-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg></span> {content.s12Eyebrow}</div>
                <h2 class="article-h2">{content.s12Title}</h2>
                <p>{content.s12Intro}</p>
                <p style="margin-top: 8px; font-weight: 500;">
                  <a href={localizedUrl('/square-root-chart/')} style="color: var(--primary-600); font-weight: 700; text-decoration: underline;">
                    {content.s12ChartLinkText}
                  </a>
                </p>
                <div class="table-scroll-wrapper table-scroll-wrapper--large">
                    <div class="table-scroll-hint"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M18 13l-6 6-6-6"/></svg> {content.s12ScrollHint}</div>
                    <table class="data-table data-table--reference data-table--vertical">
                        <thead><tr><th>{content.s12ColNumber}</th><th>{content.s12ColRoot}</th><th>{content.s12ColType}</th></tr></thead>
                        <tbody>
                            {table100Rows.map(row => (
                              <tr class={row.isPerfect ? "tr-perfect" : undefined}>
                                <td>{row.n}</td>
                                <td>{row.rootFormatted}</td>
                                <td>
                                  {row.isPerfect ? (
                                    <span class="badge-perfect">{content.s12BadgePerfect}</span>
                                  ) : (
