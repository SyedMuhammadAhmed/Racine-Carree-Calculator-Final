---
import { DEFAULT_LOCALE, LOCALES, getLocalizedUrl, type Locale } from '../../theme/i18n/utils';
import { useTranslations } from '../../theme/i18n/translations';
import LanguagePicker from './LanguagePicker.astro';

import social from '../config/social.json';
import site from '../config/site.json';

interface Props {
  lang?: string;
  contentLang?: string;
}

const { lang = DEFAULT_LOCALE, contentLang = DEFAULT_LOCALE } = Astro.props;
const localePrefixPattern = new RegExp(`^/(${LOCALES.join('|')})(?=/|$)`);
const pathLocale = Astro.url.pathname.match(localePrefixPattern)?.[1];
const requestedLocale = Astro.url.searchParams.get('lang') || pathLocale || lang;
const activeLocale = LOCALES.includes(requestedLocale as Locale)
  ? requestedLocale as Locale
  : DEFAULT_LOCALE;
const contentLocale = LOCALES.includes(contentLang as Locale) ? contentLang : DEFAULT_LOCALE;
const currentPathWithoutLocale = Astro.url.pathname.replace(localePrefixPattern, '') || '/';
const isHomePath = currentPathWithoutLocale === '/';
const homeUrl = getLocalizedUrl('/', activeLocale);
const sectionHref = (id: string) => isHomePath ? `#${id}` : `${homeUrl}#${id}`;
const pageHref = (path: string) => path;
const t = await useTranslations(contentLocale);
const brand = t('footer.brand', 'Racine Carrée Calculator');
const description = t('site.description', 'Free online Racine Carrée Calculator. Calculate square roots with exact decimals, simplified radicals, step-by-step workings, and reference tables.');
const year = new Date().getFullYear();
---

<footer class="footer-redesign" id="footer">
  <div class="footer-redesign__inner">

    <!-- Top section: Brand + Description on left, Social on right -->
    <div class="footer-redesign__top">
      <div class="footer-redesign__brand-block">
        <a href={homeUrl} class="footer-redesign__logo" aria-label="Home">
          <span class="footer-redesign__logo-icon">√</span>
          <span class="footer-redesign__logo-text">{brand}</span>
        </a>
        <p class="footer-redesign__description">{description}</p>
        {(social.facebook || (social as any).pinterest || (social as any).behance || social.twitter || social.linkedin || (social as any).youtube) && (
          <div class="footer-redesign__social">
            {social.facebook && (
              <a href={social.facebook} target="_blank" rel="noopener noreferrer" class="footer-redesign__social-link" aria-label="Facebook" title="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            )}
            {(social as any).pinterest && (
              <a href={(social as any).pinterest} target="_blank" rel="noopener noreferrer" class="footer-redesign__social-link" aria-label="Pinterest" title="Pinterest">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641 0 12.017 0z"/></svg>
              </a>
            )}
            {(social as any).behance && (
              <a href={(social as any).behance} target="_blank" rel="noopener noreferrer" class="footer-redesign__social-link" aria-label="Behance" title="Behance">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 7h-7v-2h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-4.045 0-6.625-2.735-6.625-6.744 0-4.041 2.658-6.756 6.386-6.756 4.316 0 5.865 3.327 5.484 6.78h-8.847c.182 2.029 1.625 3.375 3.654 3.375 1.583 0 2.593-.655 3.049-1.655h2zM12.023 11.5c-.17-1.802-1.39-2.906-3.13-2.906-1.897 0-3.088 1.139-3.267 2.906h6.397zM0 4.5h7.247c2.146 0 3.753.518 4.718 1.517.854.887 1.288 2.054 1.288 3.447 0 1.298-.445 2.39-1.285 3.197-.84.808-1.996 1.272-3.373 1.365 1.651.273 2.924.966 3.734 2.036.81 1.07 1.229 2.459 1.229 4.077 0 1.761-.577 3.208-1.705 4.275-1.129 1.066-2.784 1.586-4.881 1.586H0V4.5zm3.178 6.559h3.701c.983 0 1.73-.207 2.203-.609.473-.401.716-.984.716-1.72 0-.76-.243-1.348-.716-1.736-.473-.388-1.22-.591-2.203-.591H3.178v4.656zm0 9.215h3.987c1.11 0 1.956-.237 2.493-.699.537-.461.812-1.144.812-2.019 0-.895-.279-1.579-.824-2.02-.545-.441-1.408-.67-2.544-.67H3.178v5.408z"/></svg>
              </a>
            )}
            {social.twitter && (
              <a href={social.twitter} target="_blank" rel="noopener noreferrer" class="footer-redesign__social-link" aria-label="X (Twitter)" title="X (Twitter)">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            )}
            {social.linkedin && (
              <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="footer-redesign__social-link" aria-label="LinkedIn" title="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            )}
            {(social as any).youtube && (
              <a href={(social as any).youtube} target="_blank" rel="noopener noreferrer" class="footer-redesign__social-link" aria-label="YouTube" title="YouTube">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- Divider -->
    <div class="footer-redesign__divider"></div>

    <!-- Link columns -->
    <div class="footer-redesign__columns">
      <div class="footer-redesign__col">
        <h3 class="footer-redesign__col-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><line x1="4" y1="12" x2="20" y2="12"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
          Calculators
        </h3>
        <nav class="footer-redesign__links" aria-label="Calculator links">
          <a href={sectionHref('hero')}>Racine Carrée Calculator</a>
          <a href={getLocalizedUrl('/racine-cubique-calculator/', activeLocale)}>{t('nav.cbrt', 'Racine Cubique Calculator')}</a>
          <a href={getLocalizedUrl('/nth-root-calculator/', activeLocale)}>{t('nav.nth', 'Nth Root Calculator')}</a>
        </nav>
      </div>

      <div class="footer-redesign__col">
        <h3 class="footer-redesign__col-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          {t('footer.company', 'Company')}
        </h3>
        <nav class="footer-redesign__links" aria-label="Company links">
          <a href={pageHref('/about-us/')}>{t('nav.about', 'About Us')}</a>
          <a href={pageHref('/contact-us/')}>{t('nav.contact', 'Contact Us')}</a>
          <a href={pageHref('/sitemap/')}>{t('nav.sitemap', 'Sitemap')}</a>
        </nav>
      </div>

      <div class="footer-redesign__col">
        <h3 class="footer-redesign__col-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          Legal
        </h3>
        <nav class="footer-redesign__links" aria-label="Legal links">
          <a href={pageHref('/privacy/')}>{t('nav.privacy', 'Privacy Policy')}</a>
          <a href={pageHref('/terms/')}>Terms &amp; Conditions</a>
          <a href={pageHref('/disclaimer/')}>Disclaimer</a>
          <a href="https://www.dmca.com/Protection/Status.aspx?url=https://www.racinecarreecalculatorr.com" target="_blank" rel="noopener noreferrer" class="dmca-legal-link">DMCA Protection</a>
        </nav>
      </div>

      <div class="footer-redesign__col">
        <h3 class="footer-redesign__col-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          {t('footer.language', 'Language')}
        </h3>
        <LanguagePicker lang={activeLocale} id="footer-language-picker" />
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-redesign__bottom">
      <p class="footer-redesign__copyright">
        &copy; {year} {brand}. {t('footer.rights', 'All rights reserved.')}
      </p>
      <div class="footer-redesign__badges">
        <a href="https://www.dmca.com/Protection/Status.aspx?url=https://www.racinecarreecalculatorr.com" target="_blank" rel="noopener noreferrer" class="dmca-badge" title="DMCA.com Protection Status" aria-label="DMCA.com Protection Status">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>DMCA PROTECTED</span>
        </a>
      </div>
      <p class="footer-redesign__tagline">{t('footer.made', 'Made for mathematics')}</p>
    </div>

  </div>
</footer>
