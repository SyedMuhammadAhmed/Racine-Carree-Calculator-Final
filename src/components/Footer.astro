---
import { DEFAULT_LOCALE, LOCALES, getLocalizedUrl, type Locale } from '../../theme/i18n/utils';
import { useTranslations } from '../../theme/i18n/translations';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  lang?: string;
  contentLang?: string;
}

const { lang = DEFAULT_LOCALE, contentLang = DEFAULT_LOCALE } = Astro.props;
const localePrefixPattern = new RegExp(`^/(${LOCALES.join('|')})(?=/|$)`);
const pathLocale = Astro.url.pathname.match(localePrefixPattern)?.[1];
const requestedLocale = Astro.url.searchParams.get('lang') || pathLocale || lang;
const activeLocale = LOCALES.includes(requestedLocale as Locale)
  ? requestedLocale as Locale
  : DEFAULT_LOCALE;
const contentLocale = LOCALES.includes(contentLang as Locale) ? contentLang : DEFAULT_LOCALE;
const currentPathWithoutLocale = Astro.url.pathname.replace(localePrefixPattern, '') || '/';
const isHomePath = currentPathWithoutLocale === '/';
const homeUrl = getLocalizedUrl('/', activeLocale);
const sectionHref = (id: string) => isHomePath ? `#${id}` : `${homeUrl}#${id}`;
const pageHref = (path: string) => {
  if (activeLocale === DEFAULT_LOCALE) return path;
  const params = new URLSearchParams();
  params.set('lang', activeLocale);
  return `${path}?${params.toString()}`;
};
const t = await useTranslations(contentLocale);
const brand = t('footer.brand', 'Racine Carrée Calculator');
---

<footer class="footer" id="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="logo-icon">√</span>
        <span class="logo-text">{brand}</span>
      </div>
      <p class="footer-tagline">{t('footer.tagline', 'The most complete free square root, cube root, and nth root tool online.')}</p>
      <div class="footer-controls">
        <nav class="footer-links" aria-label="Footer navigation">
          <a href={sectionHref('hero')}>{t('nav.home', 'Home')}</a>
          <a href={pageHref('/racine-cubique-calculator/')}>Racine Cubique</a>
          <a href={pageHref('/nth-root-calculator/')}>Nth Root</a>
          <a href={pageHref('/about-us/')}>{t('nav.about', 'About')}</a>
          <a href={pageHref('/contact-us/')}>{t('nav.contact', 'Contact')}</a>
          <a href={pageHref('/privacy/')}>{t('nav.privacy', 'Privacy Policy')}</a>
          <a href={pageHref('/terms/')}>Terms & Conditions</a>
          <a href={pageHref('/disclaimer/')}>Disclaimer</a>
          <a href={pageHref('/sitemap/')}>{t('nav.sitemap', 'Sitemap')}</a>
        </nav>
        <div class="footer-language">
          <span class="footer-language-label">{t('footer.language', 'Language')}</span>
          <LanguagePicker lang={activeLocale} id="footer-language-picker" />
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">&copy; {new Date().getFullYear()} {brand}. {t('footer.rights', 'All rights reserved.')}</p>
      <p class="footer-made">{t('footer.made', 'Made for mathematics')}</p>
    </div>
  </div>
</footer>
