<!-- Client Script for Interactive Reference Table Filter & Search, plus Formula Copying -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('chartTableSearch');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const tableRows = document.querySelectorAll('#mainReferenceTable tbody tr');
    const counterDisplay = document.getElementById('tableCounterDisplay');

    let currentFilter = 'all';

    function updateTable() {
      const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
      let visibleCount = 0;

      tableRows.forEach((row) => {
        const num = row.getAttribute('data-num') || '';
        const root = row.getAttribute('data-root') || '';
        const isPerfect = row.getAttribute('data-perfect') === 'true';

        let matchesFilter = true;
        if (currentFilter === 'perfect') {
          matchesFilter = isPerfect;
        } else if (currentFilter === 'irrational') {
          matchesFilter = !isPerfect;
        }

        let matchesSearch = true;
        if (query.length > 0) {
          matchesSearch = num.includes(query) || root.includes(query);
        }

        if (matchesFilter && matchesSearch) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (counterDisplay) {
        counterDisplay.textContent = `Showing ${visibleCount} of ${tableRows.length} rows`;
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', updateTable);
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter') || 'all';
        updateTable();
      });
    });

    // Copy formula buttons
    const copyBtns = document.querySelectorAll('.btn-copy-code');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          navigator.clipboard.writeText(targetEl.textContent || '').then(() => {
            const originalText = btn.textContent;
            btn.textContent = 'Copied!';
            btn.style.background = 'var(--emerald-500, #10b981)';
            setTimeout(() => {
              btn.textContent = originalText;
              btn.style.background = 'var(--primary-500)';
            }, 2000);
          });
        }
      });
