---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getChartContent } from '../data/i18n/content/chartContent';
import { getAuthorByline } from '../data/i18n/commonI18n';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}
const { lang = 'en', faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getChartContent(lang);
const chartToc = content.toc;
const effectiveFaqs = (faqs && faqs.length > 0) ? faqs : content.faqs;
const authorByline = getAuthorByline(lang);

// Format decimal based on locale (French and German use comma, others use dot)
const isCommaLocale = lang === 'fr' || lang === 'de';
const formatNum = (val: number, decimals: number = 3) => {
  const formatted = val.toFixed(decimals);
  return isCommaLocale ? formatted.replace('.', ',') : formatted;
};

// UI Localization dictionary for all 18 languages
const uiDict: Record<string, Record<string, string>> = {
  en: {
    searchPlaceholder: "Search number (e.g. 16, 49) or root...",
    filterAll: "All (100)",
    filterPerfect: "Perfect Squares",
    filterIrrational: "Irrational Roots",
    showingRows: "Showing {count} of {total} rows",
    copy: "Copy",
    copied: "Copied!",
    radicalForm: "Radical Form",
    anatomyTitle: "Anatomy of Square Root Notation",
    radSymbol: "Radical Symbol (√)",
    radSymbolDesc: "Introduced by Christoff Rudolff in 1525, this symbol denotes root extraction.",
    radicand: "Radicand",
    radicandDesc: "The positive number or expression located under the radical bar (for example, 49 in √49).",
    principalRoot: "Principal Square Root",
    principalRootDesc: "While every positive number has two roots, the radical symbol specifically denotes the positive value (+7).",
    inverseOp: "Inverse of Squaring",
    inverseOpDesc: "Finding a square root is the direct inverse mathematical operation of squaring a number (n²).",
    perfectSquaresTitle: "The 10 Perfect Squares from 1 to 100",
    nonPerfectTitle: "Non-Perfect Squares & Radical Simplification",
    extended1000Title: "Extended Range: 1 to 1000 Patterns, Benchmarks, and Milestones",
    all31Squares: "All 31 Perfect Squares Up to 1000",
    centuryBenchmarks: "Century Benchmarks (100 to 1000)",
    centuryRuleDesc: "Every century marker factors using √(k × 100) = 10√k. Multiply the known root of k by 10:",
    manualMethodsTitle: "How to Calculate Square Roots Manually: Three Proven Methods",
    primeFactorTitle: "Prime Factorization",
    primeFactorDesc: "Best for evaluating large perfect squares by pairing identical prime factors.",
    longDivTitle: "Long Division Method",
    longDivDesc: "Calculates digit-by-digit accuracy for non-perfect square irrational roots.",
    babylonianTitle: "Babylonian / Newton-Raphson Method",
    babylonianDesc: "Fast iterative formula: x_(n+1) = 0.5 × (x_n + S / x_n) that rapidly doubles decimal precision.",
    spreadsheetsTitle: "How to Generate a Square Root Table in Spreadsheets (Excel & Google Sheets)",
    ssStep1: "Populate Numbers in Column A",
    ssStep1Desc: "Type 1 in cell A2 and 2 in cell A3, then drag the fill handle down to row 101.",
    ssStep2: "Enter the Square Root Formula",
    ssStep2Desc: "In cell B2, enter the formula below and double-click the fill handle:",
    ssStep3: "Add Automated Perfect Square Labels",
    ssStep3Desc: "In cell C2, enter this logical formula to label perfect squares automatically:",
    internationalTitle: "International Mathematical Conventions: US, UK, Canada, Australia, Germany, and France",
    decimalPointGroup: "US, UK, Canada & Australia",
    decimalPointDesc: "Uses a period (.) as the decimal separator (for example, √2 ≈ 1.414). Aligned with US Common Core and UK GCSE.",
    decimalCommaGroup: "Germany & France",
    decimalCommaDesc: "Uses a comma (,) as the decimal separator (for example, √2 ≈ 1,414). Aligned with DIN 1333 and AFNOR standards.",
    applicationsTitle: "Real-World Applications of Square Root Tables and Values",
    appConstruction: "1. Construction & Geometry",
    appConstructionDesc: "Carpenters calculate diagonal spans and rafter lengths using the Pythagorean theorem: c = √(a² + b²).",
    appElectrical: "2. Electrical Engineering & RMS",
    appElectricalDesc: "AC electricity (120V / 230V) is rated by Root-Mean-Square voltage: V_RMS = V_peak / √2.",
    appComputing: "3. Computer Graphics & Game Engines",
    appComputingDesc: "Game engines calculate 2D and 3D distances using Euclidean distance and lookup tables (LUT) for O(1) performance.",
    imgAnatomyCaption: "Anatomy of square root notation: The radical sign (√), radicand (the number inside), and decimal value.",
    imgSquaresCaption: "Visual progression of perfect squares: Geometric squares where area equals the square of side length.",
    imgMilestonesCaption: "The 31 perfect squares from 1 to 1000 and the century factoring rule: √(k × 100) = 10√k.",
    imgGeometricCaption: "Geometric concept: The square root represents the side length of a square with a known area.",
    imgSpreadsheetCaption: "Generating square root charts in Excel and Google Sheets using the SQRT formula.",
    imgPythagoreanCaption: "Practical application: Calculating diagonal distances and right-angle foundations using the Pythagorean theorem."
  },
  fr: {
    searchPlaceholder: "Rechercher un nombre (ex. 16, 49) ou une racine...",
    filterAll: "Tous (100)",
    filterPerfect: "Carrés Parfaits",
    filterIrrational: "Racines Irrationnelles",
    showingRows: "Affichage de {count} sur {total} lignes",
    copy: "Copier",
    copied: "Copié !",
    radicalForm: "Forme Radicale",
    anatomyTitle: "Anatomie de la Notation des Racines Carrées",
    radSymbol: "Symbole Radical (√)",
    radSymbolDesc: "Introduit par Christoff Rudolff en 1525, il indique l'extraction de la racine carrée.",
    radicand: "Radicande",
    radicandDesc: "Le nombre positif situé sous la barre du radical (par exemple 49 dans √49).",
    principalRoot: "Racine Carrée Principale",
    principalRootDesc: "Bien qu'un nombre positif ait deux racines, le symbole radical désigne toujours la valeur positive (+7).",
    inverseOp: "Inverse du Carré",
    inverseOpDesc: "L'extraction de racine carrée est l'opération réciproque directe de l'élévation au carré (n²).",
    perfectSquaresTitle: "Les 10 Carrés Parfaits de 1 à 100",
    nonPerfectTitle: "Carrés Non Parfaits et Simplification Radicale",
    extended1000Title: "Plage Étendue : Motifs, Repères et Jalons de 1 à 1000",
    all31Squares: "Les 31 Carrés Parfaits Jusqu'à 1000",
    centuryBenchmarks: "Repères par Centaine (100 à 1000)",
    centuryRuleDesc: "Chaque centaine se factorise selon √(k × 100) = 10√k. Multipliez la racine de k par 10 :",
    manualMethodsTitle: "Comment Calculer une Racine Carrée Manuellement : 3 Méthodes Éprouvées",
    primeFactorTitle: "Décomposition en Facteurs Premiers",
    primeFactorDesc: "Idéal pour les carrés parfaits en regroupant les facteurs premiers identiques par paires.",
    longDivTitle: "Algorithme de Division Longue",
    longDivDesc: "Permet d'extraire la racine chiffre par chiffre pour les nombres irrationnels.",
    babylonianTitle: "Méthode Babylonienne (Héron / Newton)",
    babylonianDesc: "Formule itérative rapide : x_(n+1) = 0,5 × (x_n + S / x_n) doublant la précision à chaque étape.",
    spreadsheetsTitle: "Comment Générer une Table de Racines Carrées sur Tableur (Excel & Google Sheets)",
    ssStep1: "Remplir les Nombres dans la Colonne A",
    ssStep1Desc: "Tapez 1 en A2 et 2 en A3, puis étirez la poignée de recopie jusqu'à la ligne 101.",
    ssStep2: "Saisir la Formule de Racine Carrée",
    ssStep2Desc: "En cellule B2, entrez la formule ci-dessous et double-cliquez sur la poignée :",
    ssStep3: "Ajouter la Détection Automatique des Carrés Parfaits",
    ssStep3Desc: "En cellule C2, entrez cette formule pour catégoriser automatiquement les résultats :",
    internationalTitle: "Normes Mathématiques Internationales : France, Allemagne, États-Unis, Royaume-Uni",
    decimalPointGroup: "États-Unis, Royaume-Uni, Canada & Australie",
    decimalPointDesc: "Utilise le point (.) comme séparateur décimal (ex. √2 ≈ 1.414). Aligné sur le Common Core et le GCSE.",
    decimalCommaGroup: "France & Allemagne",
    decimalCommaDesc: "Utilise la virgule (,) comme séparateur décimal (ex. √2 ≈ 1,414). Conforme aux normes AFNOR et DIN 1333.",
    applicationsTitle: "Applications Concrètes des Tables de Racines Carrées",
    appConstruction: "1. Bâtiment & Géométrie",
    appConstructionDesc: "Calcul des diagonales et des charpentes avec le théorème de Pythagore : c = √(a² + b²).",
    appElectrical: "2. Électrotechnique & Tension Efficace (RMS)",
    appElectricalDesc: "La tension alternative (230V) est mesurée en valeur efficace : V_eff = V_crête / √2.",
    appComputing: "3. Informatique & Jeux Vidéo",
    appComputingDesc: "Calcul de distance euclidienne et tables de correspondance précalculées (LUT) en temps constant O(1).",
    imgAnatomyCaption: "Anatomie d'une table de racines carrées : Nombre, forme radicale, précision décimale et statut.",
    imgSquaresCaption: "Progression géométrique des carrés parfaits : L'aire est égale au côté élevé au carré.",
    imgMilestonesCaption: "Les 31 carrés parfaits de 1 à 1000 et la règle de factorisation par centaine : √(k × 100) = 10√k.",
    imgGeometricCaption: "Concept géométrique : La racine carrée représente le côté d'un carré d'aire donnée.",
    imgSpreadsheetCaption: "Génération automatique d'un tableau sur Excel et Google Sheets avec la formule RACINE.",
    imgPythagoreanCaption: "Application pratique : Mesure des diagonales et vérification d'équerre avec le théorème de Pythagore."
  }
};

const currentUi = uiDict[lang] || uiDict['en'];

// Programmatic complete 100 rows for the interactive reference table
const full100Rows = Array.from({ length: 100 }, (_, i) => {
  const num = i + 1;
  const sqrtVal = Math.sqrt(num);
  const isPerfect = Number.isInteger(sqrtVal);
  return {
    num,
    radical: `√${num}`,
    root: formatNum(sqrtVal, 3),
    isPerfect,
    type: isPerfect ? content.s6.perfectBadge : content.s6.irrationalBadge
  };
});

// The 31 perfect squares from 1 to 1000
const milestoneSquares = Array.from({ length: 31 }, (_, i) => {
  const root = i + 1;
  return {
    root,
    square: root * root
  };
});

// Century benchmarks from 100 to 1000
const centuryBenchmarks = [
  { num: 100, radical: '√100', simplified: '10', root: formatNum(10, 3), note: '10 × 1' },
  { num: 200, radical: '√200', simplified: '10√2', root: formatNum(14.1421, 3), note: '10 × 1.414' },
  { num: 300, radical: '√300', simplified: '10√3', root: formatNum(17.3205, 3), note: '10 × 1.732' },
  { num: 400, radical: '√400', simplified: '20', root: formatNum(20, 3), note: '20 × 1' },
  { num: 500, radical: '√500', simplified: '10√5', root: formatNum(22.3607, 3), note: '10 × 2.236' },
  { num: 600, radical: '√600', simplified: '10√6', root: formatNum(24.4949, 3), note: '10 × 2.449' },
  { num: 700, radical: '√700', simplified: '10√7', root: formatNum(26.4575, 3), note: '10 × 2.646' },
  { num: 800, radical: '√800', simplified: '20√2', root: formatNum(28.2843, 3), note: '20 × 1.414' },
  { num: 900, radical: '√900', simplified: '30', root: formatNum(30, 3), note: '30 × 1' },
  { num: 1000, radical: '√1000', simplified: '10√10', root: formatNum(31.6228, 3), note: '10 × 3.162' }
];

// High-frequency non-perfect squares
const nonPerfectExamples = [
  { num: 2, radical: '√2', simplified: '√2', approx: formatNum(1.414214, 6), threeDec: formatNum(1.414, 3) },
  { num: 3, radical: '√3', simplified: '√3', approx: formatNum(1.732051, 6), threeDec: formatNum(1.732, 3) },
  { num: 5, radical: '√5', simplified: '√5', approx: formatNum(2.236068, 6), threeDec: formatNum(2.236, 3) },
  { num: 10, radical: '√10', simplified: '√10', approx: formatNum(3.162278, 6), threeDec: formatNum(3.162, 3) },
  { num: 50, radical: '√50', simplified: '5√2', approx: formatNum(7.071068, 6), threeDec: formatNum(7.071, 3) },
  { num: 75, radical: '√75', simplified: '5√3', approx: formatNum(8.660254, 6), threeDec: formatNum(8.660, 3) }
];
---

<article class="seo-article" id="chart-guide">
  <!-- Table of Contents -->
  <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
    <TableOfContents items={chartToc} title={content.tocTitle} isOpen={false} lang={lang} />
  </div>

  <!-- Section 1: Intro / What Is a Square Root Chart? -->
  <section class="article-section" id="section-intro">
    <span id="section-what-is-chart" style="display:block; position:relative; top:-80px; visibility:hidden;"></span>
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </span>
        {content.s1.eyebrow}
      </div>
      <h2 class="article-h2">{content.s1.title}</h2>
      <p class="article-lead">{content.s1.lead}</p>
      <p>{content.s1.p1}</p>

      <div class="examples-grid" style="margin: 20px 0 28px 0;">
        {content.s1.cards.map((card) => (
          <div class="example-card">
            <span class="example-expr">{card.expr}</span>
            <span class="example-reason">{card.reason}</span>
          </div>
        ))}
      </div>

      <h3 class="article-h3" style="margin-top: 28px;">{currentUi.anatomyTitle}</h3>
      <ul style="margin: 12px 0 20px 24px; line-height: 1.8; color: var(--text-secondary);">
        <li><strong>{currentUi.radSymbol}:</strong> {currentUi.radSymbolDesc}</li>
        <li><strong>{currentUi.radicand}:</strong> {currentUi.radicandDesc}</li>
        <li><strong>{currentUi.principalRoot}:</strong> {currentUi.principalRootDesc}</li>
        <li><strong>{currentUi.inverseOp}:</strong> {currentUi.inverseOpDesc}</li>
      </ul>
    </div>

    <!-- Section Image 1: Square Root Chart & Lookup Anatomy -->
    <figure class="section-image">
      <img src="/images/sqrt-chart-lookup-anatomy.svg" alt={currentUi.imgAnatomyCaption} loading="lazy" decoding="async" width="800" height="440" />
      <figcaption>{currentUi.imgAnatomyCaption}</figcaption>
    </figure>
  </section>

  <!-- Section 2: How to Use the Generator -->
  <section class="article-section article-section--alt" id="section-how-to-use">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        {content.s2.eyebrow}
      </div>
      <h2 class="article-h2">{content.s2.title}</h2>
      <p>{content.s2.intro}</p>

      <div class="steps-visual" style="margin-top: 24px;">
        {content.s2.steps.map((step, idx) => (
          <div class="step-card" id={`step-chart-${idx + 1}`}>
            <div class="step-number">{idx + 1}</div>
            <div class="step-content">
              <h4>{step.title}</h4>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="warning-box" style="margin-top: 24px; border-color: var(--primary-200);">
        <div class="warning-icon" style="background: var(--primary-50); color: var(--primary-500);">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="warning-content">
          <strong>{content.s2.warningTitle}</strong>
          <p style="margin: 4px 0 0 0;">{content.s2.warningText}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Interactive 1 to 100 Reference Table -->
  <section class="article-section" id="section-example-chart">
    <span id="section-table-1-to-100" style="display:block; position:relative; top:-80px; visibility:hidden;"></span>
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </span>
        {content.s6.eyebrow}
      </div>
      <h2 class="article-h2">{content.s6.title}</h2>
      <p class="article-lead">{content.s6.lead}</p>

      <!-- Interactive Search & Filter Controls -->
      <div class="table-interactive-toolbar" style="margin: 24px 0 16px 0; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;">
        <div style="flex: 1; min-width: 240px; position: relative;">
          <input 
            type="text" 
            id="chartTableSearch" 
            placeholder={currentUi.searchPlaceholder} 
            aria-label="Filter square root table"
            style="width: 100%; padding: 10px 14px 10px 38px; border-radius: var(--radius-md); border: 1px solid var(--border-default); background: var(--bg-surface); color: var(--text-primary); font-size: 0.92rem;"
          />
          <svg style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>

        <div class="filter-chips" style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button type="button" class="filter-btn active" data-filter="all" id="btnFilterAll">{currentUi.filterAll}</button>
          <button type="button" class="filter-btn" data-filter="perfect" id="btnFilterPerfect">{currentUi.filterPerfect} (10)</button>
          <button type="button" class="filter-btn" data-filter="irrational" id="btnFilterIrrational">{currentUi.filterIrrational} (90)</button>
        </div>
      </div>

      <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;" id="tableCounterDisplay">
        Showing 100 of 100 rows
      </div>

      <div class="table-scroll-wrapper table-scroll-wrapper--large" style="max-height: 560px;">
        <table class="data-table data-table--vertical data-table--reference" id="mainReferenceTable">
          <thead>
            <tr>
              <th scope="col" style="width: 18%;">{content.s6.colNum}</th>
              <th scope="col" style="width: 22%;">{currentUi.radicalForm}</th>
              <th scope="col" style="width: 28%;">{content.s6.colRoot}</th>
              <th scope="col" style="width: 32%;">{content.s6.colType}</th>
            </tr>
          </thead>
          <tbody>
            {full100Rows.map((row) => (
              <tr class={row.isPerfect ? 'tr-perfect' : 'tr-irrational'} data-num={row.num} data-root={row.root} data-perfect={row.isPerfect ? 'true' : 'false'}>
                <td><strong>{row.num}</strong></td>
                <td><code style="font-weight: 600; color: var(--text-primary);">{row.radical}</code></td>
                <td>
                  <span style={`font-family: var(--font-mono); font-weight: 700; color: ${row.isPerfect ? 'var(--primary-600)' : 'var(--text-primary)'};`}>
                    {row.root}
                  </span>
                </td>
                <td>
                  {row.isPerfect ? (
                    <span class="badge-perfect">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      {content.s6.perfectBadge}
                    </span>
                  ) : (
                    <span class="badge-irrational" style="display:inline-flex;align-items:center;padding:2px 8px;background:var(--neutral-100);color:var(--text-muted);border-radius:var(--radius-full);font-size:0.75rem;font-weight:600;">
                      {content.s6.irrationalBadge}
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Section 4: Perfect Squares vs. Non-Perfect Squares -->
  <section class="article-section article-section--alt" id="section-perfect-vs-nonperfect">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </span>
        {currentUi.filterPerfect}
      </div>
      <h2 class="article-h2">{currentUi.perfectSquaresTitle}</h2>
      <p class="article-lead">
        A square root chart cleanly differentiates between rational numbers (integers) and irrational numbers (non-terminating decimal roots).
      </p>

      <div class="table-scroll-wrapper" style="margin-top: 16px;">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">n</th>
              <th scope="col">n × n</th>
              <th scope="col">n²</th>
              <th scope="col">√n²</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>1</td><td>1 × 1</td><td><strong>1</strong></td><td>{formatNum(1, 3)}</td></tr>
            <tr><td>2</td><td>2 × 2</td><td><strong>4</strong></td><td>{formatNum(2, 3)}</td></tr>
            <tr><td>3</td><td>3 × 3</td><td><strong>9</strong></td><td>{formatNum(3, 3)}</td></tr>
            <tr><td>4</td><td>4 × 4</td><td><strong>16</strong></td><td>{formatNum(4, 3)}</td></tr>
            <tr><td>5</td><td>5 × 5</td><td><strong>25</strong></td><td>{formatNum(5, 3)}</td></tr>
            <tr><td>6</td><td>6 × 6</td><td><strong>36</strong></td><td>{formatNum(6, 3)}</td></tr>
            <tr><td>7</td><td>7 × 7</td><td><strong>49</strong></td><td>{formatNum(7, 3)}</td></tr>
            <tr><td>8</td><td>8 × 8</td><td><strong>64</strong></td><td>{formatNum(8, 3)}</td></tr>
            <tr><td>9</td><td>9 × 9</td><td><strong>81</strong></td><td>{formatNum(9, 3)}</td></tr>
            <tr><td>10</td><td>10 × 10</td><td><strong>100</strong></td><td>{formatNum(10, 3)}</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="article-h3" style="margin-top: 32px;">{currentUi.nonPerfectTitle}</h3>
      <div class="table-scroll-wrapper" style="margin-top: 16px;">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Number</th>
