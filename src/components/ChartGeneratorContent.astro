---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getChartContent } from '../data/i18n/content/chartContent';
import { getAuthorByline } from '../data/i18n/commonI18n';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}
const { lang = 'en', faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getChartContent(lang);
// Reload trigger
const chartToc = content.toc;
const effectiveFaqs = (faqs && faqs.length > 0) ? faqs : content.faqs;
const authorByline = getAuthorByline(lang);

const exampleRows = [
  { num: 1, root: "1.000", isPerfect: true },
  { num: 2, root: "1.414", isPerfect: false },
  { num: 3, root: "1.732", isPerfect: false },
  { num: 4, root: "2.000", isPerfect: true },
  { num: 5, root: "2.236", isPerfect: false },
  { num: 6, root: "2.449", isPerfect: false },
  { num: 7, root: "2.646", isPerfect: false },
  { num: 8, root: "2.828", isPerfect: false },
  { num: 9, root: "3.000", isPerfect: true },
  { num: 10, root: "3.162", isPerfect: false },
  { num: 11, root: "3.317", isPerfect: false },
  { num: 12, root: "3.464", isPerfect: false },
  { num: 13, root: "3.606", isPerfect: false },
  { num: 14, root: "3.742", isPerfect: false },
  { num: 15, root: "3.873", isPerfect: false },
  { num: 16, root: "4.000", isPerfect: true },
  { num: 17, root: "4.123", isPerfect: false },
  { num: 18, root: "4.243", isPerfect: false },
  { num: 19, root: "4.359", isPerfect: false },
  { num: 20, root: "4.472", isPerfect: false }
];
---

<article class="seo-article" id="chart-guide">
  <!-- Table of Contents -->
  <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
    <TableOfContents items={chartToc} title={content.tocTitle} isOpen={false} lang={lang} />
  </div>

  <!-- Intro Section -->
  <section class="article-section" id="section-intro">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </span>
        {content.s1.eyebrow}
      </div>
      <h2 class="article-h2">{content.s1.title}</h2>
      <p class="article-lead">{content.s1.lead}</p>
      <p>{content.s1.p1}</p>

      <div class="examples-grid" style="margin: 20px 0 28px 0;">
        {content.s1.cards.map((card) => (
          <div class="example-card">
            <span class="example-expr">{card.expr}</span>
            <span class="example-reason">{card.reason}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How to Use the Square Root Chart Generator -->
  <section class="article-section article-section--alt" id="section-how-to-use">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        {content.s2.eyebrow}
      </div>
      <h2 class="article-h2">{content.s2.title}</h2>
      <p>{content.s2.intro}</p>

      <div class="steps-visual" style="margin-top: 24px;">
        {content.s2.steps.map((step, idx) => (
          <div class="step-card" id={`step-chart-${idx + 1}`}>
            <div class="step-number">{idx + 1}</div>
            <div class="step-content">
              <h4>{step.title}</h4>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="warning-box" style="margin-top: 24px; border-color: var(--primary-200);">
        <div class="warning-icon" style="background: var(--primary-50); color: var(--primary-500);">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="warning-content">
          <strong>{content.s2.warningTitle}</strong>
          <p style="margin: 4px 0 0 0;">{content.s2.warningText}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What Is a Square Root Chart? -->
  <section class="article-section" id="section-what-is-chart">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M9 12l2 2 4-4"/></svg>
        </span>
        {content.s3.eyebrow}
      </div>
      <h2 class="article-h2">{content.s3.title}</h2>
      <p class="article-lead">{content.s3.lead}</p>
      <ul style="margin: 16px 0 20px 24px; line-height: 1.8; color: var(--text-secondary);">
        {content.s3.points.map((pt) => (
          <li>{pt}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Square Root Chart vs. Square Root Calculator -->
  <section class="article-section article-section--alt" id="section-chart-vs-calc">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </span>
        {content.s4.eyebrow}
      </div>
      <h2 class="article-h2">{content.s4.title}</h2>
      <p class="article-lead">{content.s4.lead}</p>

      <div class="law-cards-grid" style="margin-top: 24px;">
        <div class="law-card">
          <div class="law-number"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M9 12l2 2 4-4"/></svg></div>
          <h3 class="law-title">{content.s4.cardCalcTitle}</h3>
          <p class="law-text">{content.s4.cardCalcText}</p>
        </div>

        <div class="law-card">
          <div class="law-number"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
          <h3 class="law-title">{content.s4.cardChartTitle}</h3>
          <p class="law-text">{content.s4.cardChartText}</p>
        </div>
      </div>

      <p style="margin-top: 20px; font-size: 1rem; line-height: 1.7; color: var(--text-secondary);">
        {content.s4.summary}
      </p>
    </div>
  </section>

  <!-- How the Values Are Calculated -->
  <section class="article-section" id="section-how-calculated">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </span>
        {content.s5.eyebrow}
      </div>
      <h2 class="article-h2">{content.s5.title}</h2>
      <p class="article-lead">{content.s5.lead}</p>
      <p>{content.s5.p1}</p>
      <ul style="margin: 12px 0 16px 24px; line-height: 1.8; color: var(--text-secondary);">
        {content.s5.points.map((pt) => (
          <li><code>{pt}</code></li>
        ))}
      </ul>
      <p>{content.s5.conclusion}</p>
    </div>
  </section>

  <!-- Example: A Generated Chart (Range 1–20, 3 Decimal Places) -->
  <section class="article-section article-section--alt" id="section-example-chart">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </span>
        {content.s6.eyebrow}
      </div>
      <h2 class="article-h2">{content.s6.title}</h2>
      <p class="article-lead">{content.s6.lead}</p>

      <div class="table-scroll-wrapper table-scroll-wrapper--large" style="max-height: 520px; margin-top: 24px;">
        <table class="data-table data-table--vertical data-table--reference">
          <thead>
            <tr>
              <th scope="col">{content.s6.colNum}</th>
              <th scope="col">{content.s6.colRoot}</th>
              <th scope="col">{content.s6.colType}</th>
            </tr>
          </thead>
          <tbody>
            {exampleRows.map(row => (
              <tr class={row.isPerfect ? 'tr-perfect' : ''}>
                <td><strong>{row.num}</strong></td>
                <td><span style={`font-family: var(--font-mono); font-weight: 700; color: ${row.isPerfect ? 'var(--primary-600)' : 'var(--text-primary)'};`}>{row.root}</span></td>
                <td>
                  {row.isPerfect ? (
                    <span class="badge-perfect">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      {content.s6.perfectBadge}
                    </span>
                  ) : (
                    <span class="badge-irrational" style="display:inline-flex;align-items:center;padding:2px 8px;background:var(--neutral-100);color:var(--text-muted);border-radius:var(--radius-full);font-size:0.75rem;font-weight:600;">
                      {content.s6.irrationalBadge}
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- How to Read and Use Your Chart -->
  <section class="article-section" id="section-read-chart">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </span>
        {content.s7.eyebrow}
      </div>
      <h2 class="article-h2">{content.s7.title}</h2>
      <p class="article-lead">{content.s7.lead}</p>

      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s7.tips.map((tip) => (
          <div class="law-card">
            <div class="law-number"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
            <h3 class="law-title">{tip.title}</h3>
            <p class="law-text">{tip.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Common Mistakes to Avoid -->
  <section class="article-section article-section--alt" id="section-common-mistakes">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        {content.s8.eyebrow}
      </div>
      <h2 class="article-h2">{content.s8.title}</h2>

      <div class="steps-flow" style="margin-top: 24px;">
        {content.s8.cautions.map((caution, idx) => (
          <div class="step-card">
            <div class="step-badge" style="background: var(--amber-500); color: white;">#{idx + 1}</div>
            <h3 class="step-title">{caution.title}</h3>
            <p class="step-desc">{caution.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Frequently Asked Questions -->
  <section class="article-section" id="section-faqs">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        {content.s9.eyebrow}
      </div>
      <h2 class="article-h2">{content.s9.title}</h2>
      <div class="faq-list">
        {effectiveFaqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>

      <!-- Author Byline & Social Sharing Bar below FAQs -->
      <div class="article-header-meta" style="margin-top: 40px; margin-bottom: 0;">
        <div class="article-author-byline">
          <a href={localizedUrl('/about-us/')} class="author-avatar-link" aria-label="Syed Muhammad Ahmed, Founder and Creator">
            <img src="/images/syed-muhammad-ahmed-racine-carree-calculator.jpg" alt="Syed Muhammad Ahmed, Founder and Creator of Racine Carree Calculator" width="44" height="44" loading="lazy" decoding="async" class="author-avatar" />
          </a>
          <div class="author-details">
            <span class="author-verified-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              {authorByline.writtenBy}
            </span>
            <a href={localizedUrl('/about-us/')} class="author-name-link">Syed Muhammad Ahmed</a>
            <span class="author-title">{authorByline.authorRole}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 10: Quick Recap -->
  <section class="article-section" id="section-recap">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        {content.s10.eyebrow}
      </div>
      <h2 class="article-h2">{content.s10.title}</h2>
      <div class="warning-box" style="border-color: var(--primary-200);">
        <div class="warning-icon" style="background: var(--primary-50); color: var(--primary-500);">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="warning-content">
          <strong>{content.s10.takeawayTitle}</strong>
          <p>{content.s10.takeawayText}</p>
        </div>
      </div>
    </div>
  </section>
</article>

