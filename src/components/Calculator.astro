---
import { useTranslations } from '../../theme/i18n/translations';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await useTranslations(lang);
---

<main class="calc-stage" id="calculators">
    <div class="calc-stage-glow" aria-hidden="true"></div>
    <div class="calc-suite" id="calcSuite">
        <nav class="calc-suite-nav" id="calcTabs" aria-label="Calculator types">
            <button class="calc-tab active" data-calc="square-root" id="tabSquareRoot">
                <span class="tab-icon">√</span>
                <span class="tab-label">{t("calc.tab.squareRoot", "Square Root")}</span>
            </button>
            <button class="calc-tab" data-calc="cube-root" id="tabCubeRoot">
                <span class="tab-icon">∛</span>
                <span class="tab-label">{t("calc.tab.cubeRoot", "Cube Root")}</span>
            </button>
            <button class="calc-tab" data-calc="nth-root" id="tabNthRoot">
                <span class="tab-icon">ⁿ√</span>
                <span class="tab-label">{t("calc.tab.nthRoot", "Nth Root")}</span>
            </button>
            <button class="calc-tab" data-calc="fraction" id="tabFraction">
                <span class="tab-icon">⅟</span>
                <span class="tab-label">{t("calc.tab.fraction", "Fraction")}</span>
            </button>
            <button class="calc-tab" data-calc="power" id="tabPower">
                <span class="tab-icon">xⁿ</span>
                <span class="tab-label">{t("calc.tab.power", "Power")}</span>
            </button>
        </nav>

        <div class="calc-panels">
            <!-- Square Root Calculator -->
            <div class="calc-panel active" id="panelSquareRoot" data-calc="square-root">
                <article class="calc-widget">
                    <header class="calc-widget-head">
                        <span class="calc-widget-symbol" aria-hidden="true">√</span>
                        <div class="calc-widget-head-text">
                            <h3 class="calc-widget-title">{t("calc.squareRoot.title", "Square Root")}</h3>
                            <p class="calc-widget-desc">{t("calc.squareRoot.desc", "Calculate √x for any positive number")}</p>
                        </div>
                    </header>
                    <div class="calc-widget-flow">
                        <section class="calc-step" aria-label="Input">
                            <div class="input-group">
                                <label class="input-label" for="sqrtInput">{t("calc.label.number", "Number to calculate")}</label>
                                <div class="input-wrapper">
                                    <span class="input-prefix">√</span>
                                    <input type="number" id="sqrtInput" class="calc-input" placeholder="e.g. 144" min="0" step="any" autocomplete="off">
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--action">
                            <button class="btn-calc-primary" id="sqrtCalcBtn" type="button" onclick="calculateSquareRoot()">
                                <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                <span>{t("calc.btn.calculate", "Calculate")}</span>
                            </button>
                        </section>
                        <section class="calc-step calc-step--results" aria-label="Results">
                            <div class="result-panel" id="sqrtResult">
                                <div class="result-empty">
                                    <div class="result-empty-icon" aria-hidden="true">√</div>
                                    <p class="result-empty-title">{t("calc.result.empty.title", "Your result will appear here")}</p>
                                    <p class="result-empty-hint">{t("calc.result.empty.hint", "Enter a number above and press Calculate")}</p>
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--history" id="sqrtHistory">
                            <div class="history-header">
                                <h4 class="history-title">{t("calc.history.title", "Recent calculations")}</h4>
                                <span class="history-count" id="sqrtHistoryCount"></span>
                            </div>
                            <div class="history-list" id="sqrtHistoryList"></div>
                        </section>
                    </div>
                </article>
            </div>

            <!-- Cube Root Calculator -->
            <div class="calc-panel" id="panelCubeRoot" data-calc="cube-root">
                <article class="calc-widget">
                    <header class="calc-widget-head">
                        <span class="calc-widget-symbol" aria-hidden="true">∛</span>
                        <div class="calc-widget-head-text">
                            <h3 class="calc-widget-title">{t("calc.cubeRoot.title", "Cube Root")}</h3>
                            <p class="calc-widget-desc">{t("calc.cubeRoot.desc", "Find ∛x for any number, including negatives")}</p>
                        </div>
                    </header>
                    <div class="calc-widget-flow">
                        <section class="calc-step" aria-label="Input">
                            <div class="input-group">
                                <label class="input-label" for="cbrtInput">{t("calc.label.number", "Number to calculate")}</label>
                                <div class="input-wrapper">
                                    <span class="input-prefix">∛</span>
                                    <input type="number" id="cbrtInput" class="calc-input" placeholder="e.g. 27" step="any" autocomplete="off">
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--action">
                            <button class="btn-calc-primary" id="cbrtCalcBtn" type="button" onclick="calculateCubeRoot()">
                                <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                <span>{t("calc.btn.calculate", "Calculate")}</span>
                            </button>
                        </section>
                        <section class="calc-step calc-step--results" aria-label="Results">
                            <div class="result-panel" id="cbrtResult">
                                <div class="result-empty">
                                    <div class="result-empty-icon" aria-hidden="true">∛</div>
                                    <p class="result-empty-title">{t("calc.result.empty.title", "Your result will appear here")}</p>
                                    <p class="result-empty-hint">{t("calc.result.empty.hint", "Enter a number above and press Calculate")}</p>
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--history" id="cbrtHistory">
                            <div class="history-header">
                                <h4 class="history-title">{t("calc.history.title", "Recent calculations")}</h4>
                                <span class="history-count" id="cbrtHistoryCount"></span>
                            </div>
                            <div class="history-list" id="cbrtHistoryList"></div>
                        </section>
                    </div>
                </article>
            </div>

            <!-- Nth Root Calculator -->
            <div class="calc-panel" id="panelNthRoot" data-calc="nth-root">
                <article class="calc-widget">
                    <header class="calc-widget-head">
                        <span class="calc-widget-symbol" aria-hidden="true">ⁿ√</span>
                        <div class="calc-widget-head-text">
                            <h3 class="calc-widget-title">{t("calc.nthRoot.title", "Nth Root")}</h3>
                            <p class="calc-widget-desc">{t("calc.nthRoot.desc", "Calculate any root — 4th, 5th, or custom degree")}</p>
                        </div>
                    </header>
                    <div class="calc-widget-flow">
                        <section class="calc-step" aria-label="Input">
                            <div class="input-row">
                                <div class="input-group">
                                    <label class="input-label" for="nthDegree">{t("calc.label.degree", "Root degree (n)")}</label>
                                    <div class="input-wrapper">
                                        <span class="input-prefix">n</span>
                                        <input type="number" id="nthDegree" class="calc-input" placeholder="e.g. 4" min="1" step="1" autocomplete="off">
                                    </div>
                                </div>
                                <div class="input-group">
                                    <label class="input-label" for="nthValue">{t("calc.label.numberX", "Number (x)")}</label>
                                    <div class="input-wrapper">
                                        <span class="input-prefix">x</span>
                                        <input type="number" id="nthValue" class="calc-input" placeholder="e.g. 625" step="any" autocomplete="off">
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--action">
                            <button class="btn-calc-primary" id="nthCalcBtn" type="button" onclick="calculateNthRoot()">
                                <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                <span>{t("calc.btn.calculate", "Calculate")}</span>
                            </button>
                        </section>
                        <section class="calc-step calc-step--results" aria-label="Results">
                            <div class="result-panel" id="nthResult">
                                <div class="result-empty">
                                    <div class="result-empty-icon" aria-hidden="true">ⁿ√</div>
                                    <p class="result-empty-title">{t("calc.result.empty.title", "Your result will appear here")}</p>
                                    <p class="result-empty-hint">{t("calc.nthRoot.empty.hint", "Enter degree and number, then press Calculate")}</p>
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--history" id="nthHistory">
                            <div class="history-header">
                                <h4 class="history-title">{t("calc.history.title", "Recent calculations")}</h4>
                                <span class="history-count" id="nthHistoryCount"></span>
                            </div>
                            <div class="history-list" id="nthHistoryList"></div>
                        </section>
                    </div>
                </article>
            </div>

            <!-- Fraction Calculator -->
            <div class="calc-panel" id="panelFraction" data-calc="fraction">
                <article class="calc-widget">
                    <header class="calc-widget-head">
                        <span class="calc-widget-symbol" aria-hidden="true">⅟</span>
                        <div class="calc-widget-head-text">
                            <h3 class="calc-widget-title">{t("calc.fraction.title", "Fraction Calculator")}</h3>
                            <p class="calc-widget-desc">{t("calc.fraction.desc", "Add, subtract, multiply, divide, and simplify fractions")}</p>
                        </div>
                    </header>
                    <div class="calc-widget-flow">
                        <section class="calc-step" aria-label="Input">
                            <div class="fraction-workspace">
                                <div class="frac-block">
                                    <span class="frac-block-label">{t("calc.fraction.1", "Fraction 1")}</span>
                                    <div class="frac-stacked">
                                        <input type="number" id="fracA1" class="frac-input frac-num" placeholder="a" step="any" autocomplete="off" aria-label="Fraction 1 numerator">
                                        <div class="frac-bar"></div>
                                        <input type="number" id="fracB1" class="frac-input frac-den" placeholder="b" step="any" autocomplete="off" aria-label="Fraction 1 denominator">
                                    </div>
                                </div>
                                <div class="operation-selector" id="fracOperator" role="group" aria-label="Operation">
                                    <button class="op-btn active" type="button" data-op="+" id="fracOpAdd">+</button>
                                    <button class="op-btn" type="button" data-op="-" id="fracOpSub">−</button>
                                    <button class="op-btn" type="button" data-op="*" id="fracOpMul">×</button>
                                    <button class="op-btn" type="button" data-op="/" id="fracOpDiv">÷</button>
                                </div>
                                <div class="frac-block">
                                    <span class="frac-block-label">{t("calc.fraction.2", "Fraction 2")}</span>
                                    <div class="frac-stacked">
                                        <input type="number" id="fracA2" class="frac-input frac-num" placeholder="a" step="any" autocomplete="off" aria-label="Fraction 2 numerator">
                                        <div class="frac-bar"></div>
                                        <input type="number" id="fracB2" class="frac-input frac-den" placeholder="b" step="any" autocomplete="off" aria-label="Fraction 2 denominator">
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--action">
                            <button class="btn-calc-primary" id="fracCalcBtn" type="button" onclick="calculateFraction()">
                                <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                <span>{t("calc.btn.calculate", "Calculate")}</span>
                            </button>
                        </section>
                        <section class="calc-step calc-step--results" aria-label="Results">
                            <div class="result-panel" id="fracResult">
                                <div class="result-empty">
                                    <div class="result-empty-icon" aria-hidden="true">⅟</div>
                                    <p class="result-empty-title">{t("calc.result.empty.title", "Your result will appear here")}</p>
                                    <p class="result-empty-hint">{t("calc.fraction.empty.hint", "Enter both fractions and press Calculate")}</p>
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--history" id="fracHistory">
                            <div class="history-header">
                                <h4 class="history-title">{t("calc.history.title", "Recent calculations")}</h4>
                                <span class="history-count" id="fracHistoryCount"></span>
                            </div>
                            <div class="history-list" id="fracHistoryList"></div>
                        </section>
                    </div>
                </article>
            </div>

            <!-- Power Calculator -->
            <div class="calc-panel" id="panelPower" data-calc="power">
                <article class="calc-widget">
                    <header class="calc-widget-head">
                        <span class="calc-widget-symbol" aria-hidden="true">xⁿ</span>
                        <div class="calc-widget-head-text">
                            <h3 class="calc-widget-title">{t("calc.power.title", "Power Calculator")}</h3>
                            <p class="calc-widget-desc">{t("calc.power.desc", "Raise any number to any power — squares, cubes, and more")}</p>
                        </div>
                    </header>
                    <div class="calc-widget-flow">
                        <section class="calc-step" aria-label="Input">
                            <div class="input-row">
                                <div class="input-group">
                                    <label class="input-label" for="powerBase">{t("calc.label.baseX", "Base (x)")}</label>
                                    <div class="input-wrapper">
                                        <span class="input-prefix">x</span>
                                        <input type="number" id="powerBase" class="calc-input" placeholder="e.g. 5" step="any" autocomplete="off">
                                    </div>
                                </div>
                                <div class="input-group">
                                    <label class="input-label" for="powerExp">{t("calc.label.exponentN", "Exponent (n)")}</label>
                                    <div class="input-wrapper">
                                        <span class="input-prefix">n</span>
                                        <input type="number" id="powerExp" class="calc-input" placeholder="e.g. 3" step="any" autocomplete="off">
                                    </div>
                                </div>
                            </div>
                            <div class="quick-powers">
                                <span class="quick-label">{t("calc.power.shortcuts", "Shortcuts")}</span>
                                <div class="quick-powers-btns">
                                    <button class="quick-btn" type="button" onclick="setQuickPower(2)" id="quickPow2">x²</button>
                                    <button class="quick-btn" type="button" onclick="setQuickPower(3)" id="quickPow3">x³</button>
                                    <button class="quick-btn" type="button" onclick="setQuickPower(0.5)" id="quickPowHalf">x^½</button>
                                    <button class="quick-btn" type="button" onclick="setQuickPower(-1)" id="quickPowNeg1">x⁻¹</button>
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--action">
                            <button class="btn-calc-primary" id="powerCalcBtn" type="button" onclick="calculatePower()">
                                <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                <span>{t("calc.btn.calculate", "Calculate")}</span>
                            </button>
                        </section>
                        <section class="calc-step calc-step--results" aria-label="Results">
                            <div class="result-panel" id="powerResult">
                                <div class="result-empty">
                                    <div class="result-empty-icon" aria-hidden="true">xⁿ</div>
                                    <p class="result-empty-title">{t("calc.result.empty.title", "Your result will appear here")}</p>
                                    <p class="result-empty-hint">{t("calc.power.empty.hint", "Enter base and exponent, then press Calculate")}</p>
                                </div>
                            </div>
                        </section>
                        <section class="calc-step calc-step--history" id="powerHistory">
                            <div class="history-header">
                                <h4 class="history-title">{t("calc.history.title", "Recent calculations")}</h4>
                                <span class="history-count" id="powerHistoryCount"></span>
                            </div>
                            <div class="history-list" id="powerHistoryList"></div>
                        </section>
                    </div>
                </article>
            </div>
        </div>
    </div>
</main>
