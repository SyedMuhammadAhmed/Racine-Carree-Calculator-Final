---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getSquareContent } from '../data/i18n/content/squareContent';
import { getAuthorByline } from '../data/i18n/commonI18n';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}
const { lang = 'en', faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getSquareContent(lang);
const perfectToc = content.toc;
const effectiveFaqs = (faqs && faqs.length > 0) ? faqs : content.faqs;
const authorByline = getAuthorByline(lang);

const first20Squares = Array.from({ length: 20 }, (_, i) => {
  const n = i + 1;
  return { n, square: n * n };
});
---

<article class="seo-article" id="perfect-square-guide">
  <!-- Table of Contents -->
  <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
    <TableOfContents items={perfectToc} title={content.tocTitle} isOpen={false} lang={lang} />
  </div>

  <!-- Section 1: How to Use the Calculator -->
  <section class="article-section article-section--alt" id="section-how-to-use">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        {content.s1.eyebrow}
      </div>
      <h2 class="article-h2">{content.s1.title}</h2>
      <p>{content.s1.intro}</p>

      <div class="steps-visual" style="margin-top: 24px;">
        {content.s1.steps.map((step, idx) => (
          <div class="step-card" id={`step-${idx + 1}`}>
            <div class="step-number">{idx + 1}</div>
            <div class="step-content">
              <h4>{step.title}</h4>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: What Is a Perfect Square? -->
  <section class="article-section" id="section-what-is-perfect-square">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M9 12l2 2 4-4"/></svg>
        </span>
        {content.s2.eyebrow}
      </div>
      <h2 class="article-h2">{content.s2.title}</h2>
      <p class="article-lead">{content.s2.lead}</p>
      <p>{content.s2.p1}</p>
      <p>{content.s2.p2}</p>

      <div class="examples-grid" style="margin: 20px 0 28px 0;">
        <div class="example-card">
          <span class="example-expr">5² = 25</span>
          <span class="example-reason">√25 = 5</span>
        </div>
        <div class="example-card">
          <span class="example-expr">7² = 49</span>
          <span class="example-reason">√49 = 7</span>
        </div>
        <div class="example-card">
          <span class="example-expr">12² = 144</span>
          <span class="example-reason">√144 = 12</span>
        </div>
      </div>

      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s2.cards.map((card, idx) => (
          <div class="law-card">
            <div class="law-number">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3 class="law-title">{card.title}</h3>
            <p class="law-text">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: How the Calculator Determines the Result -->
  <section class="article-section article-section--alt" id="section-how-it-works">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </span>
        {content.s3.eyebrow}
      </div>
      <h2 class="article-h2">{content.s3.title}</h2>
      <p>{content.s3.intro}</p>

      <div class="math-block" style="margin: 20px 0;">
        <span class="math-formula">If &radic;y = x &isin; &Zopf;, then y is a Perfect Square (x &times; x = y)</span>
      </div>

      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s3.tests.map((test, idx) => (
          <div class="law-card">
            <div class="law-number">
              <span style="font-weight: 800; font-size: 0.9rem;">{idx + 1}</span>
            </div>
            <h3 class="law-title">{test.title}</h3>
            <p class="law-text">{test.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Worked Examples -->
  <section class="article-section" id="section-worked-examples">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </span>
        {content.s4.eyebrow}
      </div>
      <h2 class="article-h2">{content.s4.title}</h2>

      {content.s4.examples.map((ex, idx) => (
        <div class="tip-card" style="margin: 20px 0;">
          <div class="tip-card-header">
            <span class="tip-badge" style={idx === 0 ? "background: linear-gradient(135deg, #10b981, #059669);" : "background: linear-gradient(135deg, #ef4444, #dc2626);"}>
              {ex.verdict}
            </span>
            <h3 class="tip-card-title">{ex.title}</h3>
          </div>
          <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
            <code>{ex.expr}</code> — {ex.reason}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 5: Quick Ways to Check Without a Calculator -->
  <section class="article-section article-section--alt" id="section-shortcuts">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </span>
        {content.s5.eyebrow}
      </div>
      <h2 class="article-h2">{content.s5.title}</h2>
      <p>{content.s5.intro}</p>

      <div class="tip-card" id="shortcut-last-digit" style="margin: 24px 0;">
        <div class="tip-card-header">
          <span class="tip-badge">#1</span>
          <h3 class="tip-card-title">{content.s5.r1Title}</h3>
        </div>
        <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
          {content.s5.r1Text}
        </p>
      </div>

      <div class="tip-card" id="shortcut-digital-root" style="margin: 24px 0;">
        <div class="tip-card-header">
          <span class="tip-badge">#2</span>
          <h3 class="tip-card-title">{content.s5.r2Title}</h3>
        </div>
        <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
          {content.s5.r2Text}
        </p>
      </div>
    </div>
  </section>

  <!-- Section 6: Non-Negative Whole Numbers -->
  <section class="article-section" id="section-edge-cases">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        {content.s6.eyebrow}
      </div>
      <h2 class="article-h2">{content.s6.title}</h2>
      <p class="article-lead">{content.s6.lead}</p>
      <p>{content.s6.p1}</p>
    </div>
  </section>

  <!-- Section 7: Nearest Perfect Squares -->
  <section class="article-section article-section--alt" id="section-nearest-square">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg>
        </span>
        {content.s7.eyebrow}
      </div>
      <h2 class="article-h2">{content.s7.title}</h2>
      <p class="article-lead">{content.s7.lead}</p>
      <p>{content.s7.p1}</p>
    </div>
  </section>

  <!-- Section 8: The First 20 Perfect Squares -->
  <section class="article-section" id="section-first-20-squares">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </span>
        {content.s8.eyebrow}
      </div>
      <h2 class="article-h2">{content.s8.title}</h2>
      <p>{content.s8.lead}</p>

      <div class="table-scroll-wrapper" style="margin-top: 20px;">
        <table class="data-table data-table--compact">
          <thead>
            <tr>
              <th scope="col">{content.s8.colN}</th>
              <th scope="col">{content.s8.colSquare}</th>
              <th scope="col">{content.s8.colN}</th>
              <th scope="col">{content.s8.colSquare}</th>
            </tr>
          </thead>
          <tbody>
            {Array.from({ length: 10 }, (_, i) => {
              const row1 = first20Squares[i];
              const row2 = first20Squares[i + 10];
              return (
                <tr>
                  <td style="font-weight:700; color:var(--text-primary);">{row1.n}</td>
                  <td style="font-family:var(--font-mono); color:var(--primary-600); font-weight:700;">{row1.square}</td>
                  <td style="font-weight:700; color:var(--text-primary);">{row2.n}</td>
                  <td style="font-family:var(--font-mono); color:var(--primary-600); font-weight:700;">{row2.square}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Section 9: Where Perfect Squares Show Up -->
  <section class="article-section article-section--alt" id="section-applications">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </span>
        {content.s9.eyebrow}
      </div>
      <h2 class="article-h2">{content.s9.title}</h2>

      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s9.apps.map((app) => (
          <div class="law-card">
            <div class="law-number">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3 class="law-title">{app.title}</h3>
            <p class="law-text">{app.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 10: Common Mistakes to Avoid -->
  <section class="article-section" id="section-mistakes">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        {content.s10.eyebrow}
      </div>
      <h2 class="article-h2">{content.s10.title}</h2>

      {content.s10.mistakes.map((mistake, idx) => (
        <div class="tip-card" style="margin: 20px 0; border-left: 4px solid var(--rose-500, #f43f5e);">
          <div class="tip-card-header">
            <span class="tip-badge" style="background: var(--rose-500, #f43f5e);">#{idx + 1}</span>
            <h3 class="tip-card-title">{mistake.title}</h3>
          </div>
          <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
            {mistake.text}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 11: FAQs -->
  <section class="article-section article-section--alt" id="section-faqs">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        {content.s11.eyebrow}
      </div>
      <h2 class="article-h2">{content.s11.title}</h2>
      <div class="faq-list">
        {effectiveFaqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>

      <!-- Author Byline & Social Sharing Bar below FAQs -->
      <div class="article-header-meta" style="margin-top: 40px; margin-bottom: 0;">
        <div class="article-author-byline">
          <a href={localizedUrl('/about-us/')} class="author-avatar-link" aria-label="Syed Muhammad Ahmed, Founder and Creator">
            <img src="/images/syed-muhammad-ahmed-racine-carree-calculator.jpg" alt="Syed Muhammad Ahmed, Founder and Creator of Racine Carree Calculator" width="44" height="44" loading="lazy" decoding="async" class="author-avatar" />
          </a>
          <div class="author-details">
            <span class="author-verified-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
              {authorByline.writtenBy}
            </span>
            <a href={localizedUrl('/about-us/')} class="author-name-link">Syed Muhammad Ahmed</a>
            <span class="author-title">{authorByline.authorRole}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 12: Quick Recap -->
  <section class="article-section" id="section-recap">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </span>
        {content.s12.eyebrow}
      </div>
      <h2 class="article-h2">{content.s12.title}</h2>
      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s12.cards.map((card) => (
          <div class="law-card">
            <div class="law-number">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3 class="law-title">{card.title}</h3>
            <p class="law-text">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</article>

