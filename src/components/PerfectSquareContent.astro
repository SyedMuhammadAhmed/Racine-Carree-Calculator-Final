---
import TableOfContents from './TableOfContents.astro';
import { getLocalizedUrl, DEFAULT_LOCALE, type Locale } from '../../theme/i18n/utils';
import { getSquareContent } from '../data/i18n/content/squareContent';
import { getAuthorByline } from '../data/i18n/commonI18n';

interface Props {
  lang?: string;
  faqs?: Array<{ question: string; answer: string }>;
}
const { lang = 'en', faqs = [] } = Astro.props;
const currentLocale = (lang || DEFAULT_LOCALE) as Locale;
const localizedUrl = (path: string) => getLocalizedUrl(path, currentLocale);

const content = getSquareContent(lang);
const perfectToc = content.toc;
const effectiveFaqs = (faqs && faqs.length > 0) ? faqs : content.faqs;
const authorByline = getAuthorByline(lang);

// Format numbers according to locale (commas for French/German, dots for English/others)
const isCommaLocale = lang === 'fr' || lang === 'de';
const formatNum = (val: number, decimals: number = 3) => {
  const str = val.toFixed(decimals);
  return isCommaLocale ? str.replace('.', ',') : str;
};

// The 10 perfect squares from 1 to 100
const first10Squares = Array.from({ length: 10 }, (_, i) => {
  const n = i + 1;
  return { n, square: n * n, root: formatNum(n, 3) };
});

// The 31 perfect squares from 1 to 1000
const squaresUpTo1000 = Array.from({ length: 31 }, (_, i) => {
  const n = i + 1;
  return { n, square: n * n };
});

// Nearest square bounding interval examples
const nearestExamples = [
  { target: 50, root: formatNum(7.071068, 3), lowerK: 7, lowerSq: 49, upperK: 8, upperSq: 64, nearest: 49, diff: "50 - 49 = 1" },
  { target: 75, root: formatNum(8.660254, 3), lowerK: 8, lowerSq: 64, upperK: 9, upperSq: 81, nearest: 81, diff: "81 - 75 = 6" },
  { target: 120, root: formatNum(10.954451, 3), lowerK: 10, lowerSq: 100, upperK: 11, upperSq: 121, nearest: 121, diff: "121 - 120 = 1" },
  { target: 500, root: formatNum(22.360680, 3), lowerK: 22, lowerSq: 484, upperK: 23, upperSq: 529, nearest: 484, diff: "500 - 484 = 16" }
];

// UI localization dictionary for headings and labels
const uiDict: Record<string, Record<string, string>> = {
  en: {
    copy: "Copy",
    copied: "Copied!",
    extendedTitle: "Extended List of Perfect Squares from 1 to 1000",
    extendedLead: "Between 1 and 1000 inclusive, there are exactly 31 perfect squares because 31² = 961 and 32² = 1024.",
    codeTitle: "How to Check for Perfect Squares in Code and Spreadsheets",
    codeLead: "Verify square numbers automatically in Excel, Google Sheets, Python, and JavaScript:",
    excelTitle: "1. Microsoft Excel & Google Sheets",
    pythonTitle: "2. Python (Using Integer Square Root)",
    jsTitle: "3. JavaScript",
    intlTitle: "International Mathematical Conventions: US, UK, Canada, Australia, Germany, and France",
    targetNumber: "Target (N)",
    squareRoot: "Square Root (√N)",
    lowerBound: "Lower Square (k²)",
    upperBound: "Upper Square ((k+1)²)",
    nearestSquare: "Nearest Square",
    distance: "Distance",
    imgIntervalCaption: "Bounding intervals: Finding the nearest perfect square using k² < N < (k + 1)².",
    imgGeometricCaption: "Geometric concept: A perfect square forms a complete grid where area equals side length squared.",
    imgSquaresCaption: "The 10 perfect squares from 1 to 100: Visual square tile progressions.",
    imgPythagoreanCaption: "Practical application: Pythagorean triples of perfect squares (3² + 4² = 5²) in construction and surveying."
  },
  fr: {
    copy: "Copier",
    copied: "Copié !",
    extendedTitle: "Liste Complète des Carrés Parfaits de 1 à 1000",
    extendedLead: "Entre 1 et 1000 inclus, il existe exactement 31 carrés parfaits car 31² = 961 et 32² = 1024.",
    codeTitle: "Comment Vérifier un Carré Parfait en Code et sur Tableur",
    codeLead: "Vérifiez automatiquement vos nombres avec Excel, Google Sheets, Python et JavaScript :",
    excelTitle: "1. Microsoft Excel & Google Sheets",
    pythonTitle: "2. Python (Racine Carrée Entière)",
    jsTitle: "3. JavaScript",
    intlTitle: "Normes Mathématiques Internationales : France, Allemagne, États-Unis, Royaume-Uni",
    targetNumber: "Nombre Cible (N)",
    squareRoot: "Racine Carrée (√N)",
    lowerBound: "Carré Inférieur (k²)",
    upperBound: "Carré Supérieur ((k+1)²)",
    nearestSquare: "Carré le Plus Proche",
    distance: "Écart",
    imgIntervalCaption: "Intervalles d'encadrement : Trouver le carré parfait le plus proche avec k² < N < (k + 1)².",
    imgGeometricCaption: "Concept géométrique : Un carré parfait forme une grille complète dont l'aire vaut le côté au carré.",
    imgSquaresCaption: "Les 10 carrés parfaits de 1 à 100 : Progression visuelle des aires carrées.",
    imgPythagoreanCaption: "Application pratique : Triplets pythagoriciens de carrés parfaits (3² + 4² = 5²) dans le bâtiment."
  }
};

const currentUi = uiDict[lang] || uiDict['en'];
---

<article class="seo-article" id="perfect-square-guide">
  <!-- Table of Contents -->
  <div class="article-container" style="padding-top: 0; padding-bottom: 0;">
    <TableOfContents items={perfectToc} title={content.tocTitle} isOpen={false} lang={lang} />
  </div>

  <!-- Section 1: How to Use the Calculator -->
  <section class="article-section article-section--alt" id="section-how-to-use">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </span>
        {content.s1.eyebrow}
      </div>
      <h2 class="article-h2">{content.s1.title}</h2>
      <p>{content.s1.intro}</p>

      <div class="steps-visual" style="margin-top: 24px;">
        {content.s1.steps.map((step, idx) => (
          <div class="step-card" id={`step-${idx + 1}`}>
            <div class="step-number">{idx + 1}</div>
            <div class="step-content">
              <h4>{step.title}</h4>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: What Is a Perfect Square? -->
  <section class="article-section" id="section-what-is-perfect-square">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M9 12l2 2 4-4"/></svg>
        </span>
        {content.s2.eyebrow}
      </div>
      <h2 class="article-h2">{content.s2.title}</h2>
      <p class="article-lead">{content.s2.lead}</p>
      <p>{content.s2.p1}</p>
      <p>{content.s2.p2}</p>

      <div class="examples-grid" style="margin: 20px 0 28px 0;">
        <div class="example-card">
          <span class="example-expr">5² = 25</span>
          <span class="example-reason">√25 = 5 (Integer Root)</span>
        </div>
        <div class="example-card">
          <span class="example-expr">8² = 64</span>
          <span class="example-reason">√64 = 8 (Integer Root)</span>
        </div>
        <div class="example-card">
          <span class="example-expr">12² = 144</span>
          <span class="example-reason">√144 = 12 (Integer Root)</span>
        </div>
      </div>

      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s2.cards.map((card) => (
          <div class="law-card">
            <div class="law-number">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3 class="law-title">{card.title}</h3>
            <p class="law-text">{card.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Section Image 1: Geometric Concept -->
    <figure class="section-image">
      <img src="/images/sqrt-geometric-concept.svg" alt={currentUi.imgGeometricCaption} loading="lazy" decoding="async" width="800" height="450" />
      <figcaption>{currentUi.imgGeometricCaption}</figcaption>
    </figure>
  </section>

  <!-- Section 3: How to Check if a Number Is a Square: Four Methods -->
  <section class="article-section article-section--alt" id="section-how-it-works">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </span>
        {content.s3.eyebrow}
      </div>
      <h2 class="article-h2">{content.s3.title}</h2>
      <p>{content.s3.intro}</p>

      <div class="math-block" style="margin: 20px 0;">
        <span class="math-formula">If &radic;N = k &isin; &Zopf;, then N is a Perfect Square (k &times; k = N)</span>
      </div>

      <div class="law-cards-grid" style="margin-top: 24px;">
        {content.s3.tests.map((test, idx) => (
          <div class="law-card">
            <div class="law-number">
              <span style="font-weight: 800; font-size: 0.9rem;">{idx + 1}</span>
            </div>
            <h3 class="law-title">{test.title}</h3>
            <p class="law-text">{test.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Worked Verification Examples -->
  <section class="article-section" id="section-worked-examples">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </span>
        {content.s4.eyebrow}
      </div>
      <h2 class="article-h2">{content.s4.title}</h2>

      {content.s4.examples.map((ex, idx) => (
        <div class="tip-card" style="margin: 20px 0;">
          <div class="tip-card-header">
            <span class="tip-badge" style={idx === 0 ? "background: linear-gradient(135deg, #10b981, #059669);" : "background: linear-gradient(135deg, #ef4444, #dc2626);"}>
              {ex.verdict}
            </span>
            <h3 class="tip-card-title">{ex.title}</h3>
          </div>
          <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
            <code>{ex.expr}</code> : {ex.reason}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 5: Mental Math Shortcuts Without a Calculator -->
  <section class="article-section article-section--alt" id="section-shortcuts">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </span>
        {content.s5.eyebrow}
      </div>
      <h2 class="article-h2">{content.s5.title}</h2>
      <p>{content.s5.intro}</p>

      <div class="tip-card" id="shortcut-last-digit" style="margin: 24px 0;">
        <div class="tip-card-header">
          <span class="tip-badge">#1</span>
          <h3 class="tip-card-title">{content.s5.r1Title}</h3>
        </div>
        <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
          {content.s5.r1Text}
        </p>
      </div>

      <div class="tip-card" id="shortcut-digital-root" style="margin: 24px 0;">
        <div class="tip-card-header">
          <span class="tip-badge">#2</span>
          <h3 class="tip-card-title">{content.s5.r2Title}</h3>
        </div>
        <p style="margin-top: 10px; color: var(--text-secondary); line-height: 1.7;">
          {content.s5.r2Text}
        </p>
      </div>
    </div>
  </section>

  <!-- Section 6: Edge Cases: Zero, Negatives, Fractions, and Decimals -->
  <section class="article-section" id="section-edge-cases">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        {content.s6.eyebrow}
      </div>
      <h2 class="article-h2">{content.s6.title}</h2>
      <p class="article-lead">{content.s6.lead}</p>
      <p>{content.s6.p1}</p>
    </div>
  </section>

  <!-- Section 7: Finding the Nearest Perfect Square -->
  <section class="article-section article-section--alt" id="section-nearest-square">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg>
        </span>
        {content.s7.eyebrow}
      </div>
      <h2 class="article-h2">{content.s7.title}</h2>
      <p class="article-lead">{content.s7.lead}</p>
      <p>{content.s7.p1}</p>

      <div class="table-scroll-wrapper" style="margin-top: 20px;">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">{currentUi.targetNumber}</th>
              <th scope="col">{currentUi.squareRoot}</th>
              <th scope="col">{currentUi.lowerBound}</th>
              <th scope="col">{currentUi.upperBound}</th>
              <th scope="col">{currentUi.nearestSquare}</th>
              <th scope="col">{currentUi.distance}</th>
            </tr>
          </thead>
          <tbody>
            {nearestExamples.map((item) => (
              <tr>
                <td><strong>{item.target}</strong></td>
                <td style="font-family: var(--font-mono);">{item.root}</td>
                <td>{item.lowerSq} ({item.lowerK}²)</td>
                <td>{item.upperSq} ({item.upperK}²)</td>
                <td style="font-family: var(--font-mono); font-weight: 700; color: var(--emerald-600, #059669);">{item.nearest}</td>
                <td style="font-size: 0.86rem; color: var(--text-secondary);">{item.diff}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 14px; font-weight: 500;">
        When your number is not a perfect square, its root is an irrational decimal. <a href={localizedUrl('/')} style="color: var(--primary-600); font-weight: 700; text-decoration: underline;">
          Calculate simplified radicals and decimal square roots &rarr;
        </a>
      </p>
    </div>

    <!-- Section Image 2: Bounding Intervals Diagram -->
    <figure class="section-image">
      <img src="/images/perfect-square-bounding-intervals.svg" alt={currentUi.imgIntervalCaption} loading="lazy" decoding="async" width="800" height="440" />
      <figcaption>{currentUi.imgIntervalCaption}</figcaption>
    </figure>
  </section>

  <!-- Section 8: The 10 Perfect Squares from 1 to 100 -->
  <section class="article-section" id="section-first-20-squares">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </span>
        {content.s8.eyebrow}
      </div>
      <h2 class="article-h2">{content.s8.title}</h2>
      <p>{content.s8.lead}</p>

      <div class="table-scroll-wrapper" style="margin-top: 20px;">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">{content.s8.colN}</th>
              <th scope="col">{content.s8.colFormula}</th>
              <th scope="col">{content.s8.colSquare}</th>
              <th scope="col">√n²</th>
            </tr>
          </thead>
          <tbody>
            {first10Squares.map((item) => (
              <tr>
                <td style="font-weight:700; color:var(--text-primary);">{item.n}</td>
                <td>{item.n} × {item.n}</td>
                <td style="font-family:var(--font-mono); color:var(--primary-600); font-weight:700;">{item.square}</td>
                <td style="font-family:var(--font-mono); color:var(--emerald-600, #059669);">{item.root}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Section Image 3: Perfect Squares Grid -->
    <figure class="section-image">
      <img src="/images/sqrt-perfect-squares-grid.svg" alt={currentUi.imgSquaresCaption} loading="lazy" decoding="async" width="800" height="420" />
      <figcaption>{currentUi.imgSquaresCaption}</figcaption>
    </figure>
  </section>

  <!-- Section 9: Extended List from 1 to 1000 -->
  <section class="article-section article-section--alt" id="section-extended-1000">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </span>
        1 - 1000
      </div>
      <h2 class="article-h2">{currentUi.extendedTitle}</h2>
      <p class="article-lead">{currentUi.extendedLead}</p>

      <div class="table-scroll-wrapper" style="max-height: 380px; margin-top: 20px;">
        <table class="data-table data-table--compact">
          <thead>
            <tr>
              <th scope="col">n</th>
              <th scope="col">n²</th>
              <th scope="col">n</th>
              <th scope="col">n²</th>
              <th scope="col">n</th>
              <th scope="col">n²</th>
            </tr>
          </thead>
          <tbody>
            {Array.from({ length: 11 }, (_, rowIdx) => {
              const c1 = rowIdx + 1;
              const c2 = rowIdx + 12;
              const c3 = rowIdx + 23;
              return (
                <tr>
                  <td><strong>{c1}</strong></td><td>{c1 * c1}</td>
                  {c2 <= 31 ? (
                    <><td><strong>{c2}</strong></td><td>{c2 * c2}</td></>
                  ) : (<td>-</td><td>-</td>)}
                  {c3 <= 31 ? (
                    <><td><strong>{c3}</strong></td><td><strong>{c3 * c3}</strong></td></>
                  ) : (<td>-</td><td>-</td>)}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p style="margin-top: 14px; font-weight: 500;">
        Need an expanded lookup list with decimal square roots for all integers up to 1000? <a href={localizedUrl('/square-root-chart/')} style="color: var(--primary-600); font-weight: 700; text-decoration: underline;">
          Browse the complete square root chart from 1 to 1000 &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Section 10: Checking in Code & Spreadsheets -->
  <section class="article-section" id="section-code-spreadsheets">
    <div class="article-container">
      <div class="section-eyebrow">
        <span class="eyebrow-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </span>
        Code &amp; Spreadsheets
      </div>
      <h2 class="article-h2">{currentUi.codeTitle}</h2>
      <p class="article-lead">{currentUi.codeLead}</p>

      <div class="steps-flow" style="margin-top: 24px;">
        <!-- Excel -->
        <div class="step-card">
          <h3 class="step-title">{currentUi.excelTitle}</h3>
          <div class="copy-box" style="margin-top: 8px; display: flex; align-items: center; justify-content: space-between; background: var(--bg-surface-elevated); padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
            <code id="psFormulaExcel" style="font-size: 0.82rem;">{lang === 'fr' ? '=SI(RACINE(A2)=ENT(RACINE(A2)); "Carré Parfait"; "Non")' : '=IF(SQRT(A2)=INT(SQRT(A2)), "Perfect Square", "Not a Square")'}</code>
