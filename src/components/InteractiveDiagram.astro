---
import { useTranslations } from '../../theme/i18n/translations';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = await useTranslations(lang);
---

<div class="interactive-diagram-container" id="geomDiagramContainer">
  <div class="diagram-header">
    <h3 class="diagram-title">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="title-icon"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      {t('diagram.title', 'Interactive Geometry: Area vs Volume')}
    </h3>
    <div class="diagram-controls" role="group" aria-label="Toggle diagram mode">
      <button class="diagram-toggle active" data-mode="square" type="button">
        Square (x²)
      </button>
      <button class="diagram-toggle" data-mode="cube" type="button">
        Cube (x³)
      </button>
    </div>
  </div>

  <div class="diagram-stage">
    <!-- SVG Canvas -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="-100 -100 200 200" class="geom-svg">
      
      <!-- Square Group (2D) -->
      <g id="squareGroup" class="geom-group active">
        <!-- Base Square -->
        <rect x="-50" y="-50" width="100" height="100" class="svg-shape primary-stroke" fill="var(--primary-500)" fill-opacity="0.1" stroke-width="2" stroke-linejoin="round" />
        
        <!-- Dimension Lines -->
        <g class="svg-dash primary-stroke" stroke-dasharray="4,4" stroke-width="1.5">
          <line x1="-50" y1="60" x2="50" y2="60" />
          <line x1="-60" y1="-50" x2="-60" y2="50" />
        </g>
        
        <!-- Labels -->
        <text x="0" y="75" class="svg-text primary-fill">x (width)</text>
        <text x="-75" y="0" class="svg-text primary-fill" transform="rotate(-90 -75 0)">x (height)</text>
        <text x="0" y="5" class="svg-text-large primary-fill">x²</text>
      </g>

      <!-- Cube Group (3D Isometric) -->
      <g id="cubeGroup" class="geom-group hidden">
        <!-- Back Face -->
        <polygon points="-30,-70 50,-70 50,10 -30,10" class="svg-shape accent-stroke" fill="var(--accent-500)" fill-opacity="0.05" stroke-dasharray="3,3" stroke-width="1.5" />
        
        <!-- Connecting Edges -->
        <line x1="-50" y1="-50" x2="-30" y2="-70" class="accent-stroke" stroke-width="1.5" />
        <line x1="30" y1="-50" x2="50" y2="-70" class="accent-stroke" stroke-width="1.5" />
        <line x1="-50" y1="30" x2="-30" y2="10" class="accent-stroke" stroke-width="1.5" />
        <line x1="30" y1="30" x2="50" y2="10" class="accent-stroke" stroke-width="1.5" />
        
        <!-- Front Face -->
        <rect x="-50" y="-50" width="80" height="80" class="svg-shape accent-stroke" fill="var(--accent-500)" fill-opacity="0.15" stroke-width="2" stroke-linejoin="round" />
        
        <!-- Dimension Labels -->
        <text x="-10" y="50" class="svg-text accent-fill">x (width)</text>
        <text x="-70" y="-10" class="svg-text accent-fill" transform="rotate(-90 -70 -10)">x (height)</text>
        <text x="-40" y="-60" class="svg-text accent-fill" transform="rotate(-45 -40 -60) translate(0, -10)">x (depth)</text>
        <text x="-10" y="-5" class="svg-text-large accent-fill">x³</text>
      </g>
    </svg>
  </div>

  <div class="diagram-info">
    <div id="infoSquare" class="info-card active">
      <div class="info-formula primary-text">Area = x²</div>
      <p class="info-desc">
        A square is a 2-dimensional shape. Its area is calculated by multiplying its width by its height. The square root (√) is the reverse operation: finding the side length (x) from the area.
      </p>
    </div>
    <div id="infoCube" class="info-card hidden">
      <div class="info-formula accent-text">Volume = x³</div>
      <p class="info-desc">
        A cube is a 3-dimensional object. Its volume is calculated by multiplying width × height × depth. The cube root (∛) is the reverse operation: finding the edge length (x) from the volume.
      </p>
    </div>
  </div>
</div>

<style>
  .interactive-diagram-container {
    background: var(--bg-card);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-default);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    margin: var(--space-xl) 0;
    font-family: var(--font-sans);
    transition: box-shadow var(--duration-normal) var(--ease-out);
  }
  
  .interactive-diagram-container:hover {
    box-shadow: var(--shadow-md);
  }

  .diagram-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-glass-strong);
  }

  .diagram-title {
    color: var(--text-main);
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .title-icon {
    color: var(--primary-500);
  }

  .diagram-controls {
    display: flex;
    gap: 4px;
    background: var(--bg-subtle);
    padding: 4px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .diagram-toggle {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 6px 14px;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .diagram-toggle.active {
    background: var(--bg-card);
    color: var(--primary-500);
    box-shadow: var(--shadow-sm);
  }
  
  [data-mode="cube"].active {
    color: var(--accent-500);
  }

  .diagram-stage {
    width: 100%;
    height: 350px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--bg-body);
    background-image: radial-gradient(var(--border-subtle) 1px, transparent 1px);
    background-size: 20px 20px;
    position: relative;
  }

  .geom-svg {
    width: 100%;
    height: 100%;
    max-width: 320px;
  }

  /* Dynamic Theme Colors for SVGs */
  .primary-stroke { stroke: var(--primary-500); }
  .primary-fill { fill: var(--primary-500); }
  .accent-stroke { stroke: var(--accent-500); }
  .accent-fill { fill: var(--accent-500); }
  
  .primary-text { color: var(--primary-500); }
  .accent-text { color: var(--accent-500); }

  .svg-text {
    font-size: 13px;
    font-weight: 600;
    text-anchor: middle;
    font-family: var(--font-mono);
  }
  
  .svg-text-large {
    font-size: 24px;
    font-weight: 800;
    text-anchor: middle;
    font-family: var(--font-mono);
  }

  .geom-group {
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  .geom-group.hidden {
    opacity: 0;
    transform: scale(0.9) translateY(10px);
    pointer-events: none;
  }

  .geom-group.active {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .diagram-info {
    padding: var(--space-lg);
    background: var(--bg-card);
    border-top: 1px solid var(--border-subtle);
    min-height: 150px;
  }

  .info-card {
    display: none;
    text-align: center;
  }

  .info-card.active {
    display: block;
    animation: fadeIn 0.4s ease;
  }

  .info-formula {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    margin-bottom: var(--space-sm);
  }

  .info-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 650px;
    margin: 0 auto;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .diagram-header {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
    .diagram-stage {
      height: 280px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('geomDiagramContainer');
    if (!container) return;

    const toggles = container.querySelectorAll('.diagram-toggle');
    const squareGroup = document.getElementById('squareGroup');
    const cubeGroup = document.getElementById('cubeGroup');
    const infoSquare = document.getElementById('infoSquare');
    const infoCube = document.getElementById('infoCube');

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        // Reset active states
        toggles.forEach(t => t.classList.remove('active'));
        toggle.classList.add('active');

        const mode = toggle.getAttribute('data-mode');
        
        if (mode === 'square') {
          squareGroup.classList.replace('hidden', 'active');
          cubeGroup.classList.replace('active', 'hidden');
          infoSquare.classList.replace('hidden', 'active');
          infoCube.classList.replace('active', 'hidden');
        } else {
          cubeGroup.classList.replace('hidden', 'active');
          squareGroup.classList.replace('active', 'hidden');
          infoCube.classList.replace('hidden', 'active');
          infoSquare.classList.replace('active', 'hidden');
        }
      });
    });
  });
</script>
