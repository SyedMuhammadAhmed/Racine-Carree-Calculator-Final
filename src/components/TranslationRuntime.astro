---
import { DEFAULT_LOCALE, LOCALES } from '../../theme/i18n/utils';

interface Props {
  pageLocale?: string;
}

const { pageLocale = DEFAULT_LOCALE } = Astro.props;
const includedLanguages = LOCALES.join(',');
---

<div id="google_translate_element" aria-hidden="true"></div>

<style is:global>
  #google_translate_element {
    position: absolute;
    inset-inline-start: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .goog-te-banner-frame,
  iframe.goog-te-banner-frame,
  .goog-te-balloon-frame,
  #goog-gt-tt,
  .skiptranslate > iframe {
    display: none !important;
  }

  body {
    top: 0 !important;
  }
</style>

<script is:inline define:vars={{ pageLocale, includedLanguages, defaultLocale: DEFAULT_LOCALE }}>
  (function () {
    var supported = includedLanguages.split(',');
    var rtlLocales = ['ar'];
    var localePrefixPattern = new RegExp('^/(' + supported.join('|') + ')(?=/|$)');

    function normalizeLocale(locale) {
      return supported.indexOf(locale) !== -1 ? locale : defaultLocale;
    }

    function getPathLocale() {
      var match = window.location.pathname.match(localePrefixPattern);
      return match ? match[1] : '';
    }

    function getInitialLocale() {
      var params = new URLSearchParams(window.location.search);
      return normalizeLocale(
        params.get('lang') ||
        getPathLocale() ||
        localStorage.getItem('preferredLocale') ||
        pageLocale ||
        defaultLocale
      );
    }

    function setCookie(name, value, days) {
      var expires = '';
      if (days) {
        var date = new Date();
        date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
        expires = '; expires=' + date.toUTCString();
      }

      document.cookie = name + '=' + value + expires + '; path=/; SameSite=Lax';

      if (window.location.hostname.indexOf('.') !== -1) {
        document.cookie = name + '=' + value + expires + '; path=/; domain=.' + window.location.hostname + '; SameSite=Lax';
      }
    }

    function clearTranslateCookie() {
      setCookie('googtrans', '', -1);
      document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';

      if (window.location.hostname.indexOf('.') !== -1) {
        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=.' + window.location.hostname;
      }
    }

    function syncLanguageSelects(locale) {
      document.querySelectorAll('[data-language-select]').forEach(function (select) {
        var option = select.querySelector('option[data-locale="' + locale + '"]');
        if (option) {
          select.value = option.value;
        }
      });
    }

    function updateDocumentState(locale) {
      window.__ACTIVE_TRANSLATION_LOCALE__ = locale;
      document.documentElement.setAttribute('data-active-locale', locale);
      document.documentElement.setAttribute('lang', locale);
      document.documentElement.setAttribute('dir', rtlLocales.indexOf(locale) !== -1 ? 'rtl' : 'ltr');
      syncLanguageSelects(locale);
    }

    function triggerGoogleCombo(locale) {
      var combo = document.querySelector('.goog-te-combo');
      if (!combo || locale === defaultLocale) return false;

      combo.value = locale;
      combo.dispatchEvent(new Event('change', { bubbles: true }));
      return true;
    }

    function loadGoogleTranslate(locale) {
      window.googleTranslateElementInit = function () {
        new window.google.translate.TranslateElement({
          pageLanguage: defaultLocale,
          includedLanguages: includedLanguages,
          autoDisplay: false
        }, 'google_translate_element');

        [200, 700, 1400].forEach(function (delay) {
          window.setTimeout(function () {
            triggerGoogleCombo(locale);
          }, delay);
        });
      };

      if (window.google && window.google.translate && window.google.translate.TranslateElement) {
        window.googleTranslateElementInit();
        return;
      }

      if (!document.querySelector('script[data-google-translate]')) {
        var script = document.createElement('script');
        script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
        script.async = true;
        script.setAttribute('data-google-translate', 'true');
        document.head.appendChild(script);
      }
    }

    function applyLocale(locale) {
      locale = normalizeLocale(locale);
      updateDocumentState(locale);

      if (locale === defaultLocale) {
        localStorage.removeItem('preferredLocale');
        clearTranslateCookie();
        return;
      }

      localStorage.setItem('preferredLocale', locale);
      setCookie('googtrans', '/' + defaultLocale + '/' + locale, 30);
      loadGoogleTranslate(locale);
    }

    document.addEventListener('change', function (event) {
      var select = event.target.closest ? event.target.closest('[data-language-select]') : null;
      if (!select) return;

      var option = select.options[select.selectedIndex];
      var locale = normalizeLocale(option ? option.dataset.locale : defaultLocale);
      applyLocale(locale);

      if (select.value && window.location.href !== select.value) {
        window.location.href = select.value;
      }
    });

    window.__applySiteTranslation = applyLocale;
    applyLocale(getInitialLocale());
  })();
</script>
