---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import TranslationRuntime from '../components/TranslationRuntime.astro';
import site from '../config/site.json';
import {
  absoluteUrl,
  getOpenGraphAlternateLocales,
  getOpenGraphLocale,
  type AlternateLink,
} from '../utils/seo';

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
	title: string;
	description: string;
	lang?: string;
	dir?: "ltr" | "rtl";
	canonicalUrl?: string;
	faqItems?: FAQItem[];
	robots?: string;
	alternateLinks?: AlternateLink[];
	ogImage?: string;
	mathSolverType?: string;
}

const {
  title,
  description,
  lang = "en",
  dir = "ltr",
  canonicalUrl,
  faqItems,
  robots = "index, follow",
  alternateLinks = [],
  ogImage = site.ogImage,
  mathSolverType = "SquareRootSolver",
} = Astro.props;

const pageUrl = canonicalUrl || absoluteUrl('/');
const absoluteOgImage = absoluteUrl(ogImage);
const openGraphLocale = getOpenGraphLocale(lang);
const openGraphAlternateLocales = getOpenGraphAlternateLocales(alternateLinks, lang);

// JSON-LD WebApplication / SoftwareApplication Schema
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": title,
  "url": pageUrl,
  "description": description,
  "inLanguage": lang,
  "applicationCategory": "EducationalApplication",
  "applicationSubCategory": "Math Calculator",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5 web browser.",
  "softwareVersion": "2.0.0",
  "featureList": [
    "Square root calculator with step-by-step breakdown",
    "Cube root (racine cubique) solver for positive and negative numbers",
    "Nth root calculator for any root degree index",
    "Simplified radical expression converter",
    "Interactive reference table 1 to 100"
  ],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
};

// JSON-LD MathSolver Schema for Google Rich Results
const mathSolverSchema = {
  "@context": "https://schema.org",
  "@type": "MathSolver",
  "name": `${title} — Step-by-Step Math Solver`,
  "url": pageUrl,
  "description": description,
  "inLanguage": lang,
  "mathSolverType": mathSolverType,
  "educationalLevel": ["ElementarySchool", "MiddleSchool", "HighSchool", "College"]
};

// JSON-LD WebSite Schema
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.siteName,
  "url": absoluteUrl('/'),
  "description": site.siteDescription
};

// JSON-LD HowTo Schema for Calculator Usage
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to Calculate Roots with ${site.siteName}`,
  "description": "Step-by-step guide to calculating square, cube, and nth roots instantly online.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Enter Your Number",
      "text": "Type your number (radicand) into the calculator input box."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Click Calculate",
      "text": "Press the Calculate button to process your mathematical expression."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "View Detailed Results",
      "text": "Get the exact decimal result, simplified radical form, and step-by-step solution."
    }
  ]
};

// JSON-LD FAQPage Schema (if FAQ items exist)
const faqPageSchema = faqItems && faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": lang,
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

const schemas = [webAppSchema, mathSolverSchema, webSiteSchema, howToSchema, faqPageSchema].filter(Boolean);
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="theme-color" content="#7c3aed">
    <meta name="robots" content={robots}>
    <meta name="googlebot" content={robots}>
    
    <!-- Open Graph & Twitter -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content={site.siteName}>
    <meta property="og:locale" content={openGraphLocale}>
    {openGraphAlternateLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:image" content={absoluteOgImage}>
    <meta property="og:image:width" content={site.ogImageWidth.toString()}>
    <meta property="og:image:height" content={site.ogImageHeight.toString()}>
    <meta property="og:image:alt" content={site.ogImageAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={absoluteOgImage}>
    <meta name="twitter:image:alt" content={site.ogImageAlt}>
    
    <link rel="canonical" href={pageUrl}>
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{title}</title>

    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    {site.bingVerification && <meta name="msvalidate.01" content={site.bingVerification} />}
    {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}
    
    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    <script is:inline>
        (function () {
            var t = localStorage.getItem('theme');
            var d = t || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', d);
        })();
    </script>
</head>
<body>
    <a href="#main-content" class="skip-to-content">Skip to main content</a>
    <div class="bg-orbs" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="orb orb-4"></div>
        <div class="orb orb-5"></div>
    </div>
    <slot />
    <TranslationRuntime pageLocale={lang} />
    <button id="backToTop" class="back-to-top" aria-label="Back to top" title="Back to top" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <script src="/app.js" defer is:inline></script>
</body>
</html>
