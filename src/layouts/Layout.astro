    "Интерактивна справочна таблица от 1 до 100"
  ]
};

// JSON-LD WebApplication / SoftwareApplication Schema
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": title,
  "url": pageUrl,
  "description": description,
  "inLanguage": lang,
  "applicationCategory": "EducationalApplication",
  "applicationSubCategory": "Math Calculator",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5 web browser.",
  "softwareVersion": "2.0.0",
  "publisher": {
    "@id": `${site.siteUrl}/#organization`
  },
  "featureList": SCHEMA_FEATURES[lang] || SCHEMA_FEATURES.en,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
};

// JSON-LD WebSite Schema
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.siteName,
  "url": absoluteUrl('/'),
  "description": site.siteDescription,
  "publisher": {
    "@id": `${site.siteUrl}/#organization`
  }
};

// JSON-LD FAQPage Schema (if FAQ items exist)
const faqPageSchema = faqItems && faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": lang,
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

const schemas = [orgSchema, webAppSchema, webSiteSchema, faqPageSchema].filter(Boolean);
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', stored || preferred);
        } catch (e) {}
      })();
    </script>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#7c3aed">
    <meta name="robots" content={robots}>
    <meta name="googlebot" content={robots}>
    
    <!-- Open Graph & Twitter -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={pageUrl}>
    <meta property="og:site_name" content={site.siteName}>
    <meta property="og:locale" content={openGraphLocale}>
    {openGraphAlternateLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:image" content={absoluteOgImage}>
    <meta property="og:image:width" content={site.ogImageWidth.toString()}>
    <meta property="og:image:height" content={site.ogImageHeight.toString()}>
    <meta property="og:image:alt" content={site.ogImageAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={absoluteOgImage}>
    <meta name="twitter:image:alt" content={site.ogImageAlt}>
    
    <link rel="canonical" href={pageUrl}>
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{title}</title>

    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    {site.bingVerification && <meta name="msvalidate.01" content={site.bingVerification} />}
    {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}
    {site.trustpilotVerification && <meta name="trustpilot-one-time-domain-verification-id" content={site.trustpilotVerification} />}
    
    <!-- JSON-LD Schema (one script tag per schema for Google compliance) -->
    {schemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
</head>
<body>
    <a href="#main-content" class="skip-to-content">Skip to main content</a>
    <div class="bg-orbs" aria-hidden="true">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="orb orb-4"></div>
        <div class="orb orb-5"></div>
    </div>
    <slot />
    <button id="backToTop" class="back-to-top" aria-label="Back to top" title="Back to top" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <script src="/app.js" defer></script>
</body>
</html>
