---
import '../styles/global.css';
import TranslationRuntime from '../components/TranslationRuntime.astro';
import site from '../config/site.json';

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
	title: string;
	description: string;
	lang?: string;
	dir?: "ltr" | "rtl";
	canonicalUrl?: string;
	faqItems?: FAQItem[];
}

const { title, description, lang = "en", dir = "ltr", canonicalUrl, faqItems } = Astro.props;

// JSON-LD WebApplication / SoftwareApplication Schema
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": ["SoftwareApplication", "WebApplication"],
  "name": site.siteName,
  "url": canonicalUrl || site.siteUrl,
  "description": description,
  "applicationCategory": "EducationalApplication",
  "applicationSubCategory": "Math Calculator",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5 web browser.",
  "softwareVersion": "2.0.0",
  "featureList": [
    "Square root calculator with step-by-step breakdown",
    "Cube root (racine cubique) solver for positive and negative numbers",
    "Nth root calculator for any root degree index",
    "Simplified radical expression converter",
    "Interactive reference table 1 to 100"
  ],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
};

// JSON-LD MathSolver Schema for Google Rich Results
const mathSolverSchema = {
  "@context": "https://schema.org",
  "@type": "MathSolver",
  "name": `${title} — Step-by-Step Math Solver`,
  "url": canonicalUrl || site.siteUrl,
  "description": description,
  "mathSolverType": "SquareRootSolver",
  "educationalLevel": ["ElementarySchool", "MiddleSchool", "HighSchool", "College"]
};

// JSON-LD WebSite Schema
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.siteName,
  "url": site.siteUrl,
  "description": site.siteDescription
};

// JSON-LD HowTo Schema for Calculator Usage
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": `How to Calculate Roots with ${site.siteName}`,
  "description": "Step-by-step guide to calculating square, cube, and nth roots instantly online.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Enter Your Number",
      "text": "Type your number (radicand) into the calculator input box."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Click Calculate",
      "text": "Press the Calculate button to process your mathematical expression."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "View Detailed Results",
      "text": "Get the exact decimal result, simplified radical form, and step-by-step solution."
    }
  ]
};

// JSON-LD FAQPage Schema (if FAQ items exist)
const faqPageSchema = faqItems && faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

const schemas = [webAppSchema, mathSolverSchema, webSiteSchema, howToSchema, faqPageSchema].filter(Boolean);
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    
    <!-- Open Graph & Twitter -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl || site.siteUrl}>
    <meta property="og:image" content={`${site.siteUrl}${site.ogImage}`}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    
    {canonicalUrl && <link rel="canonical" href={canonicalUrl}>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{title}</title>
    
    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://translate.google.com">
    <link rel="preconnect" href="https://translate.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script is:inline>
        (function () {
            var t = localStorage.getItem('theme');
            var d = t || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', d);
        })();
    </script>
</head>
<body>
    <div class="bg-orbs">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="orb orb-4"></div>
        <div class="orb orb-5"></div>
    </div>
    <slot />
    <TranslationRuntime pageLocale={lang} />
    <button id="backToTop" class="back-to-top" aria-label="Back to top" title="Back to top">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <script src="/app.js" is:inline></script>
</body>
</html>
