---
import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import site from '../config/site.json';
import {
  absoluteUrl,
  getOpenGraphAlternateLocales,
  getOpenGraphLocale,
  type AlternateLink,
} from '../utils/seo';

import social from '../config/social.json';

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
	title: string;
	description: string;
	lang?: string;
	dir?: "ltr" | "rtl";
	canonicalUrl?: string;
	faqItems?: FAQItem[];
	robots?: string;
	alternateLinks?: AlternateLink[];
	ogImage?: string;
}

const {
  title,
  description,
  lang = "en",
  dir = "ltr",
  canonicalUrl,
  faqItems,
  robots = "index, follow",
  alternateLinks = [],
  ogImage = site.ogImage,
} = Astro.props;

const pageUrl = canonicalUrl || absoluteUrl('/');
const absoluteOgImage = absoluteUrl(ogImage);
const openGraphLocale = getOpenGraphLocale(lang);
const openGraphAlternateLocales = getOpenGraphAlternateLocales(alternateLinks, lang);

const socialLinks = Object.values(social).filter(Boolean);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site.siteUrl}/#organization`,
  name: site.siteName,
  url: absoluteUrl('/'),
  legalName: site.siteName,
  logo: {
    "@type": "ImageObject",
    url: absoluteUrl('/logo.png'),
    caption: site.siteName,
    width: 512,
    height: 512
  },
  image: absoluteUrl('/og-image.png'),
  description: site.siteDescription,
  founder: {
    "@type": "Person",
    name: "Syed Muhammad Ahmed",
    jobTitle: "Founder & Creator",
    url: absoluteUrl('/about-us/'),
    image: absoluteUrl('/images/syed-muhammad-ahmed-racine-carree-calculator.jpg'),
    sameAs: [
      "https://www.linkedin.com/company/144823222/",
      "https://www.behance.net/syedmuahmed17"
    ]
  },
  sameAs: socialLinks,
  contactPoint: {
    "@type": "ContactPoint",
    email: site.contactEmail,
    contactType: "customer support"
  }
};

const SCHEMA_FEATURES: Record<string, string[]> = {
